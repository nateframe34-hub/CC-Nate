{% comment %}
  Volume Discount Tiers — Custom Baseline NMN bundle selector
  Replaces Amose Bundles app with zero external dependencies.

  Requires: Shopify automatic discounts matching the tier pricing.
  - Buy 2: $10 off order
  - Buy 3: $30 off order
{% endcomment %}

{%- assign tier_1_qty = 1 -%}
{%- assign tier_1_label = 'Try it' -%}
{%- assign tier_1_supply = '60-Day Supply' -%}
{%- assign tier_1_price = 4999 -%}
{%- assign tier_1_compare = 6999 -%}
{%- assign tier_1_badge = '' -%}
{%- assign tier_1_save = '' -%}

{%- assign tier_2_qty = 2 -%}
{%- assign tier_2_label = 'Commit' -%}
{%- assign tier_2_supply = '120-Day Supply' -%}
{%- assign tier_2_price = 8999 -%}
{%- assign tier_2_compare = 13998 -%}
{%- assign tier_2_badge = 'Most Popular' -%}
{%- assign tier_2_save = 'Save $10' -%}

{%- assign tier_3_qty = 3 -%}
{%- assign tier_3_label = 'Transform' -%}
{%- assign tier_3_supply = '180-Day Supply' -%}
{%- assign tier_3_price = 11985 -%}
{%- assign tier_3_compare = 20997 -%}
{%- assign tier_3_badge = 'Best Value' -%}
{%- assign tier_3_save = 'Save $30' -%}

<style>
  .vdt {
    --vdt-accent: #7C5CBF;
    --vdt-accent-light: #F3EEFB;
    --vdt-accent-dark: #5A3D96;
    --vdt-border: #E2DDD7;
    --vdt-border-active: #7C5CBF;
    --vdt-bg: #FDFBF7;
    --vdt-bg-active: #F3EEFB;
    --vdt-text: #2C2C2C;
    --vdt-text-muted: #7A7A7A;
    --vdt-badge-bg: #7C5CBF;
    --vdt-badge-text: #FFFFFF;
    --vdt-save-bg: #E8F5E9;
    --vdt-save-text: #2E7D32;
    --vdt-compare: #999999;
    --vdt-radius: 10px;
    width: 100%;
    margin: 0.8rem 0 0.4rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .vdt__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--vdt-text);
    margin: 0 0 0.6rem;
    text-transform: uppercase;
  }

  .vdt__tiers {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vdt__tier {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 2px solid var(--vdt-border);
    border-radius: var(--vdt-radius);
    background: var(--vdt-bg);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .vdt__tier:hover {
    border-color: var(--vdt-accent);
  }

  .vdt__tier--active {
    border-color: var(--vdt-border-active);
    background: var(--vdt-bg-active);
    box-shadow: 0 0 0 1px var(--vdt-border-active);
  }

  /* Radio circle */
  .vdt__radio {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--vdt-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease;
  }

  .vdt__tier--active .vdt__radio {
    border-color: var(--vdt-accent);
  }

  .vdt__radio-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--vdt-accent);
    transform: scale(0);
    transition: transform 0.2s ease;
  }

  .vdt__tier--active .vdt__radio-dot {
    transform: scale(1);
  }

  /* Content area */
  .vdt__content {
    flex: 1;
    min-width: 0;
  }

  .vdt__top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .vdt__label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--vdt-text);
  }

  .vdt__badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--vdt-badge-text);
    background: var(--vdt-badge-bg);
    border-radius: 4px;
    line-height: 1.4;
  }

  .vdt__supply {
    font-size: 0.8rem;
    color: var(--vdt-text-muted);
    margin-top: 0.15rem;
  }

  /* Pricing area */
  .vdt__pricing {
    flex-shrink: 0;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }

  .vdt__price {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--vdt-text);
  }

  .vdt__compare {
    font-size: 0.8rem;
    color: var(--vdt-compare);
    text-decoration: line-through;
  }

  .vdt__save {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--vdt-save-text);
    background: var(--vdt-save-bg);
    border-radius: 3px;
    margin-top: 0.1rem;
  }

  /* Hidden native input for form submission */
  .vdt__quantity-input {
    display: none;
  }
</style>

<div class="vdt" id="VolumeDiscountTiers-{{ section.id }}">
  <p class="vdt__heading">Bundle & Save</p>
  <div class="vdt__tiers">

    {%- comment %} Tier 1 — Try it {% endcomment -%}
    <div class="vdt__tier vdt__tier--active" data-tier-qty="{{ tier_1_qty }}" role="button" tabindex="0" aria-label="{{ tier_1_label }} — {{ tier_1_qty }} bottle">
      <div class="vdt__radio"><div class="vdt__radio-dot"></div></div>
      <div class="vdt__content">
        <div class="vdt__top-row">
          <span class="vdt__label">{{ tier_1_label }}</span>
        </div>
        <div class="vdt__supply">{{ tier_1_supply }}</div>
      </div>
      <div class="vdt__pricing">
        <span class="vdt__price">{{ tier_1_price | money }}</span>
        <span class="vdt__compare">{{ tier_1_compare | money }}</span>
      </div>
    </div>

    {%- comment %} Tier 2 — Commit {% endcomment -%}
    <div class="vdt__tier" data-tier-qty="{{ tier_2_qty }}" role="button" tabindex="0" aria-label="{{ tier_2_label }} — {{ tier_2_qty }} bottles">
      <div class="vdt__radio"><div class="vdt__radio-dot"></div></div>
      <div class="vdt__content">
        <div class="vdt__top-row">
          <span class="vdt__label">{{ tier_2_label }}</span>
          {%- if tier_2_badge != blank -%}
            <span class="vdt__badge">{{ tier_2_badge }}</span>
          {%- endif -%}
        </div>
        <div class="vdt__supply">{{ tier_2_supply }}</div>
      </div>
      <div class="vdt__pricing">
        <span class="vdt__price">{{ tier_2_price | money }}</span>
        <span class="vdt__compare">{{ tier_2_compare | money }}</span>
        {%- if tier_2_save != blank -%}
          <span class="vdt__save">{{ tier_2_save }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- comment %} Tier 3 — Transform {% endcomment -%}
    <div class="vdt__tier" data-tier-qty="{{ tier_3_qty }}" role="button" tabindex="0" aria-label="{{ tier_3_label }} — {{ tier_3_qty }} bottles">
      <div class="vdt__radio"><div class="vdt__radio-dot"></div></div>
      <div class="vdt__content">
        <div class="vdt__top-row">
          <span class="vdt__label">{{ tier_3_label }}</span>
          {%- if tier_3_badge != blank -%}
            <span class="vdt__badge">{{ tier_3_badge }}</span>
          {%- endif -%}
        </div>
        <div class="vdt__supply">{{ tier_3_supply }}</div>
      </div>
      <div class="vdt__pricing">
        <span class="vdt__price">{{ tier_3_price | money }}</span>
        <span class="vdt__compare">{{ tier_3_compare | money }}</span>
        {%- if tier_3_save != blank -%}
          <span class="vdt__save">{{ tier_3_save }}</span>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    const container = document.getElementById('VolumeDiscountTiers-{{ section.id }}');
    if (!container) return;

    const tiers = container.querySelectorAll('.vdt__tier');
    const sectionId = '{{ section.id }}';

    // Find the quantity input in the product form
    function getQuantityInput() {
      return document.getElementById('Quantity-' + sectionId)
        || document.querySelector('[name="quantity"][form="product-form-' + sectionId + '"]')
        || document.querySelector('form[id="product-form-' + sectionId + '"] [name="quantity"]');
    }

    // If there's no visible quantity input, inject a hidden one into the product form
    function ensureQuantityInput() {
      var input = getQuantityInput();
      if (input) return input;

      var form = document.getElementById('product-form-' + sectionId);
      if (!form) return null;

      input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'quantity';
      input.value = '1';
      input.className = 'vdt__quantity-input';
      form.appendChild(input);
      return input;
    }

    function selectTier(selectedTier) {
      var qty = parseInt(selectedTier.getAttribute('data-tier-qty'), 10);

      // Update active states
      tiers.forEach(function(tier) {
        tier.classList.remove('vdt__tier--active');
      });
      selectedTier.classList.add('vdt__tier--active');

      // Update quantity input
      var input = ensureQuantityInput();
      if (input) {
        input.value = qty;
        // Dispatch change event for any listeners
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    // Bind click and keyboard events
    tiers.forEach(function(tier) {
      tier.addEventListener('click', function() {
        selectTier(tier);
      });
      tier.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectTier(tier);
        }
      });
    });

    // Initialize — tier 1 is active by default (qty = 1)
    selectTier(tiers[0]);
  })();
</script>
