<!-- Show More Toggle Script -->
<script>
  (function() {
    var toggleBtn = document.getElementById('blFaqToggle');
    var hiddenFaqs = document.getElementById('blFaqMore');
    if (!toggleBtn || !hiddenFaqs) return;

    toggleBtn.addEventListener('click', function() {
      var isExpanded = hiddenFaqs.classList.contains('bl-faq-visible');
      if (isExpanded) {
        hiddenFaqs.classList.remove('bl-faq-visible');
        toggleBtn.classList.remove('bl-expanded');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.innerHTML = 'Show More Questions <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
      } else {
        hiddenFaqs.classList.add('bl-faq-visible');
        toggleBtn.classList.add('bl-expanded');
        toggleBtn.setAttribute('aria-expanded', 'true');
        toggleBtn.innerHTML = 'Show Fewer Questions <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
      }
    });
  })();
</script>
