{%- comment -%}
  EVENROOM PDP — built for SA1 "The Fan Runner", HOT framing. 2026-09-26.

  Congruent with ads/batch-1 by design: the traffic arriving here has already
  tried a fan and has just been told why it didn't work. §3 repeats that exact
  sentence so the page continues the argument instead of restarting it.

  Custom Online Store 2.0 product section. Real Shopify product forms, so the
  Add to Cart buttons genuinely add to cart. All CSS scoped under #evr-pdp so
  it cannot collide with the theme.

  PRICING — CHANGED FROM THE TALLOW PATTERN, founder call 2026-09-26.
  Tallow hardcoded its displayed price in section settings. This does NOT.
  Every price on this page is derived from the SHOPIFY PRODUCT:
      single price    = product.price
      single compare  = product.compare_at_price
      2-pack compare  = product.price x 2
      2-pack price    = (product.price x 2) - bundle_discount_cents
  Change the price in Shopify and the whole page follows. Nothing to re-edit.

  ⚠️ THE 2-PACK NEEDS A MATCHING AUTOMATIC DISCOUNT IN SHOPIFY ADMIN.
  The selector adds quantity 2 of the same variant. Shopify will charge
  2 x product.price unless you create:
      Discounts → Automatic → Amount off order
      Minimum quantity of items: 2
      Value: the same amount as bundle_discount_cents below
  Verify the cart total matches the page before sending traffic.

  JS SAFETY — learned expensively on the tallow build.
  The selector script lives at the very END of this file, in its own IIFE with
  its own try/catch. It only writes to hidden inputs and toggles classes. It
  must never be merged into the theme's cart-drawer listeners: on tallow a bare
  IIFE above those listeners threw once and silently killed the cart drawer.
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign p1 = product.price -%}
{%- assign p1_cmp = product.compare_at_price -%}
{%- assign p2_cmp = p1 | times: 2 -%}
{%- assign p2 = p2_cmp | minus: section.settings.bundle_discount_cents -%}
{%- assign p2_each = p2 | divided_by: 2 -%}

<section id="evr-pdp" data-section-id="{{ section.id }}">

{%- comment -%}
  FONTS. The CSS below names Archivo / Inter / JetBrains Mono. Nothing in a
  Shopify theme loads those by default, so without this block the page falls
  back to Helvetica and loses the type identity. Kept inside the section on
  purpose — this file stays self-contained, no snippet, no theme.liquid edit.
  Turn off if the theme already serves these, or if you would rather add the
  link to theme.liquid <head> yourself (marginally faster).
{%- endcomment -%}
{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
#evr-pdp{
  --bg:#FAF7F2; --ink:#1C1A17; --accent:#B4553A; --accent-ink:#FFF7F3;
  --cool:#5B7185; --line:#E6DFD6; --muted:#6E655C;
  --hdr:'Archivo','Helvetica Neue',Arial,sans-serif;
  --body:'Inter','Helvetica Neue',Arial,sans-serif;
  --mono:'JetBrains Mono','Roboto Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  background:var(--bg); color:var(--ink); font-family:var(--body);
  font-size:17px; line-height:1.6; -webkit-font-smoothing:antialiased;
}
#evr-pdp *,#evr-pdp *::before,#evr-pdp *::after{box-sizing:border-box}
#evr-pdp .wrap{max-width:1180px;margin:0 auto;padding:0 20px}
#evr-pdp .narrow{max-width:720px;margin:0 auto}
#evr-pdp h1,#evr-pdp h2,#evr-pdp h3{font-family:var(--hdr);font-weight:700;line-height:1.12;letter-spacing:-.02em;margin:0 0 .5em}
#evr-pdp h1{font-size:clamp(30px,5vw,46px)}
#evr-pdp h2{font-size:clamp(26px,4vw,38px)}
#evr-pdp h3{font-size:clamp(19px,2.4vw,23px)}
#evr-pdp p{margin:0 0 1em;max-width:62ch}
#evr-pdp .deg{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:600}
#evr-pdp .sec{padding:64px 0}
#evr-pdp .band{background:var(--accent);color:var(--accent-ink);padding:72px 0}
#evr-pdp .band h2,#evr-pdp .band h3{color:var(--accent-ink)}
#evr-pdp .band .deg{color:var(--accent-ink)}
#evr-pdp .eyebrow{font-family:var(--hdr);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 14px;font-weight:700}
#evr-pdp .band .eyebrow{color:rgba(255,247,243,.75)}

/* announcement */
#evr-pdp .announce{background:var(--ink);color:var(--bg);font-size:13px;letter-spacing:.04em;text-align:center;padding:10px 16px}
#evr-pdp .announce span{margin:0 10px;white-space:nowrap}

/* hero */
#evr-pdp .hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:44px 0 64px;align-items:start}
#evr-pdp .gal-main{width:100%;aspect-ratio:1/1;object-fit:cover;background:#fff;border:1px solid var(--line)}
#evr-pdp .evr-car{position:relative}
#evr-pdp .evr-car-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:none;border:1px solid var(--line);background:#fff}
#evr-pdp .evr-car-track::-webkit-scrollbar{display:none}
#evr-pdp .evr-car-slide{flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1/1}
#evr-pdp .evr-car-slide img{width:100%;height:100%;object-fit:cover;display:block}
#evr-pdp .evr-car-btn{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.92);font-size:26px;line-height:1;color:var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0 0 3px}
#evr-pdp .evr-car-btn.prev{left:10px}#evr-pdp .evr-car-btn.next{right:10px}
#evr-pdp .evr-car-dots{position:absolute;left:0;right:0;bottom:12px;display:flex;justify-content:center;gap:7px;pointer-events:none}
#evr-pdp .evr-car-dots span{width:7px;height:7px;border-radius:50%;background:rgba(28,26,23,.22);transition:background .2s,transform .2s}
#evr-pdp .evr-car-dots span.on{background:var(--accent);transform:scale(1.25)}
@media(hover:none){#evr-pdp .evr-car-btn{display:none}}
#evr-pdp .gal-thumbs{display:flex;gap:8px;margin-top:8px;overflow-x:auto;scrollbar-width:none}
#evr-pdp .gal-thumbs::-webkit-scrollbar{display:none}
#evr-pdp .gal-thumbs img{flex:0 0 auto}
#evr-pdp .gal-thumbs img{width:72px;height:72px;object-fit:cover;border:1px solid var(--line);cursor:pointer;background:#fff}
#evr-pdp .gal-thumbs img.on{border-color:var(--accent);border-width:2px}
#evr-pdp .sub{font-size:19px;color:var(--muted);margin:-.2em 0 24px;max-width:36ch}
#evr-pdp .prices{display:flex;align-items:baseline;gap:12px;margin:0 0 4px}
#evr-pdp .p-now{font-family:var(--hdr);font-weight:700;font-size:32px}
#evr-pdp .p-was{color:var(--muted);text-decoration:line-through;font-size:19px}
#evr-pdp .p-note{font-size:14px;color:var(--muted);margin:0 0 28px}

/* steps */
#evr-pdp .step{border-top:1px solid var(--line);padding:22px 0}
#evr-pdp .step-h{display:flex;align-items:baseline;gap:10px;margin:0 0 4px}
#evr-pdp .step-n{font-family:var(--mono);font-size:12px;color:var(--accent);font-weight:700}
#evr-pdp .step-t{font-family:var(--hdr);font-weight:700;font-size:16px}
#evr-pdp .step-s{font-size:14px;color:var(--muted);margin:0 0 14px}
#evr-pdp .opts{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#evr-pdp .opt{background:#fff;border:1.5px solid var(--line);padding:14px;text-align:left;cursor:pointer;font-family:var(--body);font-size:15px;color:var(--ink);transition:border-color .12s,box-shadow .12s}
#evr-pdp .opt:hover{border-color:var(--muted)}
#evr-pdp .opt.on{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
#evr-pdp .opt .ot{font-family:var(--hdr);font-weight:700;display:block;margin-bottom:2px}
#evr-pdp .opt .os{font-size:13px;color:var(--muted);display:block}
#evr-pdp .opt .op{font-family:var(--hdr);font-weight:700;margin-top:6px;display:block}
#evr-pdp .opt .op s{color:var(--muted);font-weight:400;margin-right:6px}
#evr-pdp .opt[disabled]{opacity:.42;cursor:not-allowed}
#evr-pdp .tag{display:inline-block;background:var(--accent);color:var(--accent-ink);font-family:var(--hdr);font-size:10px;letter-spacing:.09em;text-transform:uppercase;padding:3px 7px;margin-top:8px;font-weight:700}

/* vent picker (dropdown) */
#evr-pdp .evr-pick-row{display:block;margin-top:10px}
#evr-pdp .evr-pick-l{display:block;font-family:var(--hdr);font-weight:700;font-size:13px;margin:0 0 6px}
#evr-pdp .evr-pick-wrap{position:relative}
#evr-pdp .evr-pick-wrap:after{content:"";position:absolute;right:18px;top:50%;width:9px;height:9px;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:translateY(-70%) rotate(45deg);pointer-events:none}
#evr-pdp .evr-pick{width:100%;appearance:none;-webkit-appearance:none;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:12px 44px 12px 14px;font-family:var(--body);font-size:16px;color:var(--ink);cursor:pointer}
#evr-pdp .evr-pick:focus{outline:2px solid var(--accent);outline-offset:1px}
#evr-pdp .evr-pick-s{font-size:13px;color:var(--muted);margin:10px 0 4px}

/* bundle — tallow layout */
#evr-pdp .evr-bundle{display:flex;flex-direction:column;gap:12px;margin:0 0 6px}
#evr-pdp .evr-tier{position:relative;display:block;width:100%;padding:15px 14px;border:1.5px solid var(--line);border-radius:12px;background:#fff;text-align:left;cursor:pointer;font:inherit;color:inherit;transition:border-color .15s,background .15s}
#evr-pdp .evr-tier:hover{border-color:var(--muted)}
#evr-pdp .evr-tier:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
#evr-pdp .evr-tier.on{border-color:var(--accent);border-width:2px;padding:14px 13px;background:#FBF1EC}
#evr-pdp .evr-tier-main{display:flex;align-items:center;gap:12px;width:100%}
#evr-pdp .evr-tier-picks{display:none;margin-top:4px;padding-left:32px;cursor:default}
#evr-pdp .evr-tier.on .evr-tier-picks{display:block}
#evr-pdp .evr-tier-radio{flex:0 0 auto;width:20px;height:20px;border-radius:50%;border:1.5px solid #c9c0b3;background:#fff;position:relative}
#evr-pdp .evr-tier.on .evr-tier-radio{border-color:var(--accent);border-width:2px}
#evr-pdp .evr-tier.on .evr-tier-radio:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--accent)}
#evr-pdp .evr-tier-body{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:2px}
#evr-pdp .evr-tier-name{font-family:var(--hdr);font-weight:700;font-size:15.5px;line-height:1.2}
#evr-pdp .evr-tier-sub{font-size:12.5px;color:var(--muted)}
#evr-pdp .evr-tier-prices{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;gap:1px}
#evr-pdp .evr-tier-now{font-family:var(--hdr);font-size:19px;font-weight:700;line-height:1.15}
#evr-pdp .evr-tier-was{font-size:12.5px;color:var(--muted);text-decoration:line-through}
#evr-pdp .evr-tier-each{font-size:11.5px;color:var(--muted)}
#evr-pdp .evr-tier-badge{position:absolute;top:-10px;right:12px;background:var(--accent);color:var(--accent-ink);font-family:var(--hdr);font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:3px 9px;border-radius:999px;white-space:nowrap}
@media(max-width:380px){#evr-pdp .evr-tier{padding:12px 11px}#evr-pdp .evr-tier-name{font-size:14.5px}#evr-pdp .evr-tier-now{font-size:17.5px}}

/* atc */
#evr-pdp .atc{width:100%;background:var(--accent);color:var(--accent-ink);border:0;font-family:var(--hdr);font-weight:700;font-size:17px;letter-spacing:.01em;padding:19px;cursor:pointer;margin-top:22px}
#evr-pdp .atc:hover{filter:brightness(1.07)}
#evr-pdp .atc[disabled]{background:var(--muted);cursor:not-allowed}
#evr-pdp .reassure{display:flex;gap:18px;flex-wrap:wrap;font-size:13.5px;color:var(--muted);margin-top:14px}
#evr-pdp .reassure b{color:var(--ink);font-weight:600}
#evr-pdp .evr-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0}
#evr-pdp .evr-trust-i{display:flex;align-items:center;gap:8px;font-size:12.5px;line-height:1.25;color:var(--muted)}
#evr-pdp .evr-trust-i b{color:var(--ink);font-weight:600}
#evr-pdp .evr-trust-ic{flex:0 0 auto;width:30px;height:30px;border-radius:50%;background:#FBF1EC;color:var(--accent);display:flex;align-items:center;justify-content:center}
#evr-pdp .evr-trust-ic svg{width:17px;height:17px}

/* hand test */
#evr-pdp .two{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:28px}
#evr-pdp .card{background:#fff;border:1px solid var(--line);padding:26px}
#evr-pdp .card.yes{border-left:4px solid var(--accent)}
#evr-pdp .card.no{border-left:4px solid var(--cool)}
#evr-pdp .card h3{margin-bottom:.35em}
#evr-pdp .card p{margin:0;font-size:15.5px}

/* outcome */
#evr-pdp .evr-out{list-style:none;padding:0;margin:0}
#evr-pdp .evr-out li{padding:12px 0 12px 22px;border-bottom:1px solid var(--line);position:relative;font-size:17px}
#evr-pdp .evr-out li:before{content:"";position:absolute;left:0;top:21px;width:8px;height:8px;background:var(--accent)}

/* cart drawer */
#evr-pdp .evr-cd-ov{position:fixed;inset:0;background:rgba(28,26,23,.45);z-index:2147483000}
#evr-pdp .evr-cd{position:fixed;top:0;right:0;height:100%;width:420px;max-width:100%;background:var(--bg);z-index:2147483001;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s ease;box-shadow:-8px 0 30px rgba(0,0,0,.12)}
#evr-pdp .evr-cd.open{transform:none}
#evr-pdp .evr-cd-h{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:1px solid var(--line)}
#evr-pdp .evr-cd-title{font-family:var(--hdr);font-weight:700;font-size:18px}
#evr-pdp .evr-cd-x{background:none;border:0;font-size:30px;line-height:1;cursor:pointer;color:var(--ink);padding:0 4px}
#evr-pdp .evr-cd-msg{margin:12px 20px 0;padding:10px 12px;background:#FBF1EC;border-radius:8px;font-size:14px}
#evr-pdp .evr-cd-lines{flex:1 1 auto;overflow-y:auto;padding:6px 20px}
#evr-pdp .evr-cd-line{display:grid;grid-template-columns:72px 1fr auto;gap:12px;padding:16px 0;border-bottom:1px solid var(--line);align-items:start}
#evr-pdp .evr-cd-line img{width:72px;height:72px;object-fit:cover;border:1px solid var(--line);border-radius:8px;background:#fff}
#evr-pdp .evr-cd-name{font-family:var(--hdr);font-weight:700;font-size:14.5px;line-height:1.25}
#evr-pdp .evr-cd-var{font-size:13px;color:var(--muted);margin-top:2px}
#evr-pdp .evr-cd-qty{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:8px;margin-top:10px;background:#fff}
#evr-pdp .evr-cd-qty button{background:none;border:0;width:32px;height:32px;font-size:17px;cursor:pointer;color:var(--ink)}
#evr-pdp .evr-cd-qty span{min-width:22px;text-align:center;font-size:14px}
#evr-pdp .evr-cd-price{text-align:right;font-family:var(--hdr);font-weight:700;font-size:15px}
#evr-pdp .evr-cd-price s{display:block;font-family:var(--body);font-weight:400;font-size:12.5px;color:var(--muted)}
#evr-pdp .evr-cd-rm{background:none;border:0;color:var(--muted);font-size:12.5px;text-decoration:underline;cursor:pointer;margin-top:10px;padding:0}
#evr-pdp .evr-cd-empty{padding:40px 0;text-align:center;color:var(--muted)}
#evr-pdp .evr-cd-f{border-top:1px solid var(--line);padding:16px 20px 20px;background:#fff}
#evr-pdp .evr-cd-row{display:flex;justify-content:space-between;font-size:15px;margin-bottom:6px}
#evr-pdp .evr-cd-disc{color:var(--accent)}
#evr-pdp .evr-cd-tot{font-family:var(--hdr);font-weight:700;font-size:17px}
#evr-pdp .evr-cd-note{font-size:12.5px;color:var(--muted);margin:4px 0 12px}
#evr-pdp .evr-cd-go{display:block;text-align:center;text-decoration:none;margin-top:0}
#evr-pdp .evr-cd-cont{display:block;width:100%;background:none;border:0;margin-top:10px;font-size:14px;color:var(--muted);text-decoration:underline;cursor:pointer}
#evr-pdp .evr-busy{opacity:.6;pointer-events:none}

/* install steps with photos */
#evr-pdp .evr-steps{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:26px}
#evr-pdp .evr-stp-t{display:flex;gap:14px;align-items:flex-start;margin-bottom:14px}
#evr-pdp .evr-stp .n{font-family:var(--hdr);font-size:40px;color:var(--accent);line-height:1;font-weight:700}
#evr-pdp .evr-stp p{font-size:15px;color:var(--muted);margin:4px 0 0}
#evr-pdp .evr-stp img{width:100%;display:block;border:1px solid var(--line);border-radius:10px}
@media(max-width:640px){#evr-pdp .evr-steps{grid-template-columns:1fr}}

/* grid */
#evr-pdp .attrs{border-top:1px solid var(--line)}
#evr-pdp .attr{display:grid;grid-template-columns:200px 1fr;gap:24px;padding:18px 0;border-bottom:1px solid var(--line)}
#evr-pdp .attr dt{font-family:var(--hdr);font-size:12px;letter-spacing:.11em;text-transform:uppercase;color:var(--accent);font-weight:700}
#evr-pdp .attr dd{margin:0;font-size:16px}

/* stack */
#evr-pdp .stack{background:#fff;border:1px solid var(--line);padding:8px 26px}
#evr-pdp .srow{display:flex;justify-content:space-between;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);font-size:16px}
#evr-pdp .srow:last-child{border-bottom:0}
#evr-pdp .srow b{font-family:var(--hdr)}
#evr-pdp .srow .val{color:var(--accent);font-family:var(--hdr);font-weight:700;white-space:nowrap}

/* steps 3 */
#evr-pdp .three{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:26px}
#evr-pdp .three .n{font-family:var(--hdr);font-size:40px;color:var(--accent);line-height:1;margin-bottom:8px;font-weight:700}

/* alts */
#evr-pdp .alt{display:grid;grid-template-columns:230px 1fr;gap:24px;padding:20px 0;border-bottom:1px solid rgba(255,247,243,.25)}
#evr-pdp .alt b{font-family:var(--hdr)}
#evr-pdp .alt p{margin:0;opacity:.92}

/* faq */
#evr-pdp details{border-bottom:1px solid var(--line)}
#evr-pdp summary{cursor:pointer;list-style:none;padding:20px 0;font-family:var(--hdr);font-weight:700;font-size:17px;display:flex;justify-content:space-between;gap:16px}
#evr-pdp summary::-webkit-details-marker{display:none}
#evr-pdp summary::after{content:'+';color:var(--accent);font-size:22px;line-height:1}
#evr-pdp details[open] summary::after{content:'–'}
#evr-pdp details .fa{padding:0 0 20px;font-size:16px;color:var(--muted);max-width:66ch}

/* reviews */
#evr-pdp .rsum{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:26px}
#evr-pdp .rnum{font-family:var(--hdr);font-size:52px;font-weight:700;line-height:1}
#evr-pdp .rev{border-top:1px solid var(--line);padding:22px 0}
#evr-pdp .rev .rh{font-family:var(--hdr);font-weight:700;margin-bottom:4px}
#evr-pdp .rev .rm{font-size:13px;color:var(--muted);margin-bottom:8px}
#evr-pdp .rev p{font-size:15.5px;margin:0}
#evr-pdp .stars{color:var(--accent);letter-spacing:2px}

/* sticky */
#evr-pdp .sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--bg);border-top:1px solid var(--line);padding:10px 14px;display:none;box-shadow:0 -6px 20px rgba(0,0,0,.07)}
#evr-pdp .sticky .in{display:flex;align-items:center;gap:12px;max-width:1180px;margin:0 auto}
#evr-pdp .sticky .sp{font-family:var(--hdr);font-weight:700;font-size:16px;white-space:nowrap}
#evr-pdp .sticky .sp s{color:var(--muted);font-weight:400;font-size:13px;margin-right:6px}
#evr-pdp .sticky .atc{margin:0;flex:1;padding:14px;font-size:15px}

@media(max-width:880px){
  #evr-pdp .hero{grid-template-columns:1fr;gap:28px;padding-top:24px}
  #evr-pdp .two,#evr-pdp .three,#evr-pdp .opts{grid-template-columns:1fr}
  #evr-pdp .attr,#evr-pdp .alt{grid-template-columns:1fr;gap:6px}
  #evr-pdp .sec{padding:48px 0}
  #evr-pdp .band{padding:52px 0}
  #evr-pdp .sticky{display:block}
  #evr-pdp .hero .atc{margin-bottom:8px}
}
</style>

<div class="announce">
  <span>60-day returns</span><span>·</span><span>Free shipping on 2-packs</span>
</div>

<!-- ================= 2. HERO ================= -->
<div class="wrap">
  <div class="hero">
    <div>
      {%- if product.images.size > 0 -%}
        <div class="evr-car">
          <div class="evr-car-track" id="evr-car" tabindex="0" aria-label="Product images">
            {%- for img in product.images -%}
              <div class="evr-car-slide"><img src="{{ img | image_url: width: 1100 }}" alt="{{ img.alt | default: product.title | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %} width="1100" height="1100"></div>
            {%- endfor -%}
          </div>
          {%- if product.images.size > 1 -%}
            <button type="button" class="evr-car-btn prev" aria-label="Previous image">&#8249;</button>
            <button type="button" class="evr-car-btn next" aria-label="Next image">&#8250;</button>
            <div class="evr-car-dots">
              {%- for img in product.images -%}<span class="{% if forloop.first %}on{% endif %}"></span>{%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gal-thumbs">
            {%- for img in product.images -%}
              <img src="{{ img | image_url: width: 180 }}" alt="" data-i="{{ forloop.index0 }}" class="evr-thumb{% if forloop.first %} on{% endif %}">
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div>
      <h1>{{ product.title }}</h1>
      <p class="sub">{{ section.settings.hero_sub }}</p>

      {%- comment -%}
        BUNDLE — tallow-style stacked radio cards, with the vent dropdown(s) INSIDE the card.
        Tier 1: one dropdown. Tier 2: two dropdowns, so they can mix sizes/colours.
        Cards are divs (role=radio), not buttons: a <select> can't live inside a <button>.
      {%- endcomment -%}
      <div class="evr-bundle" id="evr-tiers" role="radiogroup" aria-label="How many vents">
        <div class="evr-tier on" tabindex="0" data-qty="1"
          data-price="{{ p1 }}" data-compare="{{ p1_cmp }}"
          data-cta="{{ section.settings.cta_single | escape }}"
          role="radio" aria-checked="true">
          <div class="evr-tier-main">
            <span class="evr-tier-radio" aria-hidden="true"></span>
            <span class="evr-tier-body">
              <span class="evr-tier-name">{{ section.settings.t1_label }}</span>
              <span class="evr-tier-sub">{{ section.settings.t1_sub }}</span>
            </span>
            <span class="evr-tier-prices">
              <span class="evr-tier-now">{{ p1 | money }}</span>
              {%- if p1_cmp > p1 -%}<span class="evr-tier-was">{{ p1_cmp | money }}</span>{%- endif -%}
            </span>
          </div>
          <div class="evr-tier-picks">
            <label class="evr-pick-row"><span class="evr-pick-l">{{ section.settings.pick_label }}</span><span class="evr-pick-wrap"><select class="evr-pick evr-v" data-slot="1" aria-label="{{ section.settings.pick_label }}">{%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — out of stock{% endunless %}</option>{%- endfor -%}</select></span></label>
          </div>
        </div>

        <div class="evr-tier" tabindex="0" data-qty="2"
          data-price="{{ p2 }}" data-compare="{{ p2_cmp }}"
          data-cta="{{ section.settings.cta_bundle | escape }}"
          role="radio" aria-checked="false">
          {%- if section.settings.t2_badge != blank -%}<span class="evr-tier-badge">{{ section.settings.t2_badge }}</span>{%- endif -%}
          <div class="evr-tier-main">
            <span class="evr-tier-radio" aria-hidden="true"></span>
            <span class="evr-tier-body">
              <span class="evr-tier-name">{{ section.settings.t2_label }}</span>
              <span class="evr-tier-sub">{{ section.settings.t2_sub }}</span>
            </span>
            <span class="evr-tier-prices">
              <span class="evr-tier-now">{{ p2 | money }}</span>
              <span class="evr-tier-was">{{ p2_cmp | money }}</span>
              <span class="evr-tier-each">{{ p2_each | money }} each</span>
            </span>
          </div>
          <div class="evr-tier-picks">
            <label class="evr-pick-row"><span class="evr-pick-l">{{ section.settings.pick_label_1 }}</span><span class="evr-pick-wrap"><select class="evr-pick evr-v" data-slot="1" aria-label="{{ section.settings.pick_label_1 }}">{%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — out of stock{% endunless %}</option>{%- endfor -%}</select></span></label>
            <label class="evr-pick-row"><span class="evr-pick-l">{{ section.settings.pick_label_2 }}</span><span class="evr-pick-wrap"><select class="evr-pick evr-v" data-slot="2" aria-label="{{ section.settings.pick_label_2 }}">{%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — out of stock{% endunless %}</option>{%- endfor -%}</select></span></label>
          </div>
        </div>
      </div>
      <p class="evr-pick-s">{{ section.settings.pick_help }}</p>

      {%- form 'product', product, id: 'evr-form-hero', class: 'evr-form' -%}
        <input type="hidden" name="id" class="evr-variant-field" value="{{ v.id }}">
        <input type="hidden" name="quantity" class="evr-qty-field" value="1"><span class="evr-items"></span>
        <button type="submit" class="atc evr-cta"{% unless v.available %} disabled{% endunless %}>
          {%- if v.available -%}{{ section.settings.cta_single }}{%- else -%}Sold out{%- endif -%}
        </button>
      {%- endform -%}

      <div class="evr-trust">
        <div class="evr-trust-i"><span class="evr-trust-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>60-day</b><br>returns</span></div>
        <div class="evr-trust-i"><span class="evr-trust-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Free size</b><br>swap</span></div>
        <div class="evr-trust-i"><span class="evr-trust-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5l4 4M4 20l8.5-8.5M12.5 11.5l2-2 4 4-2 2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Two-screw</b><br>install</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ================= 3. CONGRUENCE BAND ================= -->
<div class="band">
  <div class="wrap narrow">
    <p class="eyebrow">If you've tried a fan in there</p>
    <h2>{{ section.settings.congruence_h }}</h2>
    <p>{{ section.settings.congruence_1 }}</p>
    <p>{{ section.settings.congruence_2 }}</p>
    <p style="margin-bottom:0"><b>{{ section.settings.congruence_3 }}</b></p>
  </div>
</div>

<!-- ================= 4. MECHANISM ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">Why it happens</p>
  <h2>{{ section.settings.mech_h }}</h2>
  <p>{{ section.settings.mech_1 }}</p>
  <p><b>{{ section.settings.mech_2 }}</b></p>

  <svg viewBox="0 0 720 260" style="width:100%;height:auto;margin:26px 0 8px" role="img" aria-label="Diagram: air weakening along a duct run">
    <rect x="8" y="150" width="86" height="76" fill="none" stroke="#1C1A17" stroke-width="2"/>
    <text x="51" y="244" font-family="Inter,sans-serif" font-size="12" fill="#6E655C" text-anchor="middle">AC unit</text>
    <line x1="94" y1="188" x2="690" y2="188" stroke="#1C1A17" stroke-width="2"/>
    {%- assign xs = '170,320,470,620' | split: ',' -%}
    {%- assign temps = '72,72,73,81' | split: ',' -%}
    {%- assign widths = '13,9,5,2' | split: ',' -%}
    {%- for x in xs -%}
      {%- assign i = forloop.index0 -%}
      <line x1="{{ x }}" y1="188" x2="{{ x }}" y2="86" stroke="#1C1A17" stroke-width="2"/>
      <line x1="{{ x }}" y1="86" x2="{{ x }}" y2="52" stroke="{% if forloop.last %}#5B7185{% else %}#B4553A{% endif %}" stroke-width="{{ widths[i] }}" stroke-linecap="round"/>
      <rect x="{{ x | minus: 34 }}" y="18" width="68" height="30" fill="none" stroke="#E6DFD6" stroke-width="1.5"/>
      <text x="{{ x }}" y="38" font-family="ui-monospace,Menlo,monospace" font-size="15" font-weight="600" fill="{% if forloop.last %}#5B7185{% else %}#1C1A17{% endif %}" text-anchor="middle">{{ temps[i] }}&#176;</text>
      <text x="{{ x }}" y="212" font-family="Inter,sans-serif" font-size="11" fill="#6E655C" text-anchor="middle">Room {{ forloop.index }}</text>
    {%- endfor -%}
    <text x="620" y="232" font-family="Inter,sans-serif" font-size="11.5" fill="#B4553A" text-anchor="middle" font-weight="600">whatever&#39;s left</text>
  </svg>
  <p style="font-size:14px;color:var(--muted)">{{ section.settings.mech_caption }}</p>
</div></div>

<!-- ================= 5. HAND TEST ================= -->
<div class="sec" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap narrow">
    <p class="eyebrow">Ten-second check</p>
    <h2>{{ section.settings.hand_h }}</h2>
    <p>{{ section.settings.hand_sub }}</p>
    <div class="two">
      <div class="card yes">
        <h3>{{ section.settings.hand_yes_h }}</h3>
        <p>{{ section.settings.hand_yes_b }}</p>
      </div>
      <div class="card no">
        <h3>{{ section.settings.hand_no_h }}</h3>
        <p>{{ section.settings.hand_no_b }}</p>
      </div>
    </div>
  </div>
</div>

<!-- ================= 5b. OUTCOME ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">{{ section.settings.out_eyebrow }}</p>
  <h2>{{ section.settings.out_h }}</h2>
  {%- if section.settings.out_image != blank -%}
    <img src="{{ section.settings.out_image | image_url: width: 1400 }}" alt="{{ section.settings.out_h | escape }}" loading="lazy" style="width:100%;margin:18px 0 22px;border:1px solid var(--line)">
  {%- endif -%}
  <ul class="evr-out">
    <li>{{ section.settings.out_1 }}</li>
    <li>{{ section.settings.out_2 }}</li>
    <li>{{ section.settings.out_3 }}</li>
  </ul>
</div></div>

<!-- ================= 6. ATTRIBUTE GRID ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">The specifics</p>
  <h2>What it is</h2>
  <dl class="attrs">
    <div class="attr"><dt>What it is</dt><dd>A vent cover with fans built in. It replaces the register already in that room.</dd></div>
    <div class="attr"><dt>What it does</dt><dd>Pulls conditioned air out of the duct into the room, instead of waiting for it to arrive.</dd></div>
    <div class="attr"><dt>Fits</dt><dd>{{ section.settings.attr_fits }}</dd></div>
    <div class="attr"><dt>Power</dt><dd>Standard US plug. Any regular wall outlet.</dd></div>
    <div class="attr"><dt>Control</dt><dd>Set a temperature for that one room. It runs when the duct is delivering and stops when it isn&rsquo;t.</dd></div>
    <div class="attr"><dt>Seasons</dt><dd>Cooling in summer, heating in winter. Same unit.</dd></div>
    <div class="attr"><dt>Returns</dt><dd>60 days. Free size swap if you measure wrong.</dd></div>
  </dl>
</div></div>

<!-- ================= 7. FIT ================= -->
<div class="sec" style="background:#fff;border-top:1px solid var(--line)">
  <div class="wrap narrow">
    <p class="eyebrow">Before you order</p>
    <h2>{{ section.settings.fit_h }}</h2>
    <p>{{ section.settings.fit_1 }}</p>
    <p>{{ section.settings.fit_2 }}</p>
    {%- if section.settings.fit_image != blank -%}
      <img src="{{ section.settings.fit_image | image_url: width: 1100 }}" alt="Measuring a vent opening" style="width:100%;margin:22px 0;border:1px solid var(--line)">
    {%- endif -%}
    <div class="card yes" style="margin-top:8px">
      <h3>{{ section.settings.swap_h }}</h3>
      <p>{{ section.settings.swap_b }}</p>
    </div>
  </div>
</div>

<!-- ================= 8. INSTALL ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">Fitting it</p>
  <h2>Two screws and an outlet.</h2>
  <div class="evr-steps">
    <div class="evr-stp">
      <div class="evr-stp-t"><span class="n">1</span><div><b>Swap the cover.</b><p>Unscrew the old one, drop this one in. Same hole, same two screws.</p></div></div>
      {%- if section.settings.install_img_1 != blank -%}<img src="{{ section.settings.install_img_1 | image_url: width: 900 }}" alt="Swapping the old vent cover for the new one" loading="lazy">{%- endif -%}
    </div>
    <div class="evr-stp">
      <div class="evr-stp-t"><span class="n">2</span><div><b>Plug it in.</b><p>Set the temperature you want for that room.</p></div></div>
      {%- if section.settings.install_img_2 != blank -%}<img src="{{ section.settings.install_img_2 | image_url: width: 900 }}" alt="Plugging it in" loading="lazy">{%- endif -%}
    </div>
  </div>
  <p style="margin-top:22px">No ductwork. No tools you don&rsquo;t own. Nobody in your house.</p>
</div></div>

<!-- ================= 9. LIMITS ================= -->
<div class="sec" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap narrow">
    <p class="eyebrow">Being straight with you</p>
    <h2>{{ section.settings.limits_h }}</h2>
    <p>{{ section.settings.limits_1 }}</p>
    <p>{{ section.settings.limits_2 }}</p>
  </div>
</div>

<!-- ================= 10. ALTERNATIVES ================= -->
<div class="band">
  <div class="wrap narrow">
    <p class="eyebrow">What else you could do</p>
    <h2>{{ section.settings.alts_h }}</h2>
    <div class="alt"><b>Another fan</b><p>Cools whoever is sitting in front of it. The room stays where it is.</p></div>
    <div class="alt"><b>Turn the AC down</b><p>Over-cools every room that was already fine, all day, to fix one that isn&rsquo;t.</p></div>
    <div class="alt"><b>Call a contractor</b><p>Rebalancing a duct run is commonly quoted in the thousands. It may well be the right permanent fix. It isn&rsquo;t happening this week.</p></div>
    <div class="alt" style="border-bottom:0"><b>Nothing</b><p>What most people do. For years.</p></div>
  </div>
</div>

<!-- ================= 11. VALUE STACK ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">What you get</p>
  <h2 id="evr-stack-h">{{ section.settings.stack_h }}</h2>
  <div class="stack">
    <div class="srow"><b>{{ product.title }}</b><span class="val" id="evr-stack-price">{{ p1 | money }}</span></div>
    <div class="srow"><b>Remote + room temperature control</b><span class="val">Included</span></div>
    <div class="srow"><b>Free size swap</b><span class="val">{{ section.settings.swap_value }}</span></div>
    <div class="srow"><b>Sizing + install card, in plain English</b><span class="val">Included</span></div>
    <div class="srow"><b>60-day home trial</b><span class="val">Included</span></div>
    <div class="srow"><b>Free shipping on 2-packs</b><span class="val">{{ section.settings.ship_value }}</span></div>
  </div>
  <p style="margin-top:22px"><b>Two rooms? {{ p2_each | money }} each.</b> {{ section.settings.stack_bundle_line }}</p>
  <p><b>{{ section.settings.urgency_line }}</b></p>
</div></div>

<!-- ================= 12. REVIEWS ================= -->
{%- if section.settings.show_reviews -%}
<div class="sec" style="background:#fff;border-top:1px solid var(--line)">
  <div class="wrap narrow">
    <p class="eyebrow">What people say</p>
    <div class="rsum">
      <span class="rnum">{{ section.settings.rev_score }}</span>
      <div>
        <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9734;</div>
        <div style="font-size:14px;color:var(--muted)">{{ section.settings.rev_count }}</div>
      </div>
    </div>
    <div>{{ section.settings.reviews_html }}</div>
  </div>
</div>
{%- endif -%}

<!-- ================= 13. GUARANTEE ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">If it doesn&rsquo;t work</p>
  <h2>{{ section.settings.guar_h }}</h2>
  <p>{{ section.settings.guar_1 }}</p>
  <p>{{ section.settings.guar_2 }}</p>
</div></div>

<!-- ================= 14. FAQ ================= -->
<div class="sec" style="background:#fff;border-top:1px solid var(--line)">
  <div class="wrap narrow">
    <p class="eyebrow">Questions</p>
    <h2>Before you buy</h2>
    {%- for i in (1..14) -%}
      {%- assign qk = 'faq_q_' | append: i -%}
      {%- assign ak = 'faq_a_' | append: i -%}
      {%- if section.settings[qk] != blank -%}
        <details><summary>{{ section.settings[qk] }}</summary><div class="fa">{{ section.settings[ak] }}</div></details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<!-- ================= 15. FINAL CTA ================= -->
<div class="sec"><div class="wrap narrow" style="text-align:center">
  <h2>{{ section.settings.final_h }}</h2>
  <p style="margin:0 auto 26px">{{ section.settings.final_sub }}</p>
  {%- form 'product', product, id: 'evr-form-final', class: 'evr-form' -%}
    <input type="hidden" name="id" class="evr-variant-field" value="{{ v.id }}">
    <input type="hidden" name="quantity" class="evr-qty-field" value="1"><span class="evr-items"></span>
    <button type="submit" class="atc evr-cta" style="max-width:420px;margin:0 auto"{% unless v.available %} disabled{% endunless %}>
      {%- if v.available -%}{{ section.settings.cta_single }}{%- else -%}Sold out{%- endif -%}
    </button>
  {%- endform -%}
  <div class="evr-trust" style="max-width:420px;margin:16px auto 0">
        <div class="evr-trust-i"><span class="evr-trust-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>60-day</b><br>returns</span></div>
        <div class="evr-trust-i"><span class="evr-trust-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Free size</b><br>swap</span></div>
        <div class="evr-trust-i"><span class="evr-trust-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5l4 4M4 20l8.5-8.5M12.5 11.5l2-2 4 4-2 2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Two-screw</b><br>install</span></div>
      </div>
</div></div>

<!-- ================= STICKY ================= -->
<div class="sticky">
  <div class="in">
    <span class="sp" id="evr-sticky-price">{%- if p1_cmp > p1 -%}<s>{{ p1_cmp | money }}</s>{%- endif -%}{{ p1 | money }}</span>
    {%- form 'product', product, id: 'evr-form-sticky', class: 'evr-form' -%}
      <input type="hidden" name="id" class="evr-variant-field" value="{{ v.id }}">
      <input type="hidden" name="quantity" class="evr-qty-field" value="1"><span class="evr-items"></span>
      <button type="submit" class="atc evr-cta"{% unless v.available %} disabled{% endunless %}>
        {%- if v.available -%}{{ section.settings.cta_single }}{%- else -%}Sold out{%- endif -%}
      </button>
    {%- endform -%}
  </div>
</div>

<!-- ================= CART DRAWER ================= -->
{%- if section.settings.use_drawer -%}
<div class="evr-cd-ov" id="evr-cd-ov" hidden></div>
<aside class="evr-cd" id="evr-cd" aria-label="Your cart" aria-hidden="true" tabindex="-1">
  <div class="evr-cd-h">
    <span class="evr-cd-title">{{ section.settings.drawer_title }}</span>
    <button type="button" class="evr-cd-x" id="evr-cd-x" aria-label="Close cart">&times;</button>
  </div>
  <div class="evr-cd-msg" id="evr-cd-msg" hidden></div>
  <div class="evr-cd-lines" id="evr-cd-lines"></div>
  <div class="evr-cd-f">
    <div class="evr-cd-row evr-cd-disc" id="evr-cd-disc" hidden><span>Bundle discount</span><span id="evr-cd-disc-v"></span></div>
    <div class="evr-cd-row evr-cd-tot"><span>Subtotal</span><span id="evr-cd-sub"></span></div>
    <p class="evr-cd-note">{{ section.settings.drawer_note }}</p>
    <a class="atc evr-cd-go" href="{{ routes.root_url | append: 'checkout' | replace: '//', '/' }}">{{ section.settings.drawer_cta }}</a>
    <button type="button" class="evr-cd-cont" id="evr-cd-cont">Keep shopping</button>
  </div>
</aside>
{%- endif -%}
</section>

{%- comment -%}
  ============================================================================
  SELECTOR SCRIPT — isolated on purpose. Own IIFE, own try/catch, END of file.
  It ONLY writes hidden input values, swaps label text and toggles classes.
  It never touches cart, drawer or theme listeners. Do not move it up the file
  and do not merge it into another script block: on tallow a shared try block
  meant one throw here silently killed the cart drawer.
  ============================================================================
{%- endcomment -%}
<script>
(function(){
  try{
    var root = document.getElementById('evr-pdp');
    if(!root) return;

    var forms   = [].slice.call(root.querySelectorAll('.evr-form'));
    var tiers   = [].slice.call(root.querySelectorAll('.evr-tier'));
    var qtyF    = [].slice.call(root.querySelectorAll('.evr-qty-field'));
    var varF    = [].slice.call(root.querySelectorAll('.evr-variant-field'));
    var ctas    = [].slice.call(root.querySelectorAll('.evr-cta'));
    var priceEl = root.querySelector('#evr-price');
    var cmpEl   = root.querySelector('#evr-compare');
    var noteEl  = root.querySelector('#evr-pnote');
    var stickEl = root.querySelector('#evr-sticky-price');
    var stackEl = root.querySelector('#evr-stack-price');

    function money(cents){
      var s = (cents/100).toFixed(2);
      return '{{ cart.currency.symbol | default: "$" }}' + s.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function activeTier(){ return root.querySelector('.evr-tier.on') || tiers[0]; }

    // Write the cart fields into every form (hero, final, sticky).
    // One vent, or two of the same vent -> id + quantity (standard).
    // Two DIFFERENT vents -> items[0]/items[1], one of each.
    function syncFields(){
      var t = activeTier(); if(!t) return;
      var picks = [].slice.call(t.querySelectorAll('.evr-v')).map(function(s){ return s.value; });
      var qty = parseInt(t.getAttribute('data-qty'),10) || 1;
      var mixed = (qty === 2 && picks.length === 2 && picks[0] && picks[1] && picks[0] !== picks[1]);
      forms.forEach(function(fm){
        var idF = fm.querySelector('.evr-variant-field');
        var qF  = fm.querySelector('.evr-qty-field');
        var box = fm.querySelector('.evr-items');
        if(box) box.innerHTML = '';
        if(mixed){
          if(idF){ idF.disabled = true; }
          if(qF){ qF.disabled = true; }
          if(box){
            box.innerHTML =
              '<input type="hidden" name="items[0][id]" value="'+picks[0]+'">' +
              '<input type="hidden" name="items[0][quantity]" value="1">' +
              '<input type="hidden" name="items[1][id]" value="'+picks[1]+'">' +
              '<input type="hidden" name="items[1][quantity]" value="1">';
          }
        } else {
          if(idF){ idF.disabled = false; if(picks[0]) idF.value = picks[0]; }
          if(qF){ qF.disabled = false; qF.value = String(qty); }
        }
      });
    }

    function pickTier(btn){
      tiers.forEach(function(t){
        var on = (t === btn);
        t.classList.toggle('on', on);
        t.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      var pr  = parseInt(btn.getAttribute('data-price'), 10);
      var cmp = parseInt(btn.getAttribute('data-compare'), 10);
      var cta = btn.getAttribute('data-cta') || '';
      if(stackEl && !isNaN(pr)) stackEl.textContent = money(pr);
      if(stickEl && !isNaN(pr)){
        stickEl.innerHTML = (!isNaN(cmp) && cmp > pr ? '<s>' + money(cmp) + '</s>' : '') + money(pr);
      }
      ctas.forEach(function(b){ if(!b.disabled && cta) b.textContent = cta; });
      syncFields();
    }

    tiers.forEach(function(t){
      t.addEventListener('click', function(e){
        if(e.target.closest && e.target.closest('.evr-tier-picks')) { if(!t.classList.contains('on')) pickTier(t); return; }
        pickTier(t);
      });
      t.addEventListener('keydown', function(e){
        if((e.key === 'Enter' || e.key === ' ') && !(e.target.closest && e.target.closest('select'))){ e.preventDefault(); pickTier(t); }
      });
    });
    [].slice.call(root.querySelectorAll('.evr-v')).forEach(function(sel){
      sel.addEventListener('change', syncFields);
    });
    syncFields();

    // gallery carousel: swipe (native scroll-snap), arrows, dots, thumbs
    var car = root.querySelector('#evr-car');
    if(car){
      var slides = [].slice.call(car.querySelectorAll('.evr-car-slide'));
      var dots = [].slice.call(root.querySelectorAll('.evr-car-dots span'));
      var thumbs = [].slice.call(root.querySelectorAll('.evr-thumb'));
      var idx = 0;
      function mark(i){
        idx = i;
        dots.forEach(function(d,k){ d.classList.toggle('on', k === i); });
        thumbs.forEach(function(t,k){ t.classList.toggle('on', k === i); });
      }
      function go(i){
        i = Math.max(0, Math.min(slides.length - 1, i));
        car.scrollTo({left: i * car.clientWidth, behavior: 'smooth'});
        mark(i);
      }
      var tmr;
      car.addEventListener('scroll', function(){
        clearTimeout(tmr);
        tmr = setTimeout(function(){ mark(Math.round(car.scrollLeft / Math.max(1, car.clientWidth))); }, 60);
      }, {passive: true});
      var pv = root.querySelector('.evr-car-btn.prev'), nx = root.querySelector('.evr-car-btn.next');
      if(pv) pv.addEventListener('click', function(){ go(idx - 1); });
      if(nx) nx.addEventListener('click', function(){ go(idx + 1); });
      thumbs.forEach(function(t){ t.addEventListener('click', function(){ go(parseInt(t.getAttribute('data-i'), 10) || 0); }); });
      car.addEventListener('keydown', function(e){ if(e.key === 'ArrowRight') go(idx + 1); if(e.key === 'ArrowLeft') go(idx - 1); });
    }
  }catch(e){ /* never let this break the theme */ }
})();
</script>

{%- comment -%}
  CART DRAWER SCRIPT — own IIFE, own try/catch, after the selector script.
  Catches submits from this section's three forms only, adds via /cart/add.js,
  and shows our drawer. If anything fails it falls back to a normal form post.
{%- endcomment -%}
{%- if section.settings.use_drawer -%}
<script>
(function(){
  try{
    var root = document.getElementById('evr-pdp');
    var cd = document.getElementById('evr-cd');
    if(!root || !cd || !window.fetch) return;
    var ov = document.getElementById('evr-cd-ov');
    var linesEl = document.getElementById('evr-cd-lines');
    var subEl = document.getElementById('evr-cd-sub');
    var discRow = document.getElementById('evr-cd-disc');
    var discEl = document.getElementById('evr-cd-disc-v');
    var msgEl = document.getElementById('evr-cd-msg');
    var base = '{{ routes.root_url }}'.replace(/\/$/, '');
    var cur = '{{ cart.currency.symbol | default: "$" }}';

    function money(c){ return cur + (c/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    function esc(t){ return String(t == null ? '' : t).replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]; }); }
    function msg(t){ if(!msgEl) return; if(t){ msgEl.textContent = t; msgEl.hidden = false; } else { msgEl.hidden = true; } }

    function open(){ ov.hidden = false; cd.classList.add('open'); cd.setAttribute('aria-hidden','false'); document.documentElement.style.overflow='hidden'; try{ cd.focus(); }catch(e){} }
    function close(){ cd.classList.remove('open'); cd.setAttribute('aria-hidden','true'); ov.hidden = true; document.documentElement.style.overflow=''; }

    function updateBubbles(n){
      [].slice.call(document.querySelectorAll('.cart-count-bubble span, [data-cart-count], .cart-count, #CartCount')).forEach(function(el){ el.textContent = n; });
    }

    function render(cart){
      if(!cart.items.length){
        linesEl.innerHTML = '<p class="evr-cd-empty">Your cart is empty.</p>';
      } else {
        linesEl.innerHTML = cart.items.map(function(it, i){
          var img = it.image ? it.image.replace(/(\.[a-z]+)(\?|$)/i, '_160x160$1$2') : '';
          var was = (it.original_line_price > it.final_line_price) ? '<s>' + money(it.original_line_price) + '</s>' : '';
          var vt = (it.variant_title && it.variant_title !== 'Default Title') ? '<div class="evr-cd-var">' + esc(it.variant_title) + '</div>' : '';
          return '<div class="evr-cd-line" data-line="' + (i+1) + '">' +
            (img ? '<img src="' + esc(img) + '" alt="">' : '<span></span>') +
            '<div><div class="evr-cd-name">' + esc(it.product_title) + '</div>' + vt +
              '<div class="evr-cd-qty"><button type="button" data-q="' + (it.quantity-1) + '" aria-label="Decrease">&minus;</button><span>' + it.quantity + '</span><button type="button" data-q="' + (it.quantity+1) + '" aria-label="Increase">+</button></div>' +
              '<div><button type="button" class="evr-cd-rm" data-q="0">Remove</button></div></div>' +
            '<div class="evr-cd-price">' + was + money(it.final_line_price) + '</div>' +
          '</div>';
        }).join('');
      }
      var disc = cart.total_discount || 0;
      if(disc > 0){ discEl.textContent = '\u2212' + money(disc); discRow.hidden = false; } else { discRow.hidden = true; }
      subEl.textContent = money(cart.total_price);
      updateBubbles(cart.item_count);
    }

    function load(){ return fetch(base + '/cart.js', {headers:{'Accept':'application/json'}}).then(function(r){ return r.json(); }).then(render); }

    function change(line, q){
      linesEl.classList.add('evr-busy');
      return fetch(base + '/cart/change.js', {method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({line: line, quantity: q})})
        .then(function(r){ return r.json(); }).then(function(c){ msg(''); render(c); })
        .catch(function(){ msg('Something went wrong. Please try again.'); })
        .then(function(){ linesEl.classList.remove('evr-busy'); });
    }

    function itemsFrom(form){
      var fd = new FormData(form), items = [], id = fd.get('id');
      if(id && !form.querySelector('.evr-variant-field').disabled){
        items.push({id: parseInt(id,10), quantity: parseInt(fd.get('quantity') || '1', 10)});
      } else {
        for(var i=0;i<4;i++){
          var iid = fd.get('items['+i+'][id]');
          if(iid) items.push({id: parseInt(iid,10), quantity: parseInt(fd.get('items['+i+'][quantity]') || '1', 10)});
        }
      }
      return items;
    }

    [].slice.call(root.querySelectorAll('.evr-form')).forEach(function(form){
      form.addEventListener('submit', function(e){
        var items = itemsFrom(form);
        if(!items.length) return;             // let the normal post happen
        e.preventDefault(); e.stopPropagation();
        var btn = form.querySelector('[type=submit]');
        if(btn) btn.classList.add('evr-busy');
        fetch(base + '/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({items: items})})
          .then(function(r){ return r.json().then(function(j){ return {ok: r.ok, j: j}; }); })
          .then(function(res){
            if(!res.ok){ msg(res.j.description || res.j.message || 'That size is out of stock.'); }
            else { msg(''); }
            return load().then(open);
          })
          .catch(function(){ form.submit(); }) // fallback: normal theme cart
          .then(function(){ if(btn) btn.classList.remove('evr-busy'); });
      }, true);
    });

    linesEl.addEventListener('click', function(e){
      var b = e.target.closest && e.target.closest('[data-q]'); if(!b) return;
      var line = parseInt(b.closest('.evr-cd-line').getAttribute('data-line'), 10);
      change(line, Math.max(0, parseInt(b.getAttribute('data-q'), 10)));
    });
    ov.addEventListener('click', close);
    document.getElementById('evr-cd-x').addEventListener('click', close);
    document.getElementById('evr-cd-cont').addEventListener('click', close);
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && cd.classList.contains('open')) close(); });
  }catch(e){ /* never let this break the theme */ }
})();
</script>
{%- endif -%}


