{%- comment -%} SELECTOR SCRIPT: own IIFE, own try/catch. Only writes hidden inputs and toggles classes. {%- endcomment -%}
<script>
(function(){
  try{
    var root = document.getElementById('pa-pdp');
    if(!root) return;
    var forms = [].slice.call(root.querySelectorAll('.pa-form'));
    var tiers = [].slice.call(root.querySelectorAll('.pa-tier'));
    var ctas  = [].slice.call(root.querySelectorAll('.pa-cta'));
    var gift  = root.getAttribute('data-gift');
    var defV  = (root.querySelector('.pa-variant-field') || {}).value;
    var cur   = '{{ cart.currency.symbol | default: "$" }}';
    function money(c){ return cur + (c/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    function active(){ return root.querySelector('.pa-tier.on') || tiers[0]; }

    // Build the cart lines for the selected tier: grouped handhelds + free cases on bundles.
    function lines(){
      var t = active(); if(!t) return [];
      var qty = parseInt(t.getAttribute('data-qty'),10) || 1;
      var picks = [].slice.call(t.querySelectorAll('.pa-v')).map(function(s){ return s.value; });
      while(picks.length < qty) picks.push(defV);
      var map = {}, order = [];
      picks.forEach(function(id){ if(!map[id]){ map[id] = 0; order.push(id); } map[id]++; });
      var out = order.map(function(id){ return {id: id, quantity: map[id]}; });
      if(qty > 1 && gift) out.push({id: gift, quantity: qty});
      return out;
    }
    function sync(){
      var ls = lines();
      forms.forEach(function(fm){
        var idF = fm.querySelector('.pa-variant-field'), qF = fm.querySelector('.pa-qty-field'), box = fm.querySelector('.pa-items');
        if(idF) idF.disabled = true; if(qF) qF.disabled = true;
        if(box) box.innerHTML = ls.map(function(l,i){
          return '<input type="hidden" name="items['+i+'][id]" value="'+l.id+'"><input type="hidden" name="items['+i+'][quantity]" value="'+l.quantity+'">';
        }).join('');
      });
    }
    function stickyTier(){
      var el = root.querySelector('#pa-sticky-tier'), t = active(); if(!el || !t) return;
      el.textContent = (t.querySelector('.pa-tier-name') || {}).textContent || '';
    }
    function pick(t){
      tiers.forEach(function(x){ var on = (x === t); x.classList.toggle('on', on); x.setAttribute('aria-checked', on ? 'true' : 'false'); });
      var pr = parseInt(t.getAttribute('data-price'),10), cmp = parseInt(t.getAttribute('data-compare'),10), cta = t.getAttribute('data-cta') || '';
      var sp = root.querySelector('#pa-sticky-price');
      if(sp && !isNaN(pr)) sp.innerHTML = (!isNaN(cmp) && cmp > pr ? '<s>'+money(cmp)+'</s>' : '') + money(pr);
      ctas.forEach(function(b){ if(!b.disabled && cta) b.textContent = cta; });
      sync(); stickyTier();
    }
    tiers.forEach(function(t){
      t.addEventListener('click', function(e){
        if(e.target.closest && e.target.closest('.pa-tier-picks, .pa-gifts')){ if(!t.classList.contains('on')) pick(t); return; }
        pick(t);
      });
      t.addEventListener('keydown', function(e){
        if((e.key === 'Enter' || e.key === ' ') && !(e.target.closest && e.target.closest('select'))){ e.preventDefault(); pick(t); }
      });
    });
    [].slice.call(root.querySelectorAll('.pa-v')).forEach(function(s){ s.addEventListener('change', sync); });
    pick(active());

    var cbtn = root.querySelector('#pa-cart-btn');
    if(cbtn && !document.getElementById('pa-cd')) cbtn.addEventListener('click', function(){ window.location.href = '{{ routes.cart_url }}'; });

    var sticky = root.querySelector('#pa-sticky'), hero = root.querySelector('#pa-form-hero');
    if(sticky && hero && 'IntersectionObserver' in window){
      new IntersectionObserver(function(en){
        var past = !en[0].isIntersecting && en[0].boundingClientRect.top < 0;
        sticky.classList.toggle('show', past); sticky.setAttribute('aria-hidden', past ? 'false' : 'true');
      }).observe(hero);
    } else if(sticky){ sticky.classList.add('show'); }

    var car = root.querySelector('#pa-car');
    if(car){
      var slides = [].slice.call(car.querySelectorAll('.pa-car-slide')), dots = [].slice.call(root.querySelectorAll('.pa-car-dots span')), thumbs = [].slice.call(root.querySelectorAll('.pa-thumb')), idx = 0, tmr;
      function mark(i){ idx = i; dots.forEach(function(d,k){ d.classList.toggle('on', k === i); }); thumbs.forEach(function(x,k){ x.classList.toggle('on', k === i); }); }
      function go(i){ i = Math.max(0, Math.min(slides.length - 1, i)); car.scrollTo({left: i * car.clientWidth, behavior: 'smooth'}); mark(i); }
      car.addEventListener('scroll', function(){ clearTimeout(tmr); tmr = setTimeout(function(){ mark(Math.round(car.scrollLeft / Math.max(1, car.clientWidth))); }, 60); }, {passive: true});
      var pv = root.querySelector('.pa-car-btn.prev'), nx = root.querySelector('.pa-car-btn.next');
      if(pv) pv.addEventListener('click', function(){ go(idx - 1); });
      if(nx) nx.addEventListener('click', function(){ go(idx + 1); });
      thumbs.forEach(function(x){ x.addEventListener('click', function(){ go(parseInt(x.getAttribute('data-i'),10) || 0); }); });
    }
  }catch(e){}
})();
</script>

{%- comment -%} ARRIVES-BY: own IIFE. Shows the delivery window and, before the cutoff, the Christmas order-by date. {%- endcomment -%}
{%- if section.settings.show_arrive -%}
<script>
(function(){
  try{
    var box = document.getElementById('pa-arrive'), t = document.getElementById('pa-arrive-t');
    if(!box || !t) return;
    var mn = parseInt(box.getAttribute('data-min'),10) || 5, mx = parseInt(box.getAttribute('data-max'),10) || 12;
    var now = new Date(), M = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function add(d){ var x = new Date(now); x.setDate(x.getDate() + d); return x; }
    function f(d){ return M[d.getMonth()] + ' ' + d.getDate(); }
    var a = add(mn), b = add(mx), msg = 'Order today, arrives <b>' + f(a) + ' – ' + f(b) + '</b>.';
    var raw = (box.getAttribute('data-xmas') || '').trim(), cut = raw ? new Date(raw + 'T23:59:59') : null;
    if(cut && !isNaN(cut)){
      if(now <= cut) msg = '<b>Arrives before Christmas.</b> Order by ' + f(cut) + '. Delivery ' + f(a) + ' – ' + f(b) + '.';
    } else if(now.getMonth() >= 9 && b.getMonth() === 11 && b.getDate() <= 22){
      msg = '<b>Arrives before Christmas.</b> Delivery ' + f(a) + ' – ' + f(b) + '.';
    }
    t.innerHTML = msg;
  }catch(e){}
})();
</script>
{%- endif -%}

{%- comment -%} CART DRAWER: own IIFE. Adds via /cart/add.js, free-shipping bar, case upsell, keeps gift cases matched to bundles. {%- endcomment -%}
{%- if section.settings.use_drawer -%}
<script>
(function(){
  try{
    var root = document.getElementById('pa-pdp'), cd = document.getElementById('pa-cd');
    if(!root || !cd || !window.fetch) return;
    var ov = document.getElementById('pa-cd-ov'), linesEl = document.getElementById('pa-cd-lines'), subEl = document.getElementById('pa-cd-sub');
    var discRow = document.getElementById('pa-cd-disc'), discEl = document.getElementById('pa-cd-disc-v'), msgEl = document.getElementById('pa-cd-msg');
    var shipT = document.getElementById('pa-cd-ship-t'), bar = document.getElementById('pa-cd-bar'), up = document.getElementById('pa-up');
    var base = '{{ routes.root_url }}'.replace(/\/$/, ''), cur = '{{ cart.currency.symbol | default: "$" }}';
    var pid = parseInt(root.getAttribute('data-product'),10), gift = parseInt(root.getAttribute('data-gift'),10), upsell = parseInt(root.getAttribute('data-upsell'),10);
    var free = parseInt(root.getAttribute('data-freeship'),10) || 0;
    var fixing = false;

    function money(c){ return cur + (c/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]; }); }
    function msg(s){ if(!msgEl) return; if(s){ msgEl.textContent = s; msgEl.hidden = false; } else msgEl.hidden = true; }
    function open(){ ov.hidden = false; cd.classList.add('open'); cd.setAttribute('aria-hidden','false'); document.documentElement.style.overflow = 'hidden'; try{ cd.focus(); }catch(e){} }
    function close(){ cd.classList.remove('open'); cd.setAttribute('aria-hidden','true'); ov.hidden = true; document.documentElement.style.overflow = ''; }
    function bubbles(n){
      [].slice.call(document.querySelectorAll('.cart-count-bubble span, [data-cart-count], .cart-count, #CartCount')).forEach(function(el){ el.textContent = n; });
      var mine = document.getElementById('pa-cart-n'); if(mine){ mine.textContent = n; mine.hidden = !n; }
    }
    function post(url, body){
      return fetch(base + url, {method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify(body)})
        .then(function(r){ return r.json().then(function(j){ return {ok: r.ok, j: j}; }); });
    }

    function render(cart){
      var hand = 0, gifts = 0, giftLine = 0, hasUp = false;
      cart.items.forEach(function(it, i){
        if(it.product_id === pid) hand += it.quantity;
        if(it.variant_id === gift){ gifts += it.quantity; giftLine = i + 1; }
        if(it.variant_id === upsell) hasUp = true;
      });
      // Gift cases only belong with 2+ handhelds, one per handheld.
      var want = hand >= 2 ? hand : 0;
      if(giftLine && gifts !== want && !fixing){
        fixing = true;
        return post('/cart/change.js', {line: giftLine, quantity: want}).then(function(r){ fixing = false; return render(r.j); }, function(){ fixing = false; });
      }
      if(!cart.items.length){
        linesEl.innerHTML = '<p class="pa-cd-empty">Your cart is empty.</p>';
      } else {
        linesEl.innerHTML = cart.items.map(function(it, i){
          var img = it.image ? it.image.replace(/(\.[a-z]+)(\?|$)/i, '_160x160$1$2') : '';
          var isGift = it.variant_id === gift;
          var was = (it.original_line_price > it.final_line_price) ? '<s>' + money(it.original_line_price) + '</s>' : '';
          var vt = (it.variant_title && it.variant_title !== 'Default Title') ? '<div class="pa-cd-var">' + esc(it.variant_title) + '</div>' : '';
          var ctrl = isGift ? '<div class="pa-cd-var">Free with your bundle</div>' :
            '<div class="pa-cd-qty"><button type="button" data-q="' + (it.quantity-1) + '" aria-label="Decrease">&minus;</button><span>' + it.quantity + '</span><button type="button" data-q="' + (it.quantity+1) + '" aria-label="Increase">+</button></div>' +
            '<div><button type="button" class="pa-cd-rm" data-q="0">Remove</button></div>';
          return '<div class="pa-cd-line" data-line="' + (i+1) + '">' + (img ? '<img src="' + esc(img) + '" alt="">' : '<span></span>') +
            '<div><div class="pa-cd-name">' + (isGift ? it.quantity + ' × ' : '') + esc(it.product_title) + '</div>' + (isGift ? '' : vt) + ctrl + '</div>' +
            '<div class="pa-cd-price">' + (isGift ? '<span class="pa-cd-free">FREE</span>' : was + money(it.final_line_price)) + '</div></div>';
        }).join('');
      }
      var disc = cart.total_discount || 0;
      if(disc > 0){ discEl.textContent = '−' + money(disc); discRow.hidden = false; } else discRow.hidden = true;
      subEl.textContent = money(cart.total_price);
      if(free && shipT && bar){
        var left = free - cart.total_price;
        if(!cart.items.length){ shipT.innerHTML = 'Free shipping on orders over <b>' + money(free) + '</b>'; bar.style.width = '0'; }
        else if(left > 0){ shipT.innerHTML = 'You’re <b>' + money(left) + '</b> away from free shipping'; bar.style.width = Math.min(100, cart.total_price / free * 100) + '%'; }
        else { shipT.innerHTML = '<b>You’ve got free shipping!</b>'; bar.style.width = '100%'; }
      }
      if(up) up.hidden = !(hand > 0 && hand < 2 && !hasUp && upsell);
      bubbles(cart.item_count);
    }

    function load(){ return fetch(base + '/cart.js', {headers:{'Accept':'application/json'}}).then(function(r){ return r.json(); }).then(render); }
    function change(line, q){
      linesEl.classList.add('pa-busy');
      return post('/cart/change.js', {line: line, quantity: q}).then(function(r){ msg(''); return render(r.j); })
        .catch(function(){ msg('Something went wrong. Please try again.'); })
        .then(function(){ linesEl.classList.remove('pa-busy'); });
    }
    function itemsFrom(form){
      var fd = new FormData(form), items = [];
      for(var i = 0; i < 6; i++){
        var id = fd.get('items['+i+'][id]');
        if(id) items.push({id: parseInt(id,10), quantity: parseInt(fd.get('items['+i+'][quantity]') || '1', 10)});
      }
      return items;
    }

    [].slice.call(root.querySelectorAll('.pa-form')).forEach(function(form){
      form.addEventListener('submit', function(e){
        var items = itemsFrom(form);
        if(!items.length) return;
        e.preventDefault(); e.stopPropagation();
        var btn = form.querySelector('[type=submit]'); if(btn) btn.classList.add('pa-busy');
        post('/cart/add.js', {items: items})
          .then(function(res){ msg(res.ok ? '' : (res.j.description || res.j.message || 'That one is sold out.')); return load().then(open); })
          .catch(function(){ form.submit(); })
          .then(function(){ if(btn) btn.classList.remove('pa-busy'); });
      }, true);
    });
    var upAdd = document.getElementById('pa-up-add');
    if(upAdd) upAdd.addEventListener('click', function(){
      upAdd.classList.add('pa-busy');
      post('/cart/add.js', {items: [{id: upsell, quantity: 1}]}).then(load).catch(function(){ msg('Something went wrong. Please try again.'); })
        .then(function(){ upAdd.classList.remove('pa-busy'); });
    });
    linesEl.addEventListener('click', function(e){
      var b = e.target.closest && e.target.closest('[data-q]'); if(!b) return;
      change(parseInt(b.closest('.pa-cd-line').getAttribute('data-line'),10), Math.max(0, parseInt(b.getAttribute('data-q'),10)));
    });
    var cbtn = document.getElementById('pa-cart-btn');
    if(cbtn) cbtn.addEventListener('click', function(){ load().then(open); });
    ov.addEventListener('click', close);
    document.getElementById('pa-cd-x').addEventListener('click', close);
    document.getElementById('pa-cd-cont').addEventListener('click', close);
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && cd.classList.contains('open')) close(); });
  }catch(e){}
})();
</script>
{%- endif -%}

{%- if section.settings.sale_on -%}
<script>
(function(){
  try{
    var bar = document.getElementById('pa-sale'), clk = document.getElementById('pa-sale-clock');
    if(!bar || !clk) return;
    var raw = (bar.getAttribute('data-end') || '').trim();
    function target(){
      var now = new Date();
      if(raw){ var t = new Date(raw.replace(' ', 'T')); if(!isNaN(t) && t > now) return t; if(!isNaN(t)) return null; }
      var m = new Date(now); m.setHours(24,0,0,0); return m;
    }
    function pad(n){ return (n < 10 ? '0' : '') + n; }
    function tick(){
      var t = target(); if(!t){ bar.style.display = 'none'; return; }
      var d = Math.max(0, Math.floor((t - new Date()) / 1000));
      var days = Math.floor(d / 86400), h = Math.floor(d % 86400 / 3600), m = Math.floor(d % 3600 / 60), s = d % 60;
      clk.textContent = (days ? days + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
    }
    tick(); setInterval(tick, 1000);
  }catch(e){}
})();
</script>
{%- endif -%}

