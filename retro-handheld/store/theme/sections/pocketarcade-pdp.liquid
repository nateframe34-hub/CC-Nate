{%- comment -%}
  POCKETARCADE PDP · gift-first Q4 build · 2026-10-16
  Reskinned from register-fan/store/theme/sections/evenroom-pdp-sa1.liquid.

  OFFER (founder, 2026-10-16)
    Single  = product.price, no gift, $4.99 shipping
    Duo     = 2 handhelds + 2 FREE cases, free shipping   (display price: duo_price_cents)
    Trio    = 3 handhelds + 3 FREE cases, free shipping   (display price: trio_price_cents)
    Case    = $12 in-cart upsell. Single + case reaches the free-shipping threshold.

  SHOPIFY ADMIN SETUP (the page only DISPLAYS prices; Shopify charges them)
  1. Case product: pick it in the section setting "Case product". Give it TWO variants:
       - "Silicone case"        $12.00   (the upsell)
       - "Free with your bundle" $0.00   (the bundle gift; hide the product from
                                          search and collections)
     The section finds them by price: the $0 variant = gift, the other = upsell.
  2. Automatic discounts → Amount off products → PocketArcade only →
       "Only apply once per order":
       - Min quantity 2: (2 × price) − duo price   e.g. 149.98 − 139.99 = $9.99
       - Min quantity 3: (3 × price) − trio price  e.g. 224.97 − 199.99 = $24.98
     Shopify applies the better one. Check the cart total matches the page.
  3. Shipping: $4.99 flat, free at or over single + case (e.g. $86.99).
     Match it in the setting "Free shipping threshold (cents)".

  JS SAFETY (learned on tallow): each script is its own IIFE with its own
  try/catch at the end of the file. A throw in one can never kill another.
  No game titles, consoles or console brands anywhere on this page.
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign p1 = product.price -%}
{%- assign p1_cmp = product.compare_at_price | default: 0 -%}
{%- if p1_cmp > p1 -%}{%- assign unit_cmp = p1_cmp -%}{%- else -%}{%- assign unit_cmp = p1 -%}{%- endif -%}
{%- assign p2 = section.settings.duo_price_cents -%}
{%- assign p3 = section.settings.trio_price_cents -%}
{%- assign p2_cmp = unit_cmp | times: 2 -%}
{%- assign p3_cmp = unit_cmp | times: 3 -%}
{%- assign p2_each = p2 | divided_by: 2 -%}
{%- assign p3_each = p3 | divided_by: 3 -%}

{%- assign cp = section.settings.case_product -%}
{%- assign case_up = nil -%}{%- assign case_gift = nil -%}
{%- if cp != blank -%}
  {%- for cv in cp.variants -%}
    {%- if cv.price == 0 -%}{%- assign case_gift = cv -%}{%- elsif case_up == nil -%}{%- assign case_up = cv -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

<section id="pa-pdp" data-section-id="{{ section.id }}"
  data-product="{{ product.id }}"
  data-gift="{% if case_gift %}{{ case_gift.id }}{% endif %}"
  data-upsell="{% if case_up %}{{ case_up.id }}{% endif %}"
  data-freeship="{{ section.settings.free_ship_cents }}">

{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;700;800&family=Inter:wght@400;500;600&family=Press+Start+2P&display=swap" rel="stylesheet">
{%- endif -%}

<style>
#pa-pdp{
  --bg:#FBF8F3; --ink:#17171F; --accent:#D63A2F; --accent-ink:#FFFFFF; --soft:#FCEDEA;
  --green:#1F6F5C; --line:#E7E1D8; --muted:#666170; --card:#FFFFFF;
  --hdr:'Rubik','Helvetica Neue',Arial,sans-serif;
  --body:'Inter','Helvetica Neue',Arial,sans-serif;
  --pix:'Press Start 2P',ui-monospace,monospace;
  background:var(--bg); color:var(--ink); font-family:var(--body);
  font-size:17px; line-height:1.6; -webkit-font-smoothing:antialiased;
}
#pa-pdp *,#pa-pdp *::before,#pa-pdp *::after{box-sizing:border-box}
#pa-pdp .wrap{max-width:1180px;margin:0 auto;padding:0 20px}
#pa-pdp .narrow{max-width:760px;margin:0 auto}
#pa-pdp h1,#pa-pdp h2,#pa-pdp h3{font-family:var(--hdr);font-weight:800;line-height:1.12;letter-spacing:-.015em;margin:0 0 .5em}
#pa-pdp h1{font-size:clamp(30px,5vw,44px)}
#pa-pdp h2{font-size:clamp(26px,4vw,36px)}
#pa-pdp h3{font-size:clamp(18px,2.4vw,21px);font-weight:700}
#pa-pdp p{margin:0 0 1em;max-width:62ch}
#pa-pdp .sec{padding:64px 0}
#pa-pdp .white{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
#pa-pdp .band{background:var(--ink);color:#fff;padding:72px 0}
#pa-pdp .band h2,#pa-pdp .band h3{color:#fff}
#pa-pdp .eyebrow{font-family:var(--hdr);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 14px;font-weight:700}
#pa-pdp .band .eyebrow{color:#FF8C82}

/* top bar */
#pa-pdp .pa-top{position:sticky;top:0;z-index:55;display:flex;align-items:center;justify-content:center;height:54px;background:var(--bg);border-bottom:1px solid var(--line)}
#pa-pdp .pa-wordmark{font-family:var(--pix);font-size:13px;letter-spacing:.06em;color:var(--ink)}
#pa-pdp .pa-wordmark b{color:var(--accent);font-weight:400}
#pa-pdp .pa-cart-btn{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border:0;background:none;color:var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center}
#pa-pdp .pa-cart-left{left:10px}#pa-pdp .pa-cart-right{right:10px}
#pa-pdp .pa-cart-btn svg{width:25px;height:25px}
#pa-pdp .pa-cart-n{position:absolute;top:4px;right:2px;min-width:18px;height:18px;border-radius:9px;background:var(--accent);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 4px}
#pa-pdp .pa-cart-n[hidden]{display:none}

/* announcement + sale */
#pa-pdp .announce{background:var(--ink);color:#fff;font-size:13px;letter-spacing:.03em;text-align:center;padding:10px 16px}
#pa-pdp .announce span{margin:0 8px;white-space:nowrap}
#pa-pdp .pa-sale{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;background:var(--accent)}
#pa-pdp .pa-sale span{margin:0}
#pa-pdp .pa-sale-tag{background:#fff;color:var(--accent);font-family:var(--hdr);font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:999px}
#pa-pdp .pa-sale-clock{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:14px;font-variant-numeric:tabular-nums}

/* hero + gallery */
#pa-pdp .hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:40px 0 64px;align-items:start}
#pa-pdp .pa-car{position:relative}
#pa-pdp .pa-car-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:none;border:1px solid var(--line);border-radius:14px;background:#fff}
#pa-pdp .pa-car-track::-webkit-scrollbar{display:none}
#pa-pdp .pa-car-slide{flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1/1}
#pa-pdp .pa-car-slide img{width:100%;height:100%;object-fit:cover;display:block}
#pa-pdp .pa-car-btn{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.92);font-size:26px;line-height:1;color:var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0 0 3px}
#pa-pdp .pa-car-btn.prev{left:10px}#pa-pdp .pa-car-btn.next{right:10px}
#pa-pdp .pa-car-dots{position:absolute;left:0;right:0;bottom:12px;display:flex;justify-content:center;gap:7px;pointer-events:none}
#pa-pdp .pa-car-dots span{width:7px;height:7px;border-radius:50%;background:rgba(23,23,31,.22);transition:background .2s,transform .2s}
#pa-pdp .pa-car-dots span.on{background:var(--accent);transform:scale(1.25)}
@media(hover:none){#pa-pdp .pa-car-btn{display:none}}
#pa-pdp .gal-thumbs{display:flex;gap:8px;margin-top:8px;overflow-x:auto;scrollbar-width:none}
#pa-pdp .gal-thumbs::-webkit-scrollbar{display:none}
#pa-pdp .gal-thumbs img{flex:0 0 auto;width:72px;height:72px;object-fit:cover;border:1px solid var(--line);border-radius:8px;cursor:pointer;background:#fff}
#pa-pdp .gal-thumbs img.on{border-color:var(--accent);border-width:2px}
#pa-pdp .sub{font-size:18px;color:var(--muted);margin:-.2em 0 14px;max-width:38ch}
#pa-pdp .pa-bul{list-style:none;padding:0;margin:0 0 20px}
#pa-pdp .pa-bul li{position:relative;padding:4px 0 4px 28px;font-size:15.5px}
#pa-pdp .pa-bul li:before{content:"";position:absolute;left:2px;top:9px;width:16px;height:16px;border-radius:50%;background:var(--green)}
#pa-pdp .pa-bul li:after{content:"";position:absolute;left:7px;top:12px;width:5px;height:8px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}

/* arrives-by */
#pa-pdp .pa-arrive{display:flex;align-items:center;gap:10px;background:#EAF4F0;border:1px solid #CFE5DC;border-radius:10px;padding:10px 12px;font-size:14px;margin:0 0 16px}
#pa-pdp .pa-arrive svg{flex:0 0 auto;width:22px;height:22px;color:var(--green)}
#pa-pdp .pa-arrive b{color:var(--green)}

/* tiers */
#pa-pdp .pa-bundle{display:flex;flex-direction:column;gap:12px;margin:0 0 6px}
#pa-pdp .pa-tier{position:relative;display:block;width:100%;padding:15px 14px;border:1.5px solid var(--line);border-radius:12px;background:#fff;text-align:left;cursor:pointer;color:inherit;transition:border-color .15s,background .15s}
#pa-pdp .pa-tier:hover{border-color:var(--muted)}
#pa-pdp .pa-tier:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
#pa-pdp .pa-tier.on{border-color:var(--accent);border-width:2px;padding:14px 13px;background:var(--soft)}
#pa-pdp .pa-tier-main{display:flex;align-items:center;gap:12px;width:100%}
#pa-pdp .pa-tier-radio{flex:0 0 auto;width:20px;height:20px;border-radius:50%;border:1.5px solid #c9c0b3;background:#fff;position:relative}
#pa-pdp .pa-tier.on .pa-tier-radio{border-color:var(--accent);border-width:2px}
#pa-pdp .pa-tier.on .pa-tier-radio:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--accent)}
#pa-pdp .pa-tier-body{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:2px}
#pa-pdp .pa-tier-name{font-family:var(--hdr);font-weight:700;font-size:16px;line-height:1.2}
#pa-pdp .pa-tier-sub{font-size:12.5px;color:var(--muted)}
#pa-pdp .pa-tier-prices{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;gap:1px}
#pa-pdp .pa-tier-now{font-family:var(--hdr);font-size:19px;font-weight:800;line-height:1.15}
#pa-pdp .pa-tier-was{font-size:12.5px;color:var(--muted);text-decoration:line-through}
#pa-pdp .pa-tier-each{font-size:11.5px;color:var(--muted)}
#pa-pdp .pa-tier-badge{position:absolute;top:-10px;right:12px;background:var(--accent);color:#fff;font-family:var(--hdr);font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:3px 9px;border-radius:999px;white-space:nowrap}
#pa-pdp .pa-tier-badge.alt{background:var(--green)}
#pa-pdp .pa-tier-picks{display:none;margin-top:6px;padding-left:32px;cursor:default}
#pa-pdp .pa-tier.on .pa-tier-picks{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px}
#pa-pdp .pa-pick-l{display:block;font-family:var(--hdr);font-weight:700;font-size:12.5px;margin:0 0 4px}
#pa-pdp .pa-pick-wrap{position:relative;display:block}
#pa-pdp .pa-pick-wrap:after{content:"";position:absolute;right:14px;top:50%;width:8px;height:8px;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:translateY(-70%) rotate(45deg);pointer-events:none}
#pa-pdp .pa-pick{width:100%;appearance:none;-webkit-appearance:none;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:10px 34px 10px 12px;font-family:var(--body);font-size:15px;color:var(--ink);cursor:pointer}
#pa-pdp .pa-gifts{display:none;margin:12px 0 2px 32px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 12px;cursor:default}
#pa-pdp .pa-tier.on .pa-gifts{display:block}
#pa-pdp .pa-gifts-h{font-family:var(--hdr);font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin:0 0 6px}
#pa-pdp .pa-gifts ul{list-style:none;margin:0;padding:0}
#pa-pdp .pa-gifts li{display:flex;align-items:center;gap:10px;padding:7px 0;border-top:1px solid var(--line)}
#pa-pdp .pa-gifts li:first-child{border-top:0}
#pa-pdp .pa-gift-ic{flex:0 0 auto;width:28px;height:28px;border-radius:50%;background:var(--soft);color:var(--accent);display:flex;align-items:center;justify-content:center}
#pa-pdp .pa-gift-ic svg{width:16px;height:16px}
#pa-pdp .pa-gift-t{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;line-height:1.25}
#pa-pdp .pa-gift-t b{font-size:13.5px;font-family:var(--hdr)}
#pa-pdp .pa-gift-t small{font-size:12px;color:var(--muted)}
#pa-pdp .pa-gift-v{flex:0 0 auto;text-align:right;font-family:var(--hdr);font-weight:800;font-size:12.5px;color:var(--accent)}
#pa-pdp .pa-gift-v s{display:block;font-family:var(--body);font-weight:400;color:var(--muted);font-size:11.5px}
#pa-pdp .pa-ship-note{font-size:13px;color:var(--muted);margin:10px 0 0}
#pa-pdp .pa-ship-note b{color:var(--ink)}
@media(max-width:380px){#pa-pdp .pa-tier{padding:12px 11px}#pa-pdp .pa-tier-name{font-size:14.5px}#pa-pdp .pa-tier-now{font-size:17.5px}}

/* buttons + trust */
#pa-pdp .atc{display:block;width:100%;background:var(--accent);color:#fff;border:0;border-radius:12px;font-family:var(--hdr);font-weight:800;font-size:17px;padding:19px;cursor:pointer;margin-top:18px;text-align:center;text-decoration:none}
#pa-pdp .atc:hover{filter:brightness(1.07)}
#pa-pdp .atc[disabled]{background:var(--muted);cursor:not-allowed}
#pa-pdp .pa-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0}
#pa-pdp .pa-trust-i{display:flex;align-items:center;gap:8px;font-size:12.5px;line-height:1.25;color:var(--muted)}
#pa-pdp .pa-trust-i b{color:var(--ink);font-weight:600}
#pa-pdp .pa-trust-ic{flex:0 0 auto;width:30px;height:30px;border-radius:50%;background:var(--soft);color:var(--accent);display:flex;align-items:center;justify-content:center}
#pa-pdp .pa-trust-ic svg{width:17px;height:17px}

/* cards, grids */
#pa-pdp .three{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}
#pa-pdp .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px}
#pa-pdp .card h3{margin-bottom:.35em}
#pa-pdp .card p{margin:0;font-size:15.5px;color:var(--muted)}
#pa-pdp .card img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;margin:0 0 14px;display:block}
#pa-pdp .band .card{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14)}
#pa-pdp .band .card p{color:rgba(255,255,255,.8)}
#pa-pdp .pa-num{font-family:var(--pix);font-size:18px;color:var(--accent);display:block;margin-bottom:12px}
#pa-pdp .attrs{border-top:1px solid var(--line);margin:0}
#pa-pdp .attr{display:grid;grid-template-columns:190px 1fr;gap:24px;padding:16px 0;border-bottom:1px solid var(--line)}
#pa-pdp .attr dt{font-family:var(--hdr);font-size:12px;letter-spacing:.11em;text-transform:uppercase;color:var(--accent);font-weight:700}
#pa-pdp .attr dd{margin:0;font-size:16px}
#pa-pdp .pa-box{list-style:none;padding:0;margin:20px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
#pa-pdp .pa-box li{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:15px}
#pa-pdp .pa-box li b{font-family:var(--hdr)}
#pa-pdp .alt{display:grid;grid-template-columns:220px 1fr;gap:24px;padding:20px 0;border-bottom:1px solid rgba(255,255,255,.18)}
#pa-pdp .alt b{font-family:var(--hdr)}
#pa-pdp .alt p{margin:0;opacity:.88}
#pa-pdp .alt.win b{color:#FF8C82}
#pa-pdp .stack{background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px 24px}
#pa-pdp .srow{display:flex;justify-content:space-between;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);font-size:16px}
#pa-pdp .srow:last-child{border-bottom:0}
#pa-pdp .srow b{font-family:var(--hdr)}
#pa-pdp .srow .val{color:var(--accent);font-family:var(--hdr);font-weight:700;white-space:nowrap}

/* faq */
#pa-pdp details{border-bottom:1px solid var(--line)}
#pa-pdp summary{cursor:pointer;list-style:none;padding:20px 0;font-family:var(--hdr);font-weight:700;font-size:17px;display:flex;justify-content:space-between;gap:16px}
#pa-pdp summary::-webkit-details-marker{display:none}
#pa-pdp summary::after{content:'+';color:var(--accent);font-size:22px;line-height:1}
#pa-pdp details[open] summary::after{content:'\2013'}
#pa-pdp details .fa{padding:0 0 20px;font-size:16px;color:var(--muted);max-width:66ch}

/* reviews */
#pa-pdp .rsum{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:26px}
#pa-pdp .rnum{font-family:var(--hdr);font-size:52px;font-weight:800;line-height:1}
#pa-pdp .pa-stars{position:relative;display:inline-block;font-size:17px;line-height:1;letter-spacing:2px;color:#ddd5c9}
#pa-pdp .pa-stars:before{content:"\2605\2605\2605\2605\2605"}
#pa-pdp .pa-stars i{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F2A100;font-style:normal}
#pa-pdp .pa-stars i:before{content:"\2605\2605\2605\2605\2605"}
#pa-pdp .pa-rating{display:inline-flex;align-items:center;gap:8px;font-size:14px;color:var(--muted);text-decoration:none;margin:-4px 0 12px}
#pa-pdp .pa-rating b{color:var(--ink);font-weight:600}
#pa-pdp .rsum .pa-stars{font-size:22px}

/* sticky */
#pa-pdp .sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#fff;border-top:1px solid var(--line);padding:10px 12px calc(10px + env(safe-area-inset-bottom));display:none;box-shadow:0 -8px 24px rgba(0,0,0,.08);transform:translateY(110%);transition:transform .25s ease}
#pa-pdp .sticky.show{transform:none}
#pa-pdp .sticky .in{display:flex;align-items:center;gap:10px;max-width:1180px;margin:0 auto}
#pa-pdp .st-img{flex:0 0 auto;width:48px;height:48px;border-radius:8px;border:1px solid var(--line);object-fit:cover;background:#fff}
#pa-pdp .st-info{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:1px}
#pa-pdp .st-t{font-family:var(--hdr);font-weight:700;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#pa-pdp .st-v{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#pa-pdp .sticky .sp{font-family:var(--hdr);font-weight:700;font-size:14px;white-space:nowrap}
#pa-pdp .sticky .sp s{color:var(--muted);font-weight:400;font-size:12px;margin-right:5px}
#pa-pdp .sticky form{flex:0 0 auto;margin:0}
#pa-pdp .sticky .atc{margin:0;width:auto;padding:13px 18px;font-size:14.5px;border-radius:10px;white-space:nowrap}

/* cart drawer */
#pa-pdp .pa-cd-ov{position:fixed;inset:0;background:rgba(23,23,31,.45);z-index:2147483000}
#pa-pdp .pa-cd{position:fixed;top:0;right:0;height:100%;width:420px;max-width:100%;background:var(--bg);z-index:2147483001;display:flex;flex-direction:column;transform:translateX(100%);visibility:hidden;transition:transform .28s ease,visibility 0s linear .28s;box-shadow:-8px 0 30px rgba(0,0,0,.12)}
#pa-pdp .pa-cd.open{transform:none;visibility:visible;transition:transform .28s ease}
#pa-pdp .pa-cd-h{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:1px solid var(--line)}
#pa-pdp .pa-cd-title{font-family:var(--hdr);font-weight:800;font-size:18px}
#pa-pdp .pa-cd-x{background:none;border:0;font-size:30px;line-height:1;cursor:pointer;color:var(--ink);padding:0 4px}
#pa-pdp .pa-cd-ship{padding:12px 20px;border-bottom:1px solid var(--line);font-size:13.5px}
#pa-pdp .pa-cd-bar{height:8px;border-radius:4px;background:var(--line);margin-top:8px;overflow:hidden}
#pa-pdp .pa-cd-bar i{display:block;height:100%;width:0;background:var(--green);transition:width .3s}
#pa-pdp .pa-cd-msg{margin:12px 20px 0;padding:10px 12px;background:var(--soft);border-radius:8px;font-size:14px}
#pa-pdp .pa-cd-lines{flex:1 1 auto;overflow-y:auto;padding:6px 20px}
#pa-pdp .pa-cd-line{display:grid;grid-template-columns:64px 1fr auto;gap:12px;padding:14px 0;border-bottom:1px solid var(--line);align-items:start}
#pa-pdp .pa-cd-line img{width:64px;height:64px;object-fit:cover;border:1px solid var(--line);border-radius:8px;background:#fff}
#pa-pdp .pa-cd-name{font-family:var(--hdr);font-weight:700;font-size:14.5px;line-height:1.25}
#pa-pdp .pa-cd-var{font-size:13px;color:var(--muted);margin-top:2px}
#pa-pdp .pa-cd-qty{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:8px;margin-top:8px;background:#fff}
#pa-pdp .pa-cd-qty button{background:none;border:0;width:32px;height:32px;font-size:17px;cursor:pointer;color:var(--ink)}
#pa-pdp .pa-cd-qty span{min-width:22px;text-align:center;font-size:14px}
#pa-pdp .pa-cd-price{text-align:right;font-family:var(--hdr);font-weight:700;font-size:15px}
#pa-pdp .pa-cd-price s{display:block;font-family:var(--body);font-weight:400;font-size:12.5px;color:var(--muted)}
#pa-pdp .pa-cd-free{color:var(--green)}
#pa-pdp .pa-cd-rm{background:none;border:0;color:var(--muted);font-size:12.5px;text-decoration:underline;cursor:pointer;margin-top:8px;padding:0}
#pa-pdp .pa-cd-empty{padding:40px 0;text-align:center;color:var(--muted)}
#pa-pdp .pa-up{display:flex;align-items:center;gap:12px;margin:14px 0 6px;padding:12px;border:1.5px dashed var(--accent);border-radius:12px;background:#fff}
#pa-pdp .pa-up img{width:52px;height:52px;object-fit:cover;border-radius:8px;flex:0 0 auto}
#pa-pdp .pa-up-t{flex:1 1 auto;min-width:0;font-size:13px;line-height:1.3;color:var(--muted)}
#pa-pdp .pa-up-t b{display:block;color:var(--ink);font-family:var(--hdr);font-size:14px}
#pa-pdp .pa-up button{flex:0 0 auto;background:var(--accent);color:#fff;border:0;border-radius:8px;padding:10px 14px;font-family:var(--hdr);font-weight:700;font-size:13.5px;cursor:pointer}
#pa-pdp .pa-cd-f{border-top:1px solid var(--line);padding:16px 20px 20px;background:#fff}
#pa-pdp .pa-cd-row{display:flex;justify-content:space-between;font-size:15px;margin-bottom:6px}
#pa-pdp .pa-cd-disc{color:var(--accent)}
#pa-pdp .pa-cd-tot{font-family:var(--hdr);font-weight:800;font-size:17px}
#pa-pdp .pa-cd-note{font-size:12.5px;color:var(--muted);margin:4px 0 12px}
#pa-pdp .pa-cd-go{margin-top:0}
#pa-pdp .pa-cd-cont{display:block;width:100%;background:none;border:0;margin-top:10px;font-size:14px;color:var(--muted);text-decoration:underline;cursor:pointer}
#pa-pdp .pa-busy{opacity:.6;pointer-events:none}

@media(max-width:880px){
  #pa-pdp .hero{grid-template-columns:1fr;gap:24px;padding-top:20px}
  #pa-pdp .three{grid-template-columns:1fr}
  #pa-pdp .attr,#pa-pdp .alt{grid-template-columns:1fr;gap:6px}
  #pa-pdp .sec{padding:48px 0}
  #pa-pdp .band{padding:52px 0}
  #pa-pdp .sticky{display:block}
  #pa-pdp .gal-thumbs{display:none}
}
@media(max-width:520px){#pa-pdp .pa-box{grid-template-columns:1fr}}
</style>

{%- capture pa_gift_svg -%}<svg viewBox="0 0 24 24"><path d="M4 11h16v9H4zM3 7h18v4H3zM12 7v13M12 7c-1.5-3-5-3-5-.5S10 7 12 7zm0 0c1.5-3 5-3 5-.5S14 7 12 7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture pa_truck_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4l3 3v4h-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="6" cy="17.5" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.6"/><circle cx="16.5" cy="17.5" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.6"/></svg>{%- endcapture -%}
{%- capture pa_return_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture pa_play_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="8" y="5.5" width="8" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 15.5h3M10.5 14v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="15.5" cy="16.5" r="1.1" fill="currentColor"/></svg>{%- endcapture -%}

<div class="pa-top">
  <button type="button" class="pa-cart-btn pa-cart-{{ section.settings.cart_icon_side }}" id="pa-cart-btn" aria-label="Open cart">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"/><circle cx="17" cy="19.5" r="1.4" fill="currentColor"/></svg>
    <span class="pa-cart-n" id="pa-cart-n"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
  </button>
  <span class="pa-wordmark">POCKET<b>ARCADE</b></span>
</div>
{%- if section.settings.sale_on -%}
<div class="announce pa-sale" id="pa-sale" data-end="{{ section.settings.sale_end }}">
  <span class="pa-sale-tag">{{ section.settings.sale_label }}</span>
  <span>{{ section.settings.sale_text }}</span>
  <span class="pa-sale-clock" id="pa-sale-clock" aria-live="off">--:--:--</span>
</div>
{%- else -%}
<div class="announce"><span>{{ section.settings.announce_1 }}</span><span>·</span><span>{{ section.settings.announce_2 }}</span></div>
{%- endif -%}

<!-- ================= HERO ================= -->
<div class="wrap">
  <div class="hero">
    <div>
      {%- if product.images.size > 0 -%}
        <div class="pa-car">
          <div class="pa-car-track" id="pa-car" tabindex="0" aria-label="Product images">
            {%- for img in product.images -%}
              <div class="pa-car-slide"><img src="{{ img | image_url: width: 1100 }}" alt="{{ img.alt | default: product.title | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %} width="1100" height="1100"></div>
            {%- endfor -%}
          </div>
          {%- if product.images.size > 1 -%}
            <button type="button" class="pa-car-btn prev" aria-label="Previous image">&#8249;</button>
            <button type="button" class="pa-car-btn next" aria-label="Next image">&#8250;</button>
            <div class="pa-car-dots">{%- for img in product.images -%}<span class="{% if forloop.first %}on{% endif %}"></span>{%- endfor -%}</div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gal-thumbs">
            {%- for img in product.images -%}<img src="{{ img | image_url: width: 180 }}" alt="" data-i="{{ forloop.index0 }}" class="pa-thumb{% if forloop.first %} on{% endif %}">{%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div>
      <h1>{{ product.title }}</h1>
      {%- if section.settings.show_reviews -%}
        {%- assign pa_pct = section.settings.rev_score | times: 20 -%}
        <a class="pa-rating" href="#pa-reviews"><span class="pa-stars" aria-label="{{ section.settings.rev_score }} out of 5 stars"><i style="width:{{ pa_pct }}%"></i></span><span><b>{{ section.settings.rev_score }}</b> · {{ section.settings.rev_count }}</span></a>
      {%- endif -%}
      <p class="sub">{{ section.settings.hero_sub }}</p>
      <ul class="pa-bul">
        {%- if section.settings.hero_b1 != blank -%}<li>{{ section.settings.hero_b1 }}</li>{%- endif -%}
        {%- if section.settings.hero_b2 != blank -%}<li>{{ section.settings.hero_b2 }}</li>{%- endif -%}
        {%- if section.settings.hero_b3 != blank -%}<li>{{ section.settings.hero_b3 }}</li>{%- endif -%}
      </ul>

      {%- if section.settings.show_arrive -%}
      <div class="pa-arrive" id="pa-arrive" data-min="{{ section.settings.ship_min_days }}" data-max="{{ section.settings.ship_max_days }}" data-xmas="{{ section.settings.xmas_cutoff }}">
        {{ pa_truck_svg }}<span id="pa-arrive-t">Order today and it arrives in {{ section.settings.ship_min_days }}–{{ section.settings.ship_max_days }} days.</span>
      </div>
      {%- endif -%}

      {%- capture pa_opts -%}{%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} (sold out){% endunless %}</option>{%- endfor -%}{%- endcapture -%}
      {%- assign pa_has_opts = true -%}
      {%- if product.has_only_default_variant -%}{%- assign pa_has_opts = false -%}{%- endif -%}

      <div class="pa-bundle" id="pa-tiers" role="radiogroup" aria-label="How many">
        {%- for q in (1..3) -%}
          {%- if q == 1 -%}
            {%- assign t_name = section.settings.t1_label -%}{%- assign t_sub = section.settings.t1_sub -%}{%- assign t_badge = '' -%}
            {%- assign t_price = p1 -%}{%- assign t_cmp = p1_cmp -%}{%- assign t_cta = section.settings.cta_1 -%}
          {%- elsif q == 2 -%}
            {%- assign t_name = section.settings.t2_label -%}{%- assign t_sub = section.settings.t2_sub -%}{%- assign t_badge = section.settings.t2_badge -%}
            {%- assign t_price = p2 -%}{%- assign t_cmp = p2_cmp -%}{%- assign t_cta = section.settings.cta_2 -%}
          {%- else -%}
            {%- assign t_name = section.settings.t3_label -%}{%- assign t_sub = section.settings.t3_sub -%}{%- assign t_badge = section.settings.t3_badge -%}
            {%- assign t_price = p3 -%}{%- assign t_cmp = p3_cmp -%}{%- assign t_cta = section.settings.cta_3 -%}
          {%- endif -%}
          {%- assign t_on = false -%}{%- if q == section.settings.default_tier -%}{%- assign t_on = true -%}{%- endif -%}
          <div class="pa-tier{% if t_on %} on{% endif %}" tabindex="0" data-qty="{{ q }}"
            data-price="{{ t_price }}" data-compare="{{ t_cmp }}" data-cta="{{ t_cta | escape }}"
            role="radio" aria-checked="{% if t_on %}true{% else %}false{% endif %}">
            {%- if t_badge != blank -%}<span class="pa-tier-badge{% if q == 3 %} alt{% endif %}">{{ t_badge }}</span>{%- endif -%}
            <div class="pa-tier-main">
              <span class="pa-tier-radio" aria-hidden="true"></span>
              <span class="pa-tier-body">
                <span class="pa-tier-name">{{ t_name }}</span>
                <span class="pa-tier-sub">{{ t_sub }}</span>
              </span>
              <span class="pa-tier-prices">
                <span class="pa-tier-now">{{ t_price | money }}</span>
                {%- if t_cmp > t_price -%}<span class="pa-tier-was">{{ t_cmp | money }}</span>{%- endif -%}
                {%- if q == 2 -%}<span class="pa-tier-each">{{ p2_each | money }} each</span>{%- elsif q == 3 -%}<span class="pa-tier-each">{{ p3_each | money }} each</span>{%- endif -%}
              </span>
            </div>
            {%- if pa_has_opts -%}
            <div class="pa-tier-picks">
              {%- for n in (1..q) -%}
                <label><span class="pa-pick-l">{% if q == 1 %}{{ section.settings.pick_label }}{% else %}{{ section.settings.pick_label_n }} {{ n }}{% endif %}</span><span class="pa-pick-wrap"><select class="pa-pick pa-v" aria-label="{{ section.settings.pick_label }} {{ n }}">{{ pa_opts }}</select></span></label>
              {%- endfor -%}
            </div>
            {%- endif -%}
            {%- if q > 1 and section.settings.show_gifts -%}
            <div class="pa-gifts">
              <p class="pa-gifts-h">{{ section.settings.gifts_heading }}</p>
              <ul>
                <li><span class="pa-gift-ic" aria-hidden="true">{{ pa_gift_svg }}</span><span class="pa-gift-t"><b>{{ q }} × {{ section.settings.gift_case_title }}</b><small>{{ section.settings.gift_case_sub }}</small></span><span class="pa-gift-v"><s>{{ section.settings.case_value_cents | times: q | money }}</s>FREE</span></li>
                <li><span class="pa-gift-ic" aria-hidden="true">{{ pa_gift_svg }}</span><span class="pa-gift-t"><b>Free shipping</b><small>{{ section.settings.gift_ship_sub }}</small></span><span class="pa-gift-v"><s>{{ section.settings.ship_cost_cents | money }}</s>FREE</span></li>
              </ul>
            </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <p class="pa-ship-note">{{ section.settings.single_ship_note }}</p>

      {%- form 'product', product, id: 'pa-form-hero', class: 'pa-form' -%}
        <input type="hidden" name="id" class="pa-variant-field" value="{{ v.id }}">
        <input type="hidden" name="quantity" class="pa-qty-field" value="1"><span class="pa-items"></span>
        <button type="submit" class="atc pa-cta"{% unless product.available %} disabled{% endunless %}>{%- if product.available -%}{{ section.settings.cta_1 }}{%- else -%}Sold out{%- endif -%}</button>
      {%- endform -%}

      <div class="pa-trust">
        <div class="pa-trust-i"><span class="pa-trust-ic">{{ pa_truck_svg }}</span><span>{{ section.settings.trust_1 }}</span></div>
        <div class="pa-trust-i"><span class="pa-trust-ic">{{ pa_return_svg }}</span><span>{{ section.settings.trust_2 }}</span></div>
        <div class="pa-trust-i"><span class="pa-trust-ic">{{ pa_play_svg }}</span><span>{{ section.settings.trust_3 }}</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ================= THE GIFT ================= -->
<div class="band"><div class="wrap">
  <div class="narrow">
    <p class="eyebrow">{{ section.settings.why_eyebrow }}</p>
    <h2>{{ section.settings.why_h }}</h2>
    <p>{{ section.settings.why_1 }}</p>
  </div>
  <div class="three">
    {%- for i in (1..3) -%}
      {%- assign kh = 'why_c' | append: i | append: '_h' -%}{%- assign kb = 'why_c' | append: i | append: '_b' -%}
      <div class="card"><span class="pa-num">0{{ i }}</span><h3>{{ section.settings[kh] }}</h3><p>{{ section.settings[kb] }}</p></div>
    {%- endfor -%}
  </div>
</div></div>

<!-- ================= WHO IT'S FOR ================= -->
<div class="sec"><div class="wrap">
  <div class="narrow">
    <p class="eyebrow">Who it's for</p>
    <h2>{{ section.settings.who_h }}</h2>
  </div>
  <div class="three">
    {%- for i in (1..3) -%}
      {%- assign kh = 'who_' | append: i | append: '_h' -%}{%- assign kb = 'who_' | append: i | append: '_b' -%}{%- assign ki = 'who_' | append: i | append: '_img' -%}
      <div class="card">
        {%- if section.settings[ki] != blank -%}<img src="{{ section.settings[ki] | image_url: width: 800 }}" alt="{{ section.settings[kh] | escape }}" loading="lazy">{%- endif -%}
        <h3>{{ section.settings[kh] }}</h3><p>{{ section.settings[kb] }}</p>
      </div>
    {%- endfor -%}
  </div>
</div></div>

<!-- ================= EASY ================= -->
<div class="sec white"><div class="wrap">
  <div class="narrow">
    <p class="eyebrow">You can't get this gift wrong</p>
    <h2>{{ section.settings.easy_h }}</h2>
    <p>{{ section.settings.easy_sub }}</p>
  </div>
  <div class="three">
    {%- for i in (1..3) -%}
      {%- assign kh = 'easy_' | append: i | append: '_h' -%}{%- assign kb = 'easy_' | append: i | append: '_b' -%}
      <div class="card"><span class="pa-num">{{ i }}</span><h3>{{ section.settings[kh] }}</h3><p>{{ section.settings[kb] }}</p></div>
    {%- endfor -%}
  </div>
</div></div>

<!-- ================= SPECS + BOX ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">The specifics</p>
  <h2>What it is</h2>
  <dl class="attrs">
    {%- for i in (1..8) -%}
      {%- assign kl = 'spec_' | append: i | append: '_l' -%}{%- assign kv = 'spec_' | append: i | append: '_v' -%}
      {%- if section.settings[kl] != blank -%}<div class="attr"><dt>{{ section.settings[kl] }}</dt><dd>{{ section.settings[kv] }}</dd></div>{%- endif -%}
    {%- endfor -%}
  </dl>
  <h3 style="margin-top:40px">{{ section.settings.box_h }}</h3>
  <ul class="pa-box">
    {%- for i in (1..4) -%}
      {%- assign kb = 'box_' | append: i -%}
      {%- if section.settings[kb] != blank -%}<li>{{ section.settings[kb] }}</li>{%- endif -%}
    {%- endfor -%}
  </ul>
  <p style="margin-top:16px;font-size:15px;color:var(--muted)">{{ section.settings.box_note }}</p>
</div></div>

<!-- ================= ALTERNATIVES ================= -->
<div class="band"><div class="wrap narrow">
  <p class="eyebrow">Other gift ideas</p>
  <h2>{{ section.settings.alts_h }}</h2>
  {%- for i in (1..3) -%}
    {%- assign kh = 'alt_' | append: i | append: '_h' -%}{%- assign kb = 'alt_' | append: i | append: '_b' -%}
    <div class="alt"><b>{{ section.settings[kh] }}</b><p>{{ section.settings[kb] }}</p></div>
  {%- endfor -%}
  <div class="alt win" style="border-bottom:0"><b>{{ product.title }}</b><p>{{ section.settings.alt_win_b }}</p></div>
</div></div>

<!-- ================= VALUE STACK ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">The best deal</p>
  <h2>{{ section.settings.stack_h }}</h2>
  <div class="stack">
    <div class="srow"><b>2 × {{ product.title }}</b><span class="val">{{ p2_cmp | money }}</span></div>
    <div class="srow"><b>2 × {{ section.settings.gift_case_title }}</b><span class="val">{{ section.settings.case_value_cents | times: 2 | money }} · Free</span></div>
    <div class="srow"><b>Shipping</b><span class="val">{{ section.settings.ship_cost_cents | money }} · Free</span></div>
    <div class="srow"><b>You pay</b><span class="val">{{ p2 | money }}</span></div>
  </div>
  <p style="margin-top:22px"><b>{{ p2_each | money }} each.</b> {{ section.settings.stack_line }}</p>
</div></div>

<!-- ================= REVIEWS ================= -->
{%- if section.settings.show_reviews -%}
{%- assign pa_pct = section.settings.rev_score | times: 20 -%}
<div class="sec white" id="pa-reviews"><div class="wrap narrow">
  <p class="eyebrow">What people say</p>
  <div class="rsum">
    <span class="rnum">{{ section.settings.rev_score }}</span>
    <div><span class="pa-stars" aria-label="{{ section.settings.rev_score }} out of 5 stars"><i style="width:{{ pa_pct }}%"></i></span>
      <div style="font-size:14px;color:var(--muted);margin-top:4px">{{ section.settings.rev_count }}</div></div>
  </div>
  {%- if section.settings.reviews_html != blank -%}<div>{{ section.settings.reviews_html }}</div>{%- endif -%}
</div></div>
{%- endif -%}

<!-- ================= GUARANTEE ================= -->
<div class="sec"><div class="wrap narrow">
  <p class="eyebrow">Gift with no risk</p>
  <h2>{{ section.settings.guar_h }}</h2>
  <p>{{ section.settings.guar_1 }}</p>
  <p>{{ section.settings.guar_2 }}</p>
</div></div>

<!-- ================= FAQ ================= -->
<div class="sec white"><div class="wrap narrow">
  <p class="eyebrow">Questions</p>
  <h2>Before you buy</h2>
  {%- for i in (1..12) -%}
    {%- assign qk = 'faq_q_' | append: i -%}{%- assign ak = 'faq_a_' | append: i -%}
    {%- if section.settings[qk] != blank -%}<details><summary>{{ section.settings[qk] }}</summary><div class="fa">{{ section.settings[ak] }}</div></details>{%- endif -%}
  {%- endfor -%}
</div></div>

<!-- ================= FINAL CTA ================= -->
<div class="sec"><div class="wrap narrow" style="text-align:center">
  <h2>{{ section.settings.final_h }}</h2>
  <p style="margin:0 auto 22px">{{ section.settings.final_sub }}</p>
  {%- form 'product', product, id: 'pa-form-final', class: 'pa-form' -%}
    <input type="hidden" name="id" class="pa-variant-field" value="{{ v.id }}">
    <input type="hidden" name="quantity" class="pa-qty-field" value="1"><span class="pa-items"></span>
    <button type="submit" class="atc pa-cta" style="max-width:420px;margin:0 auto"{% unless product.available %} disabled{% endunless %}>{%- if product.available -%}{{ section.settings.cta_1 }}{%- else -%}Sold out{%- endif -%}</button>
  {%- endform -%}
</div></div>

<!-- ================= STICKY (mobile) ================= -->
<div class="sticky" id="pa-sticky" aria-hidden="true">
  <div class="in">
    {%- if product.featured_image -%}<img class="st-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="">{%- endif -%}
    <div class="st-info">
      <span class="st-t">{{ product.title }}</span>
      <span class="st-v" id="pa-sticky-tier">{{ section.settings.t1_label }}</span>
      <span class="sp" id="pa-sticky-price">{{ p1 | money }}</span>
    </div>
    {%- form 'product', product, id: 'pa-form-sticky', class: 'pa-form' -%}
      <input type="hidden" name="id" class="pa-variant-field" value="{{ v.id }}">
      <input type="hidden" name="quantity" class="pa-qty-field" value="1"><span class="pa-items"></span>
      <button type="submit" class="atc pa-cta"{% unless product.available %} disabled{% endunless %}>{%- if product.available -%}{{ section.settings.cta_1 }}{%- else -%}Sold out{%- endif -%}</button>
    {%- endform -%}
  </div>
</div>

