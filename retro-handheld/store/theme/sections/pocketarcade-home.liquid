{%- comment -%}
  POCKETARCADE HOMEPAGE · 2026-11-02
  Short gift-first landing page. Its only job: send people to the product page.
  Pick the product in the theme editor; every button links to it and prices
  are pulled from it. Self-contained styles, no snippets.
{%- endcomment -%}

{%- assign hp = section.settings.product -%}
{%- if hp != blank -%}{%- assign hp_url = hp.url -%}{%- else -%}{%- assign hp_url = routes.all_products_collection_url -%}{%- endif -%}
{%- assign hero_img = section.settings.hero_image | default: hp.featured_image -%}

{%- if section.settings.load_fonts -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
#pa-home{--bg:#FBF8F3;--ink:#17171F;--accent:#D63A2F;--green:#1F6F5C;--soft:#FCEDEA;--line:#E7E1D8;--muted:#666170;
  --hdr:'Rubik','Helvetica Neue',Arial,sans-serif;--body:'Inter','Helvetica Neue',Arial,sans-serif;
  background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
#pa-home *{box-sizing:border-box}
#pa-home h1,#pa-home h2,#pa-home h3{font-family:var(--hdr);font-weight:800;line-height:1.1;letter-spacing:-.015em;margin:0 0 .5em}
#pa-home h1{font-size:clamp(34px,5.4vw,56px)}
#pa-home h2{font-size:clamp(26px,3.6vw,38px)}
#pa-home h3{font-size:19px;font-weight:700}
#pa-home p{margin:0 0 1em}
#pa-home .wrap{max-width:1140px;margin:0 auto;padding:0 20px}
#pa-home .narrow{max-width:760px}
#pa-home .sec{padding:64px 0}
#pa-home .white{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
#pa-home .eyebrow{font-family:var(--hdr);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700;margin:0 0 12px}
#pa-home .btn{display:inline-block;background:var(--accent);color:#fff;text-decoration:none;font-family:var(--hdr);font-weight:800;font-size:17px;padding:18px 34px;border-radius:12px}
#pa-home .btn:hover{filter:brightness(1.07)}
#pa-home .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center;padding:40px 0 56px}
#pa-home .hero img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:16px;display:block}
#pa-home .sub{font-size:19px;color:var(--muted);max-width:36ch;margin-bottom:24px}
#pa-home .trust{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:18px;font-size:14px;color:var(--muted)}
#pa-home .trust span:before{content:"✓ ";color:var(--green);font-weight:700}
#pa-home .consoles{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
#pa-home .consoles span{background:#fff;border:1.5px solid var(--line);border-radius:999px;padding:7px 14px;font-weight:600;font-size:14px}
#pa-home .three{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}
#pa-home .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px}
#pa-home .card p{margin:0;color:var(--muted);font-size:15.5px}
#pa-home .num{font-family:var(--hdr);font-size:28px;color:var(--accent);font-weight:800;display:block;margin-bottom:6px}
#pa-home .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
#pa-home .tier{background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:20px;text-align:center;position:relative}
#pa-home .tier.pop{border-color:var(--accent);border-width:2px;background:var(--soft)}
#pa-home .tier .badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;font-family:var(--hdr);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:3px 10px;border-radius:999px;white-space:nowrap}
#pa-home .tier b{display:block;font-family:var(--hdr);font-size:17px}
#pa-home .tier .pr{font-family:var(--hdr);font-size:26px;font-weight:800;margin:4px 0}
#pa-home .tier small{color:var(--muted);font-size:13px}
#pa-home details{border-bottom:1px solid var(--line)}
#pa-home summary{cursor:pointer;list-style:none;padding:18px 0;font-family:var(--hdr);font-weight:700;display:flex;justify-content:space-between;gap:16px}
#pa-home summary::-webkit-details-marker{display:none}
#pa-home summary:after{content:'+';color:var(--accent);font-size:22px;line-height:1}
#pa-home details[open] summary:after{content:'\2013'}
#pa-home details p{color:var(--muted);padding-bottom:16px;margin:0}
#pa-home .center{text-align:center}
@media(max-width:820px){
  #pa-home .hero{grid-template-columns:minmax(0,1fr);gap:22px;padding-top:20px}
  #pa-home .three,#pa-home .tiers{grid-template-columns:1fr}
  #pa-home .sec{padding:48px 0}
  #pa-home .btn{display:block;text-align:center}
}
</style>

<section id="pa-home">
  <div class="wrap">
    <div class="hero">
      <div>
        {%- if hero_img -%}<a href="{{ hp_url }}"><img src="{{ hero_img | image_url: width: 1200 }}" alt="{{ section.settings.hero_h | escape }}" width="1200" height="1200"></a>{%- endif -%}
      </div>
      <div>
        <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1>{{ section.settings.hero_h }}</h1>
        <p class="sub">{{ section.settings.hero_sub }}</p>
        <a class="btn" href="{{ hp_url }}">{{ section.settings.cta }}</a>
        <div class="trust"><span>{{ section.settings.trust_1 }}</span><span>{{ section.settings.trust_2 }}</span><span>{{ section.settings.trust_3 }}</span></div>
      </div>
    </div>
  </div>

  <div class="sec white"><div class="wrap narrow center">
    <p class="eyebrow">{{ section.settings.consoles_eyebrow }}</p>
    <h2>{{ section.settings.consoles_h }}</h2>
    <div class="consoles" style="justify-content:center">
      {%- assign cl = section.settings.consoles | split: ',' -%}
      {%- for c in cl -%}<span>{{ c | strip }}</span>{%- endfor -%}
    </div>
    <p style="margin:22px 0 0"><a href="{{ hp_url }}#pa-games" style="color:var(--accent);font-weight:700">{{ section.settings.search_link }}</a></p>
  </div></div>

  <div class="sec"><div class="wrap">
    <div class="narrow"><p class="eyebrow">Why it's the gift</p><h2>{{ section.settings.why_h }}</h2></div>
    <div class="three">
      {%- for i in (1..3) -%}
        {%- assign kh = 'why_' | append: i | append: '_h' -%}{%- assign kb = 'why_' | append: i -%}
        <div class="card"><span class="num">0{{ i }}</span><h3>{{ section.settings[kh] }}</h3><p>{{ section.settings[kb] }}</p></div>
      {%- endfor -%}
    </div>
  </div></div>

  {%- if hp != blank -%}
  {%- assign u = hp.price -%}
  <div class="sec white"><div class="wrap narrow center">
    <p class="eyebrow">{{ section.settings.deal_eyebrow }}</p>
    <h2>{{ section.settings.deal_h }}</h2>
    <div class="tiers">
      <div class="tier"><b>1 PocketArcade</b><div class="pr">{{ u | money }}</div><small>For one lucky person</small></div>
      <div class="tier pop"><span class="badge">Most popular</span><b>2 PocketArcades</b><div class="pr">{{ section.settings.duo_price_cents | money }}</div><small>+ 2 free cases · free shipping</small></div>
      <div class="tier"><b>3 PocketArcades</b><div class="pr">{{ section.settings.trio_price_cents | money }}</div><small>+ 3 free cases · free shipping</small></div>
    </div>
    <a class="btn" href="{{ hp_url }}">{{ section.settings.deal_cta }}</a>
  </div></div>
  {%- endif -%}

  <div class="sec"><div class="wrap narrow">
    <p class="eyebrow">Questions</p>
    <h2>Before you buy</h2>
    {%- for i in (1..5) -%}
      {%- assign qk = 'q' | append: i -%}{%- assign ak = 'a' | append: i -%}
      {%- if section.settings[qk] != blank -%}<details><summary>{{ section.settings[qk] }}</summary><p>{{ section.settings[ak] }}</p></details>{%- endif -%}
    {%- endfor -%}
  </div></div>

  <div class="sec white"><div class="wrap narrow center">
    <h2>{{ section.settings.final_h }}</h2>
    <p style="color:var(--muted);margin-bottom:24px">{{ section.settings.final_sub }}</p>
    <a class="btn" href="{{ hp_url }}">{{ section.settings.cta }}</a>
  </div></div>
</section>

{% schema %}
{
  "name": "PocketArcade home",
  "settings": [
    { "type": "checkbox", "id": "load_fonts", "label": "Load Rubik / Inter", "default": true },
    { "type": "product", "id": "product", "label": "PocketArcade product (all buttons link here)" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (defaults to the product's first image)" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "The gift for anyone who grew up gaming" },
    { "type": "text", "id": "hero_h", "label": "Heading", "default": "Every game they grew up on. In one gift." },
    { "type": "textarea", "id": "hero_sub", "label": "Subline", "default": "Over 10,000 games from 20 classic consoles, already loaded. No Wi-Fi, no downloads, nothing to buy. Unwrap it and play." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Shop PocketArcade" },
    { "type": "text", "id": "trust_1", "label": "Trust 1", "default": "Free shipping over $86" },
    { "type": "text", "id": "trust_2", "label": "Trust 2", "default": "Holiday returns until Jan 31" },
    { "type": "text", "id": "trust_3", "label": "Trust 3", "default": "Ready to play out of the box" },
    { "type": "header", "content": "Consoles" },
    { "type": "text", "id": "consoles_eyebrow", "label": "Eyebrow", "default": "10,000+ games" },
    { "type": "text", "id": "consoles_h", "label": "Heading", "default": "20 classic consoles in your pocket" },
    { "type": "textarea", "id": "consoles", "label": "Consoles (comma separated)", "default": "NES, Super Nintendo, Game Boy Color, Game Boy Advance, Nintendo 64, Nintendo DS, PlayStation 1, PSP, Sega Genesis, Dreamcast, Neo Geo, PC Engine, Arcade" },
    { "type": "text", "id": "search_link", "label": "Search link text", "default": "Search for their favorite game →" },
    { "type": "header", "content": "Why" },
    { "type": "text", "id": "why_h", "label": "Heading", "default": "The gift they won't put down." },
    { "type": "text", "id": "why_1_h", "label": "Card 1 heading", "default": "Instant nostalgia" },
    { "type": "textarea", "id": "why_1", "label": "Card 1 body", "default": "The games from every console they had as a kid, plus the ones they always wanted." },
    { "type": "text", "id": "why_2_h", "label": "Card 2 heading", "default": "Nothing to set up" },
    { "type": "textarea", "id": "why_2", "label": "Card 2 body", "default": "No accounts, no Wi-Fi, no downloads. Charge it, turn it on, pick a game." },
    { "type": "text", "id": "why_3_h", "label": "Card 3 heading", "default": "Nothing to buy inside" },
    { "type": "textarea", "id": "why_3", "label": "Card 3 body", "default": "No ads, no chat, no in-game stores. Safe for kids, fun for grown-ups." },
    { "type": "header", "content": "Deal" },
    { "type": "text", "id": "deal_eyebrow", "label": "Eyebrow", "default": "Early Black Friday" },
    { "type": "text", "id": "deal_h", "label": "Heading", "default": "Get one for everyone on your list" },
    { "type": "number", "id": "duo_price_cents", "label": "Duo price in cents", "default": 13999 },
    { "type": "number", "id": "trio_price_cents", "label": "Trio price in cents", "default": 19999 },
    { "type": "text", "id": "deal_cta", "label": "Button", "default": "Choose your bundle" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "q1", "label": "Q1", "default": "Will it arrive before Christmas?" },
    { "type": "textarea", "id": "a1", "label": "A1", "default": "Order by December 11 and it arrives before Christmas. Every order gets a tracking number." },
    { "type": "text", "id": "q2", "label": "Q2", "default": "Do I need to buy games?" },
    { "type": "textarea", "id": "a2", "label": "A2", "default": "No. Over 10,000 games are already on it." },
    { "type": "text", "id": "q3", "label": "Q3", "default": "Does it need Wi-Fi?" },
    { "type": "textarea", "id": "a3", "label": "A3", "default": "No. It works anywhere: in the car, on a plane or at Grandma's." },
    { "type": "text", "id": "q4", "label": "Q4", "default": "What if they don't love it?" },
    { "type": "textarea", "id": "a4", "label": "A4", "default": "Holiday returns until January 31. If it arrives broken, we replace it free." },
    { "type": "text", "id": "q5", "label": "Q5" },
    { "type": "textarea", "id": "a5", "label": "A5" },
    { "type": "header", "content": "Final" },
    { "type": "text", "id": "final_h", "label": "Heading", "default": "Christmas shopping, sorted." },
    { "type": "text", "id": "final_sub", "label": "Subline", "default": "The gift they'll actually play." }
  ],
  "presets": [ { "name": "PocketArcade home" } ]
}
{% endschema %}
