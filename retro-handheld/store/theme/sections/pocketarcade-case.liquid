{%- comment -%}
  POCKETARCADE CASE PDP · 2026-11-02
  Simple product page for the silicone case. Color dropdown swaps the image.
  Uses a normal Shopify product form (adds to cart, goes to the cart page).
  "Main product" setting links the "free with 2+" note to the PocketArcade page.
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign mp = section.settings.main_product -%}

{%- if section.settings.load_fonts -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
#pa-case{--bg:#FBF8F3;--ink:#17171F;--accent:#D63A2F;--green:#1F6F5C;--soft:#FCEDEA;--line:#E7E1D8;--muted:#666170;
  --hdr:'Rubik','Helvetica Neue',Arial,sans-serif;--body:'Inter','Helvetica Neue',Arial,sans-serif;
  background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
#pa-case *{box-sizing:border-box}
#pa-case .wrap{max-width:1100px;margin:0 auto;padding:36px 20px 64px}
#pa-case .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:start}
#pa-case .main{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px;border:1px solid var(--line);background:#fff;display:block}
#pa-case .thumbs{display:flex;gap:8px;margin-top:8px;overflow-x:auto}
#pa-case .thumbs img{width:68px;height:68px;object-fit:cover;border-radius:8px;border:1px solid var(--line);cursor:pointer;background:#fff;flex:0 0 auto}
#pa-case .thumbs img.on{border:2px solid var(--accent)}
#pa-case h1{font-family:var(--hdr);font-weight:800;font-size:clamp(28px,4vw,40px);line-height:1.1;margin:0 0 8px}
#pa-case .price{font-family:var(--hdr);font-size:28px;font-weight:800;margin:0 0 6px}
#pa-case .price s{font-size:17px;color:var(--muted);font-weight:400;margin-left:8px}
#pa-case .free{background:#EAF4F0;border:1px solid #CFE5DC;border-radius:10px;padding:10px 12px;font-size:14.5px;margin:12px 0 18px}
#pa-case .free b{color:var(--green)}
#pa-case .free a{color:var(--green);font-weight:700}
#pa-case label{display:block;font-family:var(--hdr);font-weight:700;font-size:14px;margin:0 0 6px}
#pa-case select{width:100%;font:inherit;font-size:16px;padding:12px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
#pa-case .atc{display:block;width:100%;margin-top:16px;background:var(--accent);color:#fff;border:0;border-radius:12px;font-family:var(--hdr);font-weight:800;font-size:17px;padding:18px;cursor:pointer}
#pa-case .atc[disabled]{background:var(--muted);cursor:not-allowed}
#pa-case ul{list-style:none;padding:0;margin:22px 0 0}
#pa-case li{padding:8px 0 8px 26px;position:relative;border-bottom:1px solid var(--line);font-size:15.5px}
#pa-case li:before{content:"✓";position:absolute;left:2px;color:var(--green);font-weight:800}
#pa-case .desc{margin-top:22px;color:var(--muted);font-size:15.5px}
@media(max-width:820px){#pa-case .grid{grid-template-columns:minmax(0,1fr);gap:22px}#pa-case .wrap{padding-top:18px}}
</style>

<section id="pa-case">
  <div class="wrap"><div class="grid">
    <div>
      {%- assign fi = v.featured_image | default: product.featured_image -%}
      {%- if fi -%}<img class="main" id="pa-case-img" src="{{ fi | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1100">{%- endif -%}
      {%- if product.images.size > 1 -%}
        <div class="thumbs">{%- for img in product.images -%}<img src="{{ img | image_url: width: 160 }}" data-src="{{ img | image_url: width: 1100 }}" alt="" width="68" height="68" class="pa-ct{% if img.id == fi.id %} on{% endif %}">{%- endfor -%}</div>
      {%- endif -%}
    </div>

    <div>
      <h1>{{ product.title }}</h1>
      <p class="price" id="pa-case-price">{{ v.price | money }}{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}</p>
      <div class="free"><b>Free with every 2+ bundle.</b> {% if mp != blank %}<a href="{{ mp.url }}">Get 2 PocketArcades and both cases are on us →</a>{% else %}Buy 2 or more PocketArcades and the cases are on us.{% endif %}</div>

      {%- form 'product', product, id: 'pa-case-form' -%}
        {%- unless product.has_only_default_variant -%}
          <label for="pa-case-v">{{ product.options.first }}</label>
          <select id="pa-case-v" name="id">
            {%- for cv in product.variants -%}
              <option value="{{ cv.id }}" data-price="{{ cv.price | money | escape }}" data-img="{% if cv.featured_image %}{{ cv.featured_image | image_url: width: 1100 }}{% endif %}"{% if cv.id == v.id %} selected{% endif %}{% unless cv.available %} disabled{% endunless %}>{{ cv.option1 }}{% unless cv.available %} (sold out){% endunless %}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ v.id }}">
        {%- endunless -%}
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="atc"{% unless product.available %} disabled{% endunless %}>{%- if product.available -%}{{ section.settings.cta }}{%- else -%}Sold out{%- endif -%}</button>
      {%- endform -%}

      <ul>
        {%- for i in (1..4) -%}{%- assign k = 'b' | append: i -%}{%- if section.settings[k] != blank -%}<li>{{ section.settings[k] }}</li>{%- endif -%}{%- endfor -%}
      </ul>
      {%- if product.description != blank -%}<div class="desc">{{ product.description }}</div>{%- endif -%}
    </div>
  </div></div>
</section>

<script>
(function(){
  try{
    var sel = document.getElementById('pa-case-v'), img = document.getElementById('pa-case-img'), pr = document.getElementById('pa-case-price');
    if(sel) sel.addEventListener('change', function(){
      var o = sel.options[sel.selectedIndex];
      if(img && o.getAttribute('data-img')) img.src = o.getAttribute('data-img');
      if(pr && o.getAttribute('data-price')) pr.textContent = o.getAttribute('data-price');
    });
    [].slice.call(document.querySelectorAll('#pa-case .pa-ct')).forEach(function(t){
      t.addEventListener('click', function(){
        if(img) img.src = t.getAttribute('data-src');
        [].slice.call(document.querySelectorAll('#pa-case .pa-ct')).forEach(function(x){ x.classList.toggle('on', x === t); });
      });
    });
  }catch(e){}
})();
</script>

{% schema %}
{
  "name": "PocketArcade case",
  "settings": [
    { "type": "checkbox", "id": "load_fonts", "label": "Load Rubik / Inter", "default": true },
    { "type": "product", "id": "main_product", "label": "PocketArcade product (for the free-with-bundle link)" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Add to cart" },
    { "type": "text", "id": "b1", "label": "Bullet 1", "default": "Soft silicone that hugs the whole console" },
    { "type": "text", "id": "b2", "label": "Bullet 2", "default": "Cut-outs for every button, stick and port" },
    { "type": "text", "id": "b3", "label": "Bullet 3", "default": "Wrist lanyard included" },
    { "type": "text", "id": "b4", "label": "Bullet 4", "default": "Keeps it safe in a bag, a car or a stocking" }
  ],
  "presets": [ { "name": "PocketArcade case" } ]
}
{% endschema %}
