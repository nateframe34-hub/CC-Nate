{% comment %}
  ============================================
  BUNDLE SELECTOR - Quantity-Based
  Whipped Tallow & Honey Balm
  ============================================

  HOW IT WORKS:

  This selector changes the QUANTITY in the product form,
  not the variant. You have automatic cart discounts set up:
    - Buy 2 → $10 off
    - Buy 3 → $30 off

  So when a customer clicks "Stock Up (2 Jars)", the hidden
  quantity input becomes 2. Shopify's discount engine applies
  the $10 off at checkout automatically.

  HOW TO USE:

  Option A (Shrine Pro Custom Liquid block):
  1. Go to Online Store → Themes → Customize
  2. Open your product page template
  3. Add a "Custom Liquid" block in the product section
  4. Paste this entire file into the Custom Liquid box
  5. Hide or remove the default quantity selector from
     the theme's product form (it's now redundant)

  Option B (Theme code snippet):
  1. Go to Online Store → Themes → Edit Code
  2. In "Snippets" folder, click "Add a new snippet"
  3. Name it: bundle-selector
  4. Paste this code
  5. In your product template, add: {% render 'bundle-selector' %}

  ============================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .bundle-selector {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    max-width: 520px;
    margin: 24px 0;
  }

  .bundle-selector__label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #2a2a2a;
    margin: 0 0 12px;
  }

  .bundle-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin-bottom: 10px;
    border: 2px solid #e5e0d8;
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .bundle-option:hover {
    border-color: #9bbfb4;
  }

  .bundle-option.is-selected {
    border-color: #4a8a7c;
    background: #f4f9f7;
  }

  .bundle-option__radio {
    width: 20px;
    height: 20px;
    border: 2px solid #ccc;
    border-radius: 50%;
    margin-right: 14px;
    flex-shrink: 0;
    position: relative;
    transition: all 0.2s ease;
  }

  .bundle-option.is-selected .bundle-option__radio {
    border-color: #4a8a7c;
    background: #4a8a7c;
  }

  .bundle-option.is-selected .bundle-option__radio::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    background: #fff;
    border-radius: 50%;
  }

  .bundle-option__info {
    flex-grow: 1;
    text-align: left;
  }

  .bundle-option__title {
    font-weight: 600;
    font-size: 16px;
    color: #1a1a1a;
    margin: 0 0 2px;
  }

  .bundle-option__sub {
    font-size: 13px;
    color: #777;
    margin: 0;
  }

  .bundle-option__price {
    text-align: right;
    margin-left: 14px;
    flex-shrink: 0;
  }

  .bundle-option__price-current {
    font-weight: 700;
    font-size: 18px;
    color: #1a1a1a;
  }

  .bundle-option__price-compare {
    display: block;
    font-size: 13px;
    color: #999;
    text-decoration: line-through;
    margin-top: 2px;
  }

  .bundle-option__badge {
    position: absolute;
    top: -9px;
    right: 14px;
    background: #2d6b5d;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .bundle-option__badge--popular {
    background: #c28844;
  }

  @media (max-width: 480px) {
    .bundle-option {
      padding: 14px 16px;
    }
    .bundle-option__title {
      font-size: 15px;
    }
    .bundle-option__price-current {
      font-size: 16px;
    }
  }
</style>

<div class="bundle-selector" data-product-id="{{ product.id }}">
  <p class="bundle-selector__label">Choose your bundle</p>

  {% comment %} Bundle 1: Try It - 1 Jar {% endcomment %}
  <label class="bundle-option is-selected" data-quantity="1" data-price="4999">
    <span class="bundle-option__badge bundle-option__badge--popular">Most Popular</span>
    <span class="bundle-option__radio"></span>
    <div class="bundle-option__info">
      <p class="bundle-option__title">Try It — 1 Jar</p>
      <p class="bundle-option__sub">Free shipping · 60-day guarantee</p>
    </div>
    <div class="bundle-option__price">
      <span class="bundle-option__price-current">$49.99</span>
    </div>
  </label>

  {% comment %} Bundle 2: Stock Up - 2 Jars {% endcomment %}
  <label class="bundle-option" data-quantity="2" data-price="8998">
    <span class="bundle-option__radio"></span>
    <div class="bundle-option__info">
      <p class="bundle-option__title">Stock Up — 2 Jars</p>
      <p class="bundle-option__sub">Save $10 · Free shipping</p>
    </div>
    <div class="bundle-option__price">
      <span class="bundle-option__price-current">$89.98</span>
      <span class="bundle-option__price-compare">$99.98</span>
    </div>
  </label>

  {% comment %} Bundle 3: Best Value - 3 Jars {% endcomment %}
  <label class="bundle-option" data-quantity="3" data-price="11997">
    <span class="bundle-option__badge">Best Value</span>
    <span class="bundle-option__radio"></span>
    <div class="bundle-option__info">
      <p class="bundle-option__title">Best Value — 3 Jars</p>
      <p class="bundle-option__sub">Save $30 · Free shipping</p>
    </div>
    <div class="bundle-option__price">
      <span class="bundle-option__price-current">$119.97</span>
      <span class="bundle-option__price-compare">$149.97</span>
    </div>
  </label>
</div>

<script>
  (function() {
    const selector = document.querySelector('.bundle-selector[data-product-id="{{ product.id }}"]');
    if (!selector) return;

    const options = selector.querySelectorAll('.bundle-option');

    options.forEach(option => {
      option.addEventListener('click', function(e) {
        e.preventDefault();

        options.forEach(o => o.classList.remove('is-selected'));
        this.classList.add('is-selected');

        const quantity = this.dataset.quantity;

        // Find the product form and update the quantity input
        const productForm = this.closest('form[action*="/cart/add"]');
        if (productForm) {
          let quantityInput = productForm.querySelector('input[name="quantity"]');
          if (!quantityInput) {
            quantityInput = document.createElement('input');
            quantityInput.type = 'hidden';
            quantityInput.name = 'quantity';
            productForm.appendChild(quantityInput);
          }
          quantityInput.value = quantity;

          // Trigger change event for any theme listeners
          quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
          quantityInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        // Custom event other theme elements can hook into
        document.dispatchEvent(new CustomEvent('bundle:changed', {
          detail: { quantity: quantity }
        }));
      });
    });

    // Set initial quantity on page load
    const selectedOption = selector.querySelector('.bundle-option.is-selected');
    if (selectedOption) {
      selectedOption.click();
    }
  })();
</script>
