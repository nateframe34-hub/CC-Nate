  }

  .section-reviews__card-stars {
    color: #c28844;
    font-size: 16px;
    letter-spacing: 1.5px;
    margin: 0 0 8px;
  }

  .section-reviews__card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .section-reviews__card-body {
    font-size: 15px;
    line-height: 1.6;
    color: #444;
    margin: 0 0 12px;
  }

  .section-reviews__card-author {
    font-size: 13px;
    color: #888;
    font-style: italic;
    margin: 0;
  }

  @media (min-width: 768px) {
    .section-reviews__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .section-reviews {
