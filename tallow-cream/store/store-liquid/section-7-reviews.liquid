<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .section-reviews {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    max-width: 720px;
    margin: 48px auto;
    padding: 0 20px;
    color: #2a2a2a;
  }

  .section-reviews__header {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px;
    line-height: 1.2;
    text-align: center;
  }

  .section-reviews__overall {
    text-align: center;
    margin: 0 0 32px;
  }

  .section-reviews__stars {
    color: #c28844;
    font-size: 22px;
    letter-spacing: 3px;
  }

  .section-reviews__rating {
    font-size: 13px;
    color: #777;
    margin: 6px 0 0;
    letter-spacing: 0.5px;
  }

  /* Carousel */
  .section-reviews__carousel-wrap {
    position: relative;
  }

  .section-reviews__carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 16px;
    padding: 4px 0;
  }

  .section-reviews__carousel::-webkit-scrollbar {
    display: none;
  }

  .section-reviews__card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: #f7f3ed;
    padding: 32px 28px;
    border-radius: 14px;
    border-left: 3px solid #2d6b5d;
    box-sizing: border-box;
    min-height: 240px;
    display: flex;
    flex-direction: column;
  }

  .section-reviews__card-stars {
    color: #c28844;
    font-size: 16px;
    letter-spacing: 1.5px;
    margin: 0 0 12px;
  }

  .section-reviews__card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .section-reviews__card-body {
    font-size: 15px;
    line-height: 1.6;
    color: #444;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .section-reviews__card-author {
    font-size: 13px;
    color: #888;
    font-style: italic;
    margin: 0;
  }

  /* Arrow buttons (desktop only) */
  .section-reviews__arrow {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e5e0d8;
    color: #2d6b5d;
    font-size: 20px;
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.2s ease;
    align-items: center;
    justify-content: center;
  }

  .section-reviews__arrow:hover {
    background: #2d6b5d;
    color: #fff;
    border-color: #2d6b5d;
  }

  .section-reviews__arrow--prev {
    left: -22px;
  }

  .section-reviews__arrow--next {
    right: -22px;
  }

  @media (min-width: 768px) {
    .section-reviews__arrow {
      display: flex;
    }
  }

  /* Dots */
  .section-reviews__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .section-reviews__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d6cfc1;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }

  .section-reviews__dot.is-active {
    background: #2d6b5d;
    width: 24px;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .section-reviews {
      margin: 32px auto;
    }
    .section-reviews__header {
      font-size: 26px;
    }
    .section-reviews__card {
      padding: 26px 22px;
      min-height: 260px;
    }
    .section-reviews__card-title {
      font-size: 19px;
    }
    .section-reviews__card-body {
      font-size: 14px;
    }
  }
</style>

