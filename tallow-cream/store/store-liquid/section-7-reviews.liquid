    </div>

    <div class="section-reviews__dots" id="reviewsDots">
      <button class="section-reviews__dot is-active" data-slide="0" aria-label="Review 1"></button>
      <button class="section-reviews__dot" data-slide="1" aria-label="Review 2"></button>
      <button class="section-reviews__dot" data-slide="2" aria-label="Review 3"></button>
      <button class="section-reviews__dot" data-slide="3" aria-label="Review 4"></button>
      <button class="section-reviews__dot" data-slide="4" aria-label="Review 5"></button>
      <button class="section-reviews__dot" data-slide="5" aria-label="Review 6"></button>
      <button class="section-reviews__dot" data-slide="6" aria-label="Review 7"></button>
      <button class="section-reviews__dot" data-slide="7" aria-label="Review 8"></button>
      <button class="section-reviews__dot" data-slide="8" aria-label="Review 9"></button>
      <button class="section-reviews__dot" data-slide="9" aria-label="Review 10"></button>
    </div>

  </div>
</section>

<script>
  (function() {
    const carousel = document.getElementById('reviewsCarousel');
    if (!carousel) return;

    const dots = document.querySelectorAll('#reviewsDots .section-reviews__dot');
    const prevBtn = document.querySelector('.section-reviews__arrow--prev');
    const nextBtn = document.querySelector('.section-reviews__arrow--next');

    function getCardWidth() {
      const card = carousel.querySelector('.section-reviews__card');
      if (!card) return 0;
      const gap = parseInt(getComputedStyle(carousel).gap) || 16;
      return card.offsetWidth + gap;
    }

    function scrollToSlide(index) {
      const cardWidth = getCardWidth();
      carousel.scrollTo({
        left: cardWidth * index,
        behavior: 'smooth'
      });
    }

    function updateActiveDot() {
      const cardWidth = getCardWidth();
      if (cardWidth === 0) return;
      const index = Math.round(carousel.scrollLeft / cardWidth);
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => scrollToSlide(i));
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const cardWidth = getCardWidth();
        const currentIndex = Math.round(carousel.scrollLeft / cardWidth);
        scrollToSlide(Math.max(0, currentIndex - 1));
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const cardWidth = getCardWidth();
        const currentIndex = Math.round(carousel.scrollLeft / cardWidth);
        const maxIndex = carousel.querySelectorAll('.section-reviews__card').length - 1;
        scrollToSlide(Math.min(maxIndex, currentIndex + 1));
      });
    }

    let scrollTimeout;
    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(updateActiveDot, 80);
    });
  })();
</script>
