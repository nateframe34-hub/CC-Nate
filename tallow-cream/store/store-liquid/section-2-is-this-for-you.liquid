{% comment %}
  ============================================
  SECTION 2 — FOR SKIN THAT...
  Whipped Tallow & Honey Balm
  ============================================

  HOW TO USE:
  1. Go to Online Store → Themes → Customize
  2. Add a "Custom Liquid" block on the product page
  3. Paste this entire file into the Custom Liquid box

  BRAND COLORS:
  - Primary teal: #2d6b5d
  - Accent gold: #c28844
  - Cream bg: #f7f3ed
  - Dark text: #1a1a1a

  LAYOUT: 2-column editorial grid on desktop, single col on mobile
  No checkmarks — premium minimal numbered statements
  ============================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .section-for-skin {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    max-width: 780px;
    margin: 48px auto;
    padding: 0 20px;
    color: #2a2a2a;
  }

  .section-for-skin__header {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px;
    line-height: 1.2;
    text-align: center;
  }

  .section-for-skin__sub {
    font-size: 13px;
    color: #888;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 40px;
  }

  .section-for-skin__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .section-for-skin__item {
    display: flex;
    align-items: flex-start;
    padding: 20px 24px;
    background: #fff;
    border: 1px solid #e5e0d8;
    border-radius: 10px;
    transition: border-color 0.2s ease;
  }

  .section-for-skin__item:hover {
    border-color: #2d6b5d;
  }

  .section-for-skin__num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 600;
    color: #2d6b5d;
    margin-right: 16px;
    line-height: 1;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .section-for-skin__text {
    font-size: 16px;
    line-height: 1.5;
    color: #2a2a2a;
    margin: 0;
  }

  .section-for-skin__bottom {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 32px 24px;
    background: #f7f3ed;
    border-radius: 12px;
  }

  .section-for-skin__bottom-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-style: italic;
    color: #1a1a1a;
    line-height: 1.4;
    margin: 0;
  }

  @media (min-width: 768px) {
    .section-for-skin__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .section-for-skin {
      margin: 32px auto;
    }
    .section-for-skin__header {
      font-size: 28px;
    }
    .section-for-skin__sub {
      font-size: 11px;
      margin-bottom: 28px;
    }
    .section-for-skin__item {
      padding: 18px 20px;
    }
    .section-for-skin__num {
      font-size: 24px;
      margin-right: 14px;
    }
    .section-for-skin__text {
      font-size: 15px;
    }
    .section-for-skin__bottom {
      padding: 24px 20px;
    }
    .section-for-skin__bottom-text {
      font-size: 19px;
    }
  }
</style>

<section class="section-for-skin">
  <h2 class="section-for-skin__header">For skin that...</h2>
  <p class="section-for-skin__sub">Made for women whose skin changed</p>

  <div class="section-for-skin__grid">

    <div class="section-for-skin__item">
      <span class="section-for-skin__num">01</span>
      <p class="section-for-skin__text">Used to respond to moisturizer. Now nothing holds.</p>
    </div>

    <div class="section-for-skin__item">
      <span class="section-for-skin__num">02</span>
      <p class="section-for-skin__text">Feels tight by lunch no matter what you put on it.</p>
    </div>

    <div class="section-for-skin__item">
      <span class="section-for-skin__num">03</span>
      <p class="section-for-skin__text">Tried retinol, HA, ceramides. None of them fixed it.</p>
    </div>

    <div class="section-for-skin__item">
      <span class="section-for-skin__num">04</span>
      <p class="section-for-skin__text">Changed somewhere in your 40s and nobody told you why.</p>
    </div>

    <div class="section-for-skin__item">
      <span class="section-for-skin__num">05</span>
      <p class="section-for-skin__text">Reacts to ingredients you can't pronounce.</p>
    </div>

    <div class="section-for-skin__item">
      <span class="section-for-skin__num">06</span>
      <p class="section-for-skin__text">Needs one product that actually absorbs.</p>
    </div>

  </div>

  <div class="section-for-skin__bottom">
    <p class="section-for-skin__bottom-text">
      You're not imagining it. Your skin changed. This was made for that.
    </p>
  </div>
</section>
