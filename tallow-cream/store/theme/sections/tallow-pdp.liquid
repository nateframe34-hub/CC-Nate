{%- comment -%}
  TALLOW PDP · custom Online Store 2.0 product section (Shrine Pro compatible)
  Real Shopify product forms → the Add to Cart buttons actually add to cart.
  All CSS is scoped under #tallow-pdp so it will NOT collide with the theme.
  Dynamic: title, price, compare-at, gallery images, variant id, ATC, availability.
  Marketing copy (diagrams/checks/stats) is editable via section settings in the
  theme customizer where exposed; the rest is inline and editable here in code.

  PRICING NOTE: the displayed price is HARDCODED via section settings
  (price_compare struck through + price_sale), NOT pulled from the variant's
  price/compare-at. This lets the real product price stay $69.99 while an
  automatic discount drops it to $49.99 at checkout, so the discount shows in
  the cart. Keep the Shopify product price at $69.99 (no compare-at needed) and
  create an automatic discount of -$20 (or a 28.57% off) so cart = $49.99.
  The Add to Cart buttons still post the real variant, so the discount applies.

  SPEED: ZERO web fonts (system stack: system sans body, Georgia headings) = no
  font download/render-block. Hero image fetchpriority high + eager; below-fold lazy.
  One section, inline scoped CSS, SVG icon sprite (no emoji, no icon font),
  content-visibility:auto on below-fold sections.
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}

<div id="tallow-pdp">

<style>
  #tallow-pdp{
    --cream:#F6F1E9;--cream-2:#EFE7DA;--ink:#23291F;
    --green:#2E4731;--green-deep:#22351F;--amber:#C98A3C;--amber-soft:#E9C892;
    --line:#D8CDBC;--red:#B14A36;--paper:#FBF8F2;--grey:#6b6552;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    color:var(--ink);background:var(--cream);line-height:1.5;-webkit-font-smoothing:antialiased;
  }
  #tallow-pdp *{box-sizing:border-box;margin:0;padding:0}
  #tallow-pdp h1,#tallow-pdp h2,#tallow-pdp h3,#tallow-pdp .serif{font-family:Georgia,'Times New Roman',serif;font-weight:600;letter-spacing:-.01em;line-height:1.1}
  #tallow-pdp .wrap{width:100%;max-width:1100px;margin:0 auto;padding:0 18px}
  #tallow-pdp .eyebrow{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:var(--amber)}
  #tallow-pdp .icon{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
  #tallow-pdp .btn{display:flex;align-items:center;justify-content:center;gap:9px;background:var(--green);color:#fff;border:none;border-radius:14px;padding:17px 26px;font-family:inherit;font-weight:700;font-size:16px;cursor:pointer;width:100%;-webkit-tap-highlight-color:transparent}
  #tallow-pdp .btn:active{background:var(--green-deep)}
  #tallow-pdp .btn[disabled]{opacity:.5;cursor:not-allowed}
  #tallow-pdp .stars{color:var(--amber);letter-spacing:1px;font-size:14px;line-height:1}
  #tallow-pdp .pf{margin:0}

  #tallow-pdp .anno{background:var(--green-deep);color:#F2EAD9;text-align:center;font-size:12.5px;padding:9px 12px;font-weight:500}
  #tallow-pdp .anno b{color:var(--amber-soft)}

  #tallow-pdp .hero{padding:18px 0 26px}
  #tallow-pdp .gallery .main{background:linear-gradient(150deg,#EFE6D6,#E3D4BC);border-radius:18px;aspect-ratio:1/1;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
  #tallow-pdp .gallery .main img{width:100%;height:100%;object-fit:cover;display:block}
  #tallow-pdp .badge{position:absolute;top:14px;left:14px;background:var(--amber);color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:6px 11px;border-radius:999px;z-index:2}
  #tallow-pdp .thumbs{display:flex;gap:9px;margin-top:10px}
  #tallow-pdp .thumb{flex:1;aspect-ratio:1/1;border-radius:10px;border:1px solid var(--line);overflow:hidden}
  #tallow-pdp .thumb img{width:100%;height:100%;object-fit:cover;display:block}

  #tallow-pdp .buy{padding-top:22px}
  #tallow-pdp .rating-row{display:flex;align-items:center;gap:9px;margin-bottom:10px}
  #tallow-pdp .rating-row a{font-size:13px;color:var(--grey);text-decoration:underline}
  #tallow-pdp .buy h1{font-size:30px;margin-bottom:6px}
  #tallow-pdp .subt{font-size:13px;color:var(--grey);margin-bottom:14px;font-weight:600}
  #tallow-pdp .price{display:flex;align-items:baseline;gap:10px;margin-bottom:5px;flex-wrap:wrap}
  #tallow-pdp .price .now{font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:600}
  #tallow-pdp .price .was{font-size:17px;color:#9a927d;text-decoration:line-through}
  #tallow-pdp .price .save{background:var(--amber-soft);color:#6a481a;font-size:12px;font-weight:700;padding:4px 9px;border-radius:999px}
  #tallow-pdp .ship{font-size:12.5px;color:var(--grey);margin-bottom:16px}
  #tallow-pdp .upsell-note{margin-top:11px;font-size:12.5px;color:#8a8472;text-align:center}
  #tallow-pdp .upsell-note u{color:var(--green);font-weight:600}
  #tallow-pdp .micro{display:flex;gap:7px;flex-wrap:wrap;margin:15px 0 0}
  #tallow-pdp .micro span{display:flex;align-items:center;gap:6px;background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:7px 12px;font-size:12.5px;font-weight:600;color:#46503c}
  #tallow-pdp .micro .icon{width:15px;height:15px;color:var(--green)}
  #tallow-pdp .guar-inline{display:flex;align-items:center;gap:10px;margin-top:16px;font-size:13px;color:#5c5848;border-top:1px solid var(--line);padding-top:16px}
  #tallow-pdp .guar-inline .ic{width:30px;height:30px;border-radius:50%;background:var(--green);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  #tallow-pdp .guar-inline .ic .icon{width:17px;height:17px}
  #tallow-pdp .trust-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:18px;border-top:1px solid var(--line);padding-top:16px}
  #tallow-pdp .trust-strip div{font-size:11px;font-weight:600;color:#5c5848;text-align:center;display:flex;flex-direction:column;align-items:center;gap:5px}
  #tallow-pdp .trust-strip .icon{width:21px;height:21px;color:var(--green)}

  #tallow-pdp section.band{padding:46px 0;content-visibility:auto;contain-intrinsic-size:auto 600px}
  #tallow-pdp .center{text-align:center;max-width:680px;margin:0 auto}
  #tallow-pdp h2.sec{font-size:27px;margin-bottom:8px}
  #tallow-pdp .mt{margin-top:24px}

  #tallow-pdp .checks{display:grid;grid-template-columns:1fr;gap:10px;max-width:840px;margin:0 auto}
  #tallow-pdp .check{display:flex;gap:10px;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 15px;font-size:14px;font-weight:500}
  #tallow-pdp .check .icon{width:19px;height:19px;color:var(--green)}

  #tallow-pdp .diagram-band{background:var(--green-deep);color:#F2EAD9}
  #tallow-pdp .diagram-band .eyebrow{color:var(--amber-soft)}
  #tallow-pdp .diagram-band h2{color:#fff}
  #tallow-pdp .diagram{display:grid;grid-template-columns:1fr;max-width:840px;margin:24px auto 0;background:var(--paper);border-radius:16px;overflow:hidden;color:var(--ink)}
  #tallow-pdp .dcol{padding:22px 20px}
  #tallow-pdp .dcol+.dcol{border-top:2px dashed var(--line)}
  #tallow-pdp .dcol h4{font-family:Georgia,'Times New Roman',serif;font-size:18px;margin-bottom:14px}
  #tallow-pdp .dcol.bad h4{color:var(--red)}#tallow-pdp .dcol.good h4{color:var(--green)}
  #tallow-pdp .surface{height:2px;background:var(--ink);margin:12px 0}
  #tallow-pdp .mol{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:5px}
  #tallow-pdp .mol b{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff}
  #tallow-pdp .bad .mol b{background:var(--red)}#tallow-pdp .good .mol b{background:var(--green)}
  #tallow-pdp .arr{font-size:18px;letter-spacing:5px}#tallow-pdp .arr.up{color:var(--red)}#tallow-pdp .arr.dn{color:var(--green)}
  #tallow-pdp .dnote{font-size:13px;margin-top:9px;font-weight:500;color:#46503c}
  #tallow-pdp .dnote.bad{color:var(--red)}
  #tallow-pdp .dbottom{max-width:840px;margin:16px auto 0;text-align:center;font-family:Georgia,'Times New Roman',serif;font-size:18px;color:#fff}

  #tallow-pdp .math{display:grid;grid-template-columns:1fr;gap:12px;max-width:760px;margin:0 auto;align-items:center}
  #tallow-pdp .math .side{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:22px;text-align:center}
  #tallow-pdp .math .big{font-family:Georgia,'Times New Roman',serif;font-size:52px;font-weight:700;line-height:1}
  #tallow-pdp .math .bad .big{color:var(--red)}#tallow-pdp .math .good .big{color:var(--green)}
  #tallow-pdp .math .lbl{font-size:13px;color:var(--grey);margin-top:6px;font-weight:600}
  #tallow-pdp .math .to{font-size:24px;color:var(--amber);text-align:center}

  #tallow-pdp .labels{display:grid;grid-template-columns:1fr;gap:16px;max-width:860px;margin:0 auto}
  #tallow-pdp .label-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:22px}
  #tallow-pdp .label-card h4{font-family:Georgia,'Times New Roman',serif;font-size:17px;margin-bottom:12px}
  #tallow-pdp .label-card.bad h4{color:var(--red)}#tallow-pdp .label-card.good h4{color:var(--green)}
  #tallow-pdp .ing{font-size:13.5px;padding:6px 0;border-bottom:1px dashed var(--line);color:#5c5848}
  #tallow-pdp .ing.first{font-weight:700;color:var(--red)}
  #tallow-pdp .ing.g{color:var(--green-deep);font-weight:600}
  #tallow-pdp .ing.more{color:#9a927d;font-style:italic;border:none}

  #tallow-pdp .stats{display:grid;grid-template-columns:1fr;gap:14px;max-width:820px;margin:0 auto}
  #tallow-pdp .stat{text-align:center;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px}
  #tallow-pdp .stat .n{font-family:Georgia,'Times New Roman',serif;font-size:44px;font-weight:700;color:var(--green);line-height:1}
  #tallow-pdp .stat .t{font-size:13.5px;color:var(--grey);font-weight:500;margin-top:5px}

  #tallow-pdp .ba{display:grid;grid-template-columns:1fr;gap:18px;max-width:820px;margin:0 auto;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:20px}
  #tallow-pdp .ba .photo{aspect-ratio:16/10;border-radius:12px;background:linear-gradient(150deg,#e7ddc9,#cbb894);overflow:hidden}
  #tallow-pdp .ba .photo img{width:100%;height:100%;object-fit:cover}
  #tallow-pdp .ba blockquote{font-family:Georgia,'Times New Roman',serif;font-size:20px;font-weight:500;line-height:1.3;margin-bottom:12px}
  #tallow-pdp .ba .who{font-size:13px;color:var(--grey);font-weight:600}
  #tallow-pdp .ba .stars{margin-bottom:12px;display:block}

  #tallow-pdp .guar-band{background:var(--amber);color:#3b2a10;text-align:center}
  #tallow-pdp .guar-band h2{color:#3b2a10}
  #tallow-pdp .guar-band p{font-size:15px;max-width:560px;margin:0 auto 20px}
  #tallow-pdp .guar-badge{display:inline-flex;align-items:center;gap:10px;background:#3b2a10;color:var(--amber-soft);padding:14px 24px;border-radius:999px;font-weight:700;font-size:14px}
  #tallow-pdp .guar-badge .icon{width:18px;height:18px}

  #tallow-pdp .attrs{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;max-width:900px;margin:0 auto}
  #tallow-pdp .attr{background:var(--paper);padding:16px}
  #tallow-pdp .attr .k{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);font-weight:700;margin-bottom:5px}
  #tallow-pdp .attr .vv{font-size:13.5px;font-weight:600}

  #tallow-pdp .final{background:var(--green-deep);color:#F2EAD9;text-align:center}
  #tallow-pdp .final h2{color:#fff;font-size:28px;margin-bottom:18px}
  #tallow-pdp .final .pf,#tallow-pdp .final .btn{max-width:340px;margin:0 auto}
  #tallow-pdp .final .trust-strip{border-color:rgba(255,255,255,.16);max-width:520px;margin:22px auto 0}
  #tallow-pdp .final .trust-strip div{color:#cfc6b2}#tallow-pdp .final .trust-strip .icon{color:var(--amber-soft)}

  #tallow-pdp .sticky{position:fixed;left:0;right:0;bottom:0;background:var(--cream);border-top:1px solid var(--line);padding:10px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:50;box-shadow:0 -6px 18px rgba(0,0,0,.07)}
  #tallow-pdp .sticky .p{font-family:Georgia,'Times New Roman',serif;font-weight:600;font-size:17px}
  #tallow-pdp .sticky .pf{flex:0 0 auto}
  #tallow-pdp .sticky .btn{width:auto;padding:13px 26px;font-size:15px}

  @media(min-width:820px){
    #tallow-pdp .wrap{padding:0 28px}
    #tallow-pdp .hero{padding:44px 0 40px}
    #tallow-pdp .hero .wrap{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:start}
    #tallow-pdp .buy{padding-top:0}
    #tallow-pdp .buy h1{font-size:44px}
    #tallow-pdp section.band{padding:72px 0;contain-intrinsic-size:auto 800px}
    #tallow-pdp h2.sec{font-size:33px}
    #tallow-pdp .checks{grid-template-columns:1fr 1fr;gap:14px 28px}
    #tallow-pdp .diagram{grid-template-columns:1fr auto 1fr}
    #tallow-pdp .dcol+.dcol{border-top:none}
    #tallow-pdp .dmid{display:flex;align-items:center;justify-content:center;padding:0 6px;background:var(--cream-2);font-size:24px;color:#8a8472}
    #tallow-pdp .math{grid-template-columns:1fr auto 1fr;gap:18px}
    #tallow-pdp .labels{grid-template-columns:1fr 1fr;gap:24px}
    #tallow-pdp .stats{grid-template-columns:repeat(3,1fr);gap:22px}
    #tallow-pdp .ba{grid-template-columns:260px 1fr;gap:30px;align-items:center}
    #tallow-pdp .ba .photo{aspect-ratio:1/1}
    #tallow-pdp .attrs{grid-template-columns:repeat(3,1fr)}
    #tallow-pdp .sticky{display:none}
    #tallow-pdp .final h2{font-size:36px}
  }
  @media(max-width:819px){ #tallow-pdp .dmid{display:none} body{padding-bottom:70px} }
</style>

<!-- ICON SPRITE (defined once, reused via use) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="tlw-truck" viewBox="0 0 24 24"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></symbol>
  <symbol id="tlw-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></symbol>
  <symbol id="tlw-drop" viewBox="0 0 24 24"><path d="M12 3c3 4 5 6.5 5 9.5A5 5 0 0 1 7 12.5C7 9.5 9 7 12 3z"/></symbol>
  <symbol id="tlw-leaf" viewBox="0 0 24 24"><path d="M5 19C5 10 12 5 20 5c0 9-6 14-13 14"/><path d="M5 19c2-4 5-6 9-7"/></symbol>
  <symbol id="tlw-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></symbol>
  <symbol id="tlw-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4-4"/></symbol>
  <symbol id="tlw-cart" viewBox="0 0 24 24"><path d="M5 6h15l-2 9H7z"/><path d="M5 6L4 3H2"/><circle cx="8" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></symbol>
</svg>

<div class="anno">{{ section.settings.anno_text }}</div>

<!-- HERO -->
<section class="hero"><div class="wrap">
  <div class="gallery">
    <div class="main">
      {%- if section.settings.badge_text != blank -%}<span class="badge">{{ section.settings.badge_text }}</span>{%- endif -%}
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width:820px) 50vw, 100vw', widths: '400,600,800,1000' }}
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
    <div class="thumbs">
      {%- for image in product.images limit: 4 -%}
        <div class="thumb">{{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: image.alt, widths: '120,240' }}</div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <div class="buy">
    <div class="rating-row"><span class="stars">★★★★★</span><a href="#tlw-reviews">{{ section.settings.rating_text }}</a></div>
    <h1>{{ product.title }}</h1>
    <div class="subt">{{ section.settings.subtitle }}</div>
    <div class="price">
      <span class="now">{{ section.settings.price_sale }}</span>
      {%- if section.settings.price_compare != blank -%}<span class="was">{{ section.settings.price_compare }}</span>{%- endif -%}
      {%- if section.settings.price_save != blank -%}<span class="save">{{ section.settings.price_save }}</span>{%- endif -%}
    </div>
    <div class="ship">{{ section.settings.ship_text }}</div>

    {%- comment -%} REAL add-to-cart form #1 (hero) {%- endcomment -%}
    {%- form 'product', product, id: 'tlw-form-hero', class: 'pf' -%}
      <input type="hidden" name="id" value="{{ v.id }}">
      <button type="submit" name="add" class="btn" {% unless v.available %}disabled{% endunless %}>
        <svg class="icon" style="width:19px;height:19px"><use href="#tlw-cart"/></svg>
        {%- if v.available -%}Add to Cart · {{ section.settings.price_sale }}{%- else -%}Sold Out{%- endif -%}
      </button>
    {%- endform -%}

    {%- if section.settings.upsell_note != blank -%}<div class="upsell-note">{{ section.settings.upsell_note }}</div>{%- endif -%}

    <div class="micro">
      <span><svg class="icon"><use href="#tlw-drop"/></svg>Absorbs in 2 min</span>
      <span><svg class="icon"><use href="#tlw-check"/></svg>No shine</span>
      <span><svg class="icon"><use href="#tlw-check"/></svg>No beef smell</span>
    </div>

    <div class="guar-inline"><span class="ic"><svg class="icon"><use href="#tlw-shield"/></svg></span><div><b>60-day money-back guarantee.</b> If your skin doesn't love it, we refund every penny. No sending it back.</div></div>

    <div class="trust-strip">
      <div><svg class="icon"><use href="#tlw-truck"/></svg>Free Shipping</div>
      <div><svg class="icon"><use href="#tlw-shield"/></svg>60-Day Guarantee</div>
      <div><svg class="icon"><use href="#tlw-drop"/></svg>4 Ingredients</div>
      <div><svg class="icon"><use href="#tlw-leaf"/></svg>Grass-Fed</div>
    </div>
  </div>
</div></section>

<section class="band" style="background:var(--cream-2)"><div class="wrap">
  <div class="center"><div class="eyebrow">Sound familiar?</div><h2 class="sec mt">Your skin changed. Nothing kept up.</h2></div>
  <div class="checks mt">
    <div class="check"><svg class="icon"><use href="#tlw-check"/></svg>What used to work stopped working.</div>
    <div class="check"><svg class="icon"><use href="#tlw-check"/></svg>Tight and dry by noon, whatever you use.</div>
    <div class="check"><svg class="icon"><use href="#tlw-check"/></svg>Retinol, HA, ceramides. None of them fixed it.</div>
    <div class="check"><svg class="icon"><use href="#tlw-check"/></svg>Tired of ingredients you can't pronounce.</div>
  </div>
</div></section>

<section class="band diagram-band"><div class="wrap">
  <div class="center"><div class="eyebrow">Why it works when nothing else did</div><h2 class="sec mt">Water sits on top. Skin lets fat in.</h2></div>
  <div class="diagram">
    <div class="dcol bad"><h4>Most creams</h4><div class="mol"><b>H₂O</b><b>H₂O</b><b>H₂O</b><b>H₂O</b></div><div class="arr up">↑ ↑ ↑ ↑</div><div class="surface"></div><div class="dnote bad">Evaporates by noon, sits on top, tight again.</div></div>
    <div class="dmid">→</div>
    <div class="dcol good"><h4>Tallow Balm</h4><div class="surface"></div><div class="arr dn">↓ ↓ ↓ ↓</div><div class="mol"><b>FAT</b><b>FAT</b><b>FAT</b><b>FAT</b></div><div class="dnote">Close to what skin makes, absorbs in, still there at 2pm.</div></div>
  </div>
  <div class="dbottom">Not a better cream. A different category.</div>
</div></section>

<section class="band"><div class="wrap">
  <div class="center"><div class="eyebrow">The counter math</div><h2 class="sec mt">Fourteen products couldn't do what one jar did.</h2></div>
  <div class="math mt">
    <div class="side bad"><div class="big">14</div><div class="lbl">products · $$$ /month · still tight by noon</div></div>
    <div class="to">↓</div>
    <div class="side good"><div class="big">1</div><div class="lbl">jar · 4 ingredients · absorbs in 2 minutes</div></div>
  </div>
</div></section>

<section class="band" style="background:var(--cream-2)"><div class="wrap">
  <div class="center"><div class="eyebrow">Flip the label</div><h2 class="sec mt">4 ingredients. That's the whole list.</h2></div>
  <div class="labels mt">
    <div class="label-card bad"><h4>Most face creams</h4><div class="ing first">1 · Water</div><div class="ing">2 · Glycerin</div><div class="ing">3 · Cetearyl alcohol</div><div class="ing">4 · Phenoxyethanol</div><div class="ing">5 · Dimethicone</div><div class="ing more">…+ 15 more you can't pronounce</div></div>
    <div class="label-card good"><h4>{{ product.title }}</h4><div class="ing g">1 · Grass-fed beef tallow</div><div class="ing g">2 · Manuka honey</div><div class="ing g">3 · Cold-pressed olive oil</div><div class="ing g">4 · Calendula flower</div><div class="ing more">That's it. You can read all of them.</div></div>
  </div>
</div></section>

<section class="band"><div class="wrap">
  <div class="center"><div class="eyebrow">After 2 weeks of daily use</div><h2 class="sec mt">What real skin looks like after switching.</h2></div>
  <div class="stats mt">
    <div class="stat"><div class="n">{{ section.settings.stat1_n }}</div><div class="t">{{ section.settings.stat1_t }}</div></div>
    <div class="stat"><div class="n">{{ section.settings.stat2_n }}</div><div class="t">{{ section.settings.stat2_t }}</div></div>
    <div class="stat"><div class="n">{{ section.settings.stat3_n }}</div><div class="t">{{ section.settings.stat3_t }}</div></div>
  </div>
</div></section>

<section class="band" style="background:var(--cream-2)" id="tlw-reviews"><div class="wrap">
  <div class="ba">
    <div class="photo">{%- if section.settings.review_image -%}{{ section.settings.review_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '260,520' }}{%- endif -%}</div>
    <div><span class="stars">★★★★★</span><blockquote>"{{ section.settings.review_quote }}"</blockquote><div class="who">{{ section.settings.review_author }}</div></div>
  </div>
</div></section>

<section class="band guar-band"><div class="wrap">
  <h2 class="sec">60 days. No drama.</h2>
  <p>Use it for 60 days. If your skin doesn't love it, email us and we'll refund every penny. No hoops, no "send it back first."</p>
  <div class="guar-badge"><svg class="icon"><use href="#tlw-shield"/></svg>60-DAY MONEY-BACK GUARANTEE</div>
</div></section>

<section class="band"><div class="wrap">
  <div class="center"><div class="eyebrow">The whole story</div><h2 class="sec mt">Everything, on the table.</h2></div>
  <div class="attrs mt">
    <div class="attr"><div class="k">What it is</div><div class="vv">Whipped tallow &amp; honey balm</div></div>
    <div class="attr"><div class="k">Ingredients</div><div class="vv">4 total: tallow, honey, olive oil, calendula</div></div>
    <div class="attr"><div class="k">How it absorbs</div><div class="vv">Like skin's own oil. Sinks in, no film</div></div>
    <div class="attr"><div class="k">Who it's for</div><div class="vv">Dry, mature, sensitive skin</div></div>
    <div class="attr"><div class="k">Sourcing</div><div class="vv">Grass-fed tallow · NZ manuka</div></div>
    <div class="attr"><div class="k">Guarantee</div><div class="vv">60-day money-back · free ship</div></div>
  </div>
</div></section>

<section class="band final"><div class="wrap">
  <h2 class="sec">Your skin changed. This was made for that.</h2>
  {%- form 'product', product, id: 'tlw-form-final', class: 'pf' -%}
    <input type="hidden" name="id" value="{{ v.id }}">
    <button type="submit" name="add" class="btn" {% unless v.available %}disabled{% endunless %}>
      <svg class="icon" style="width:19px;height:19px"><use href="#tlw-cart"/></svg>
      {%- if v.available -%}Add to Cart · {{ section.settings.price_sale }}{%- else -%}Sold Out{%- endif -%}
    </button>
  {%- endform -%}
  <div class="trust-strip">
    <div><svg class="icon"><use href="#tlw-truck"/></svg>Free Shipping</div>
    <div><svg class="icon"><use href="#tlw-shield"/></svg>60-Day Guarantee</div>
    <div><svg class="icon"><use href="#tlw-drop"/></svg>4 Ingredients</div>
    <div><svg class="icon"><use href="#tlw-leaf"/></svg>Grass-Fed</div>
  </div>
</div></section>

<!-- STICKY MOBILE ATC (real form) -->
<div class="sticky">
  <div class="p">{{ section.settings.price_sale }}</div>
  {%- form 'product', product, id: 'tlw-form-sticky', class: 'pf' -%}
    <input type="hidden" name="id" value="{{ v.id }}">
    <button type="submit" name="add" class="btn" {% unless v.available %}disabled{% endunless %}>
      {%- if v.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
    </button>
  {%- endform -%}
</div>

</div>{%- comment -%} /#tallow-pdp {%- endcomment -%}

{% schema %}
{
  "name": "Tallow PDP",
  "tag": "section",
  "class": "tallow-pdp-section",
  "settings": [
    { "type": "header", "content": "Price display (hardcoded, not from variant)" },
    { "type": "text", "id": "price_sale", "label": "Sale price (shown)", "default": "$49.99" },
    { "type": "text", "id": "price_compare", "label": "Compare-at price (struck through)", "default": "$69.99" },
    { "type": "text", "id": "price_save", "label": "Savings badge", "default": "Save $20" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "anno_text", "label": "Announcement bar", "default": "Free shipping on every order · 60-day money-back guarantee" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Bestseller" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 · 47 reviews" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Face & Body · 4 Ingredients · 120g" },
    { "type": "text", "id": "ship_text", "label": "Shipping line", "default": "Free shipping · ships in 1-2 days" },
    { "type": "text", "id": "upsell_note", "label": "Upsell note (under ATC)", "default": "Most people reorder. Add a 2nd jar at checkout, save $10." },
    { "type": "header", "content": "Proof stats (after 2 weeks)" },
    { "type": "text", "id": "stat1_n", "label": "Stat 1 number", "default": "94%" },
    { "type": "text", "id": "stat1_t", "label": "Stat 1 text", "default": "said skin felt softer all day" },
    { "type": "text", "id": "stat2_n", "label": "Stat 2 number", "default": "9 in 10" },
    { "type": "text", "id": "stat2_t", "label": "Stat 2 text", "default": "stopped reaching for other products" },
    { "type": "text", "id": "stat3_n", "label": "Stat 3 number", "default": "2 min" },
    { "type": "text", "id": "stat3_t", "label": "Stat 3 text", "default": "to absorb · no greasy residue" },
    { "type": "header", "content": "Featured review" },
    { "type": "image_picker", "id": "review_image", "label": "Review photo (real customer)" },
    { "type": "text", "id": "review_quote", "label": "Review quote", "default": "I threw out eight products and kept this one. My husband noticed before I did." },
    { "type": "text", "id": "review_author", "label": "Review author", "default": "Diana L., verified buyer" }
  ],
  "presets": [{ "name": "Tallow PDP" }]
}
{% endschema %}
