<script>
/* Bundle selector — deliberately standalone.
   It runs AFTER the cart script, in its own IIFE with its own try/catch, and the
   only thing it writes to is the hidden quantity field the forms already carry.
   It never touches the drawer, the submit handler or the gift logic, so a fault
   in here cannot break add-to-cart. That coupling is what broke the last build. */
(function(){
 try{
  var wrap = document.getElementById('tlw-bundle');
  if(!wrap) return;
  var tiers = Array.prototype.slice.call(wrap.querySelectorAll('.tlw-tier'));
  if(!tiers.length) return;

  function select(btn){
    tiers.forEach(function(t){
      var on = (t === btn);
      t.classList.toggle('is-on', on);
      t.setAttribute('aria-checked', on ? 'true' : 'false');
    });
    var qty  = btn.getAttribute('data-qty') || '1';
    var gift = btn.getAttribute('data-gift') === 'true';
    document.querySelectorAll('.tlw-qty-field').forEach(function(f){ f.value = qty; });
    console.log('[tlw-bundle] tier selected, quantity =', qty, '| gift:', btn.getAttribute('data-gift'));
  }

  tiers.forEach(function(btn){
    btn.addEventListener('click', function(e){ e.preventDefault(); select(btn); });
  });

  select(wrap.querySelector('.tlw-tier.is-on') || tiers[0]);
 }catch(err){ console.error('[tlw-bundle] selector failed — cart is unaffected', err); }
})();
</script>
