{%- if section.settings.sale_active -%}
  <div class="anno">{{ section.settings.sale_banner_text | default: '4th of July Sale' }} · <span id="tlw-sale-countdown">calculating...</span></div>
  <script>
    (function(){
      var end = new Date("{{ section.settings.sale_end_iso | default: '2026-07-10T00:00:00-04:00' }}").getTime();
      var el = document.getElementById('tlw-sale-countdown');
      if(!el) return;
      function tick(){
        var now = new Date().getTime();
        var diff = end - now;
        if(diff <= 0){ el.textContent = 'Sale has ended'; clearInterval(timer); return; }
        var d = Math.floor(diff / 86400000);
        var h = Math.floor((diff % 86400000) / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        var parts = [];
        if(d > 0) parts.push(d + 'd');
        parts.push(h + 'h', m + 'm', s + 's');
        el.textContent = parts.join(' ') + ' left';
      }
      tick();
      var timer = setInterval(tick, 1000);
    })();
  </script>
{%- else -%}
  <div class="anno">{{ section.settings.anno_text }}</div>
{%- endif -%}

