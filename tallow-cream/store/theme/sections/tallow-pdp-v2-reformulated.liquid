  #tallow-pdp-v2 .faq summary{cursor:pointer;font-family:Georgia,'Times New Roman',serif;font-weight:600;font-size:17px;padding:16px 0;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}
  #tallow-pdp-v2 .faq summary::-webkit-details-marker{display:none}
  #tallow-pdp-v2 .faq summary::after{content:'+';font-size:22px;line-height:1;opacity:.5;flex:0 0 auto}
  #tallow-pdp-v2 .faq details[open] summary::after{content:'\2212'}
  #tallow-pdp-v2 .faq .fa{padding:0 0 18px;font-size:15px;line-height:1.65;opacity:.85}

  @media(min-width:820px){
