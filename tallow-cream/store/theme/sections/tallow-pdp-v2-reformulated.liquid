<script>
(function(){
 try{
  var root = document.getElementById('tallow-pdp-v2');
  if(!root || root.dataset.cartInit) return; root.dataset.cartInit = '1';
  var overlay = root.querySelector('.tlw-drawer-overlay');
  var drawer  = root.querySelector('.tlw-drawer');
  var itemsEl = root.querySelector('.tlw-d-items');
  var emptyEl = root.querySelector('.tlw-d-empty');
  var savEl   = root.querySelector('.tlw-d-savings');
  var subEl   = root.querySelector('.tlw-d-subval');
  var countEl = root.querySelector('.tlw-d-count');
  var badge   = root.querySelector('.cart-badge');

  function money(c){ return '$' + (c/100).toFixed(2); }
  function img(src){ if(!src) return ''; return src.indexOf('?')>-1 ? src+'&width=160' : src+'?width=160'; }

  function render(cart){
    countEl.textContent = cart.item_count;
    if(badge){ if(cart.item_count>0){ badge.textContent = cart.item_count; badge.removeAttribute('hidden'); } else { badge.setAttribute('hidden',''); } }
    subEl.textContent = money(cart.total_price);
    if(cart.total_discount>0){ savEl.hidden=false; savEl.innerHTML = '<span>Savings</span><span>-'+money(cart.total_discount)+'</span>'; } else { savEl.hidden=true; }
    if(!cart.items || cart.items.length===0){ itemsEl.innerHTML=''; emptyEl.hidden=false; return; }
    emptyEl.hidden=true;

    // The 2-jar price break is an ORDER discount, and Shopify allocates order
    // discounts to no line at all -- the balm line stays at full price and the
    // saving appears only at the subtotal, which reads as "my discount didn't
    // apply". Attribute it to the largest line so it renders 99.98 -> 79.98.
    var cartDisc = 0;
    (cart.cart_level_discount_applications || []).forEach(function(d){
      cartDisc += (d.total_allocated_amount || 0);
    });
    var allocKey = null, allocMax = -1;
    if(cartDisc > 0){
      cart.items.forEach(function(it){
        if(it.final_line_price > allocMax){ allocMax = it.final_line_price; allocKey = it.key; }
      });
      if(allocMax < cartDisc){ cartDisc = 0; } // never render a negative line
    }

    itemsEl.innerHTML = cart.items.map(function(it){
      var alloc  = (cartDisc > 0 && it.key === allocKey) ? cartDisc : 0;
      var shown  = it.final_line_price - alloc;
      var disc   = it.original_line_price > shown;
      var isFree = shown === 0 && it.original_line_price > 0;
      return '<div class="tlw-d-item" data-key="'+it.key+'">'
        + '<div class="tlw-d-img">'+(it.image?'<img src="'+img(it.image)+'" alt="" loading="lazy">':'')+'</div>'
        + '<div class="tlw-d-info"><div class="tlw-d-title">'+it.product_title+(isFree?' <span class="tlw-d-free-tag">FREE GIFT</span>':'')+'</div>'
        + (it.variant_title?'<div class="tlw-d-variant">'+it.variant_title+'</div>':'')
        + '<div class="tlw-d-qty"><button type="button" class="tlw-d-dec" aria-label="Decrease">&minus;</button><span>'+it.quantity+'</span><button type="button" class="tlw-d-inc" aria-label="Increase">+</button></div></div>'
        + '<div class="tlw-d-prices">'
        + (disc?'<span class="tlw-d-was">'+money(it.original_line_price)+'</span>':'')
        + '<span class="tlw-d-now">'+(isFree?'FREE':money(shown))+'</span>'
        + '<button type="button" class="tlw-d-remove" aria-label="Remove"><svg class="icon"><use href="#tlw-trash"/></svg></button>'
        + '</div></div>';
    }).join('');
  }

  function getCart(){ return fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}); }
  function refresh(){ return getCart().then(render); }
  function open(){ drawer.hidden=false; overlay.hidden=false; requestAnimationFrame(function(){ drawer.classList.add('show'); overlay.classList.add('show'); }); document.body.style.overflow='hidden'; }
  function close(){ drawer.classList.remove('show'); overlay.classList.remove('show'); document.body.style.overflow=''; setTimeout(function(){ drawer.hidden=true; overlay.hidden=true; }, 280); }

  // Free gifts: auto-added alongside the main balm only, silently, best-effort.
  // Buy X Get Y discounts don't auto-add the Y item, this is what actually delivers
  // the free lip balm (everyone) and the scarcity gift-card token (first N customers)
  // without requiring a second manual click.
  var MAIN_FORM_IDS = ['tlw-form-hero','tlw-form-final','tlw-form-sticky']; // kept for reference, unreliable, see .tlw-main-flag below
  var GIFT_VARIANT_IDS = [
    {{ section.settings.free_gift_product.selected_or_first_available_variant.id | default: '' | json }},
    {{ section.settings.gift_token_product.selected_or_first_available_variant.id | default: '' | json }}
  ].filter(function(id){ return id !== null && id !== undefined && id !== ''; });

  function addGiftsSilently(){
    if(!GIFT_VARIANT_IDS.length){
      console.warn('[free gift] No product is set in Theme customizer > "Free gift, Overnight Lip Mask" > "Free gift product". Nothing will be auto-added until one is picked.');
      return Promise.resolve();
    }
    // 2-jar tier only. No selector on the page = unchanged original behaviour.
    var t = document.querySelector('#tlw-bundle .tlw-tier.is-on');
    if(t && t.getAttribute('data-gift') !== 'true') return Promise.resolve();
    return getCart().then(function(cart){
      var already = {};
      cart.items.forEach(function(it){ already[String(it.variant_id)] = true; });
      var toAdd = GIFT_VARIANT_IDS.filter(function(id){ return !already[String(id)]; });
      if(!toAdd.length) return;
      return fetch('/cart/add.js',{
        method:'POST',
        headers:{'Accept':'application/json','Content-Type':'application/json'},
        body: JSON.stringify({ items: toAdd.map(function(id){ return { id: id, quantity: 1 }; }) })
      }).then(function(r){
        if(!r.ok){ return r.json().then(function(err){ console.error('[free gift] cart/add.js failed', r.status, err); }); }
      }).catch(function(err){ console.error('[free gift] cart/add.js network error', err); });
    });
  }

  // Add to cart (all product forms) -> AJAX add, open drawer, stay on PDP
  root.querySelectorAll('form.pf').forEach(function(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var isMain = !!form.querySelector('.tlw-main-flag');
      console.log('[tallow-pdp-v2] form submit intercepted', form.id, 'isMain:', isMain, 'gift ids:', GIFT_VARIANT_IDS);
      var btn = form.querySelector('button[name="add"]'); if(btn){ btn.disabled=true; }
      fetch('/cart/add.js',{method:'POST',headers:{'Accept':'application/json'},body:new FormData(form)})
        .then(function(r){return r.json();})
        .then(function(){ return isMain ? addGiftsSilently() : Promise.resolve(); })
        .then(function(){ return refresh(); })
        .then(function(){ open(); })
        .catch(function(){ window.location='/cart'; })
        .finally(function(){ if(btn){ btn.disabled=false; } });
    });
  });

  // Bag icon -> open drawer
  var cartLink = root.querySelector('.cart-link');
  if(cartLink){ cartLink.addEventListener('click', function(e){ e.preventDefault(); refresh().then(open); }); }

  // Close interactions
  overlay.addEventListener('click', close);
  root.querySelector('.tlw-d-close').addEventListener('click', close);
  root.querySelector('.tlw-d-keep').addEventListener('click', close);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !drawer.hidden) close(); });

  // Qty change / remove (event delegation)
  itemsEl.addEventListener('click', function(e){
    var row = e.target.closest('.tlw-d-item'); if(!row) return;
    var key = row.getAttribute('data-key');
    var qty = parseInt(row.querySelector('.tlw-d-qty span').textContent,10);
    if(e.target.closest('.tlw-d-inc')) qty++;
    else if(e.target.closest('.tlw-d-dec')) qty--;
    else if(e.target.closest('.tlw-d-remove')) qty=0;
    else return;
    if(qty<0) qty=0;
    fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:key,quantity:qty})})
      .then(function(r){return r.json();}).then(render);
  });
 }catch(err){ console.error('[tallow-pdp-v2 init error]', err); }
})();

/* Sticky ATC: slide in only after the main buy box scrolls out of view */
(function(){
  var sticky=document.getElementById('tlw-sticky');
  var buyBox=document.getElementById('tlw-form-hero');
  if(!sticky) return;
  if(!buyBox||!('IntersectionObserver' in window)){ sticky.classList.add('on'); return; }
  var io=new IntersectionObserver(function(entries){
    var e=entries[0];
    if(!e.isIntersecting && e.boundingClientRect.top<0){ sticky.classList.add('on'); }
    else { sticky.classList.remove('on'); }
  },{threshold:0});
  io.observe(buyBox);
})();

/* Welcome popup: show 8s after landing (lets already-sold visitors reach checkout first,
   catches the still-deciding ones), once per session, remember dismissal/signup */
(function(){
  var overlay=document.getElementById('tlw-popup-overlay');
  var popup=document.getElementById('tlw-popup');
  if(!overlay||!popup) return;
  var KEY='tlw_popup_dismissed';
  var already=false;
  try{ already = sessionStorage.getItem(KEY) === '1'; }catch(e){}
  var formPosted = !!popup.querySelector('.tlw-popup-ok');
  if(already || formPosted) return;

  function show(){
    overlay.hidden=false; popup.hidden=false;
    requestAnimationFrame(function(){ overlay.classList.add('show'); popup.classList.add('show'); });
  }
  function hide(){
    overlay.classList.remove('show'); popup.classList.remove('show');
    setTimeout(function(){ overlay.hidden=true; popup.hidden=true; }, 250);
    try{ sessionStorage.setItem(KEY,'1'); }catch(e){}
  }
  setTimeout(show, 8000);
  var skipBtn=document.getElementById('tlw-popup-skip');
  if(skipBtn) skipBtn.addEventListener('click', hide);
  overlay.addEventListener('click', hide);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !popup.hidden) hide(); });
})();
</script>

