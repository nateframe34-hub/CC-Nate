    font-family:Georgia,'Times New Roman',serif;
    color:#222;background:#fff;line-height:1.65;-webkit-font-smoothing:antialiased;
  }
  #tallow-advertorial *{box-sizing:border-box}
  #tallow-advertorial .masthead{background:var(--green-deep);color:#F2EAD9;padding:14px 20px;text-align:center}
  #tallow-advertorial .masthead .name{font-size:20px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  #tallow-advertorial .crumb{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:11.5px;color:#8a8472;max-width:680px;margin:14px auto 0;padding:0 20px}
  #tallow-advertorial .wrap{max-width:680px;margin:0 auto;padding:10px 20px 60px}
  #tallow-advertorial h1{font-size:clamp(26px,5.6vw,34px);line-height:1.15;margin:10px 0 8px;color:#111}
  #tallow-advertorial .dek{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.02em;color:#444;margin-bottom:14px}
  #tallow-advertorial .summary{background:#eef7f4;border-left:4px solid var(--green);padding:12px 16px;font-size:15px;margin-bottom:16px}
  #tallow-advertorial .byline{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;color:#777;border-bottom:1px solid #e5e5e5;padding-bottom:12px;margin-bottom:20px}
  #tallow-advertorial .byline b{color:#333}
  #tallow-advertorial p{font-size:17px;margin:0 0 16px}
  #tallow-advertorial .hero-img,#tallow-advertorial .mid-img{margin:18px 0;border-radius:8px;overflow:hidden}
  #tallow-advertorial .hero-img img,#tallow-advertorial .mid-img img{width:100%;height:auto;display:block}
  #tallow-advertorial .caption{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#888;font-style:italic;margin-top:6px}
  #tallow-advertorial h2{font-size:23px;margin:30px 0 10px;color:#111}
  #tallow-advertorial h3{font-size:19px;margin:24px 0 8px;color:#111}
  #tallow-advertorial blockquote{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin:18px 0;font-size:15.5px;font-style:italic;color:#3c3c3c}
  #tallow-advertorial blockquote .who{display:block;font-style:normal;font-weight:700;font-size:13px;margin-top:8px;color:#555}
  #tallow-advertorial .update-box{margin:26px 0;border:1px solid #e7d9a8;border-radius:8px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  #tallow-advertorial .update-box .bar{background:#3f7fbf;color:#fff;font-weight:700;font-size:13px;letter-spacing:.06em;padding:8px 14px;text-transform:uppercase}
  #tallow-advertorial .update-box .body{background:#fdf7e3;padding:12px 14px;font-size:14.5px}
  #tallow-advertorial .cta-btn{display:block;background:#2e8b57;color:#fff;text-decoration:none;text-align:center;border-radius:8px;padding:16px 22px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-weight:700;font-size:17px;margin:20px 0 6px}
  #tallow-advertorial .cta-sub{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;text-align:center;font-size:12.5px;color:#888;margin-bottom:14px}
  #tallow-advertorial .ps{font-size:16px;margin-top:18px}
  #tallow-advertorial .disclosure{background:#5b6f6d;color:#e8e5da;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;text-align:center;padding:22px 18px;line-height:1.6}
  #tallow-advertorial .divider{border:none;border-top:1px solid #e5e5e5;margin:28px 0}
  #tallow-advertorial .callout{background:#fff4e0;border:1px solid #e7d9a8;border-radius:8px;padding:14px 16px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;font-weight:700;color:#5a4a1f;margin-bottom:18px;text-transform:uppercase;letter-spacing:.01em}
</style>

