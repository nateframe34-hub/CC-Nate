<script>
(function(){
  var params = window.location.search;
  var links = document.querySelectorAll('#tallow-advertorial-b30 .cta-btn, #tallow-advertorial-b30 .cta-link');
  links.forEach(function(a, i){
    if (params) {
      try {
        var url = new URL(a.href, window.location.origin);
        var incoming = new URLSearchParams(params);
        incoming.forEach(function(v,k){ url.searchParams.set(k, v); });
        a.href = url.toString();
      } catch(e) {}
    }
    a.addEventListener('click', function(){
      var kind = a.classList.contains('cta-link') ? 'link' : 'button';
      var label = 'advertorial_b30_cta_' + (i + 1) + '_' + kind;
      if (typeof fbq !== 'undefined') { fbq('trackCustom', 'AdvertorialCTAClick', { position: label }); }
      if (typeof gtag !== 'undefined') { gtag('event', 'advertorial_cta_click', { cta_position: label }); }
    });
  });
})();
</script>

