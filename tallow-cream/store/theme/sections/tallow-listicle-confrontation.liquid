{%- comment -%}
  TALLOW LISTICLE · Confrontation angle (B25 Angle 1), B25 destination page, rev 2026-07-07
  Fully personalized (not shared) landing page matched 1:1 to its B25 ad
  angle for maximum ad-to-page congruence, per founder decision 2026-07-07:
  "the purpose is to test angles end to end; congruence raises the odds a
  winning angle actually shows through instead of being suppressed by a
  mismatched page." Do not merge this back into a shared/generic listicle.
  Personalizes the shared listicle skeleton to open on the water/price confrontation from the Confrontation ad angle, so sign 1 restates the ad's exact claim before broadening into the shared mechanism/graveyard/guarantee beats.
  Same UTM passthrough + per-CTA click tracking pattern as
  tallow-advertorial.liquid (fbq/gtag custom events on every CTA).
  Compliance: first-person/editorial voice only, no fabricated stats or
  testimonials, review slot holds only real customer reviews, disclosure
  footer required and must stay.
{%- endcomment -%}

<div id="tlw-list">

<style>
  #tlw-list{
    --cream:#F6F1E9;--ink:#23291F;--green:#2E4731;--green-deep:#22351F;
    --amber:#C98A3C;--amber-soft:#E9C892;--line:#D8CDBC;--paper:#FBF8F2;--grey:#6b6552;
    font-family:Georgia,'Times New Roman',serif;
    color:#222;background:#fff;line-height:1.65;-webkit-font-smoothing:antialiased;
  }
  #tlw-list *{box-sizing:border-box}
  #tlw-list .masthead{background:var(--green-deep);color:#F2EAD9;padding:14px 20px;text-align:center}
  #tlw-list .masthead .name{font-size:20px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  #tlw-list .crumb{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:11.5px;color:#8a8472;max-width:680px;margin:14px auto 0;padding:0 20px}
  #tlw-list .wrap{max-width:680px;margin:0 auto;padding:10px 20px 60px}
  #tlw-list h1{font-size:clamp(26px,5.6vw,34px);line-height:1.15;margin:10px 0 8px;color:#111}
  #tlw-list .dek{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.02em;color:#444;margin-bottom:14px}
  #tlw-list .byline{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;color:#777;border-bottom:1px solid #e5e5e5;padding-bottom:12px;margin-bottom:20px}
  #tlw-list .byline b{color:#333}
  #tlw-list p{font-size:17px;margin:0 0 16px}
  #tlw-list .hero-img{margin:18px 0;border-radius:8px;overflow:hidden}
  #tlw-list .hero-img img{width:100%;height:auto;display:block}
  #tlw-list .caption{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#888;font-style:italic;margin-top:6px}
  #tlw-list .sign{margin:34px 0 18px}
  #tlw-list .sign .num{display:inline-block;background:var(--green);color:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;width:28px;height:28px;border-radius:50%;text-align:center;line-height:28px;margin-right:10px}
  #tlw-list h2{font-size:23px;margin:0 0 10px;color:#111;display:inline}
  #tlw-list blockquote{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin:18px 0;font-size:15.5px;font-style:italic;color:#3c3c3c}
  #tlw-list blockquote .who{display:block;font-style:normal;font-weight:700;font-size:13px;margin-top:8px;color:#555}
  #tlw-list .cta-link{color:#1a5fb4;text-decoration:underline;font-weight:700}
  #tlw-list .cta-btn{display:block;background:#2e8b57;color:#fff;text-decoration:none;text-align:center;border-radius:8px;padding:16px 22px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-weight:700;font-size:17px;margin:20px 0 6px}
  #tlw-list .cta-sub{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;text-align:center;font-size:12.5px;color:#888;margin-bottom:14px}
  #tlw-list .disclosure{background:#5b6f6d;color:#e8e5da;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;text-align:center;padding:22px 18px;line-height:1.6}
  #tlw-list .divider{border:none;border-top:1px solid #e5e5e5;margin:28px 0}
  #tlw-list .sign-img{margin:14px 0 4px;border-radius:10px;overflow:hidden}
  #tlw-list .sign-img img{width:100%;height:auto;display:block}
  #tlw-list .trust-note{display:inline-block;background:var(--amber-soft);color:#6a481a;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;font-weight:700;padding:6px 12px;border-radius:999px;margin-bottom:22px}
</style>


<div class="masthead"><span class="name">{{ section.settings.masthead | default: 'The Everyday Ritual' }}</span></div>
<div class="crumb">Home &rsaquo; Skin &rsaquo; Simple Routines</div>

<div class="wrap">

  <h1>{{ section.settings.headline | default: "5 Signs You're Paying For Water, Not Moisturizer" }}</h1>
  <div class="dek">{{ section.settings.dek | default: "You clicked because your moisturizer feels like it&rsquo;s doing nothing. Here&rsquo;s the ingredient most $80 creams skip, and what actually holds up instead." }}</div>

  <div class="byline">Written by <b>{{ section.settings.byline | default: 'Julie B.' }}</b> &middot; {{ section.settings.byline_date | default: 'July 2026' }}</div>

  {%- if section.settings.hero_image != blank -%}
    <div class="hero-img">{{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: 'One jar on an empty bathroom counter' }}</div>
  {%- endif -%}

  <p><b>Most moisturizers are mostly water.</b> Not a metaphor, an ingredient list fact: flip the bottle over, and for almost every cream on the market, the first and heaviest ingredient is water. Water evaporates. That's not a design flaw, it's just what water does, and it's the reason a $80 jar and a $12 jar can fail the exact same way by noon.</p>
  <p>Here are five signs your moisturizer has that problem, and what a formula without it actually looks like.</p>

  <div class="trust-note">60-day money-back guarantee on the jar we mention below</div>

  <div class="sign"><span class="num">1</span><h2>The ingredient most creams skip, and yours almost certainly has it</h2></div>
  <p>Here's the mechanism nobody puts on the bottle: water evaporates. It's the first, heaviest ingredient in almost every moisturizer, and by definition, water doesn't stay. You put it on at 7am and by noon it's gone, and your skin is tight again, and no amount of reapplying fixes a formula problem.</p>
  <p>Skin makes its own oil. After about forty, it makes a lot less. Fat-based formulas, the kind skin already recognizes, absorb in instead of sitting on top and disappearing. <a class="cta-link" href="{{ section.settings.pdp_url | default: 'https://trybasline.com/products/whipped-tallow-honey-balm' }}">This is the jar that's built that way.</a></p>


  {%- if section.settings.sign1_image != blank -%}
  <div class="sign-img">{{ section.settings.sign1_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>
  {%- endif -%}

  <div class="sign"><span class="num">2</span><h2>The label you can't finish reading</h2></div>
  <p>Flip your moisturizer over. Second ingredient, usually glycerin. Third, something you can't pronounce. If you can't read the whole label out loud without stumbling, that's not a small thing, it's the first sign the formula wasn't built to be trusted, it was built to be sold.</p>
  <p>Four ingredients you already know, tallow, honey, olive oil, calendula, reads differently. Not because shorter is automatically better, but because you can actually evaluate what you're putting on your skin instead of taking a label's word for it.</p>


  {%- if section.settings.sign2_image != blank -%}
  <div class="sign-img">{{ section.settings.sign2_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>
  {%- endif -%}

  <div class="sign"><span class="num">3</span><h2>The price tag has nothing to do with what's actually in the jar</h2></div>
  <p>An $80 cream and a $12 lotion can share the exact same first-ingredient problem from sign 1. Price signals packaging, marketing, and brand, not what's actually going to stay on your skin past lunch. The only way to know is to check the label yourself, not the price sticker.</p>


  {%- if section.settings.sign3_image != blank -%}
  <div class="sign-img">{{ section.settings.sign3_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>
  {%- endif -%}

  <div class="sign"><span class="num">4</span><h2>The drawer of half-used products you can each name the price of</h2></div>
  <p>Ten, twelve, fourteen products. You could probably list what each one cost. That's not indecision, that's a pattern: each one failed for the same reason as sign 1, and each failure got blamed on your skin instead of the formula.</p>


  {%- if section.settings.sign4_image != blank -%}
  <div class="sign-img">{{ section.settings.sign4_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>
  {%- endif -%}

  {%- if section.settings.review_quote != blank -%}
  <blockquote>"{{ section.settings.review_quote }}"<span class="who">{{ section.settings.review_author | default: 'Verified buyer' }}</span></blockquote>
  {%- endif -%}

  <div class="sign"><span class="num">5</span><h2>The math you haven't actually done</h2></div>
  <p>Add up what the failed shelf cost. Most people stop counting on purpose. One jar, four ingredients, replacing all of it, does the math differently: one purchase instead of a dozen guesses.</p>

  {%- if section.settings.sign5_image != blank -%}
  <div class="sign-img">{{ section.settings.sign5_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>
  {%- endif -%}

  <p><a class="cta-link" href="{{ section.settings.pdp_url | default: 'https://trybasline.com/products/whipped-tallow-honey-balm' }}">You can check price and availability here.</a></p>

  <hr class="divider">

  <h2 style="display:block;font-size:23px;margin-bottom:10px;">The part that makes trying it low-risk</h2>
  <p>60-day money-back guarantee. Use the whole jar. If your skin doesn't love it, email them and get every dollar back, nothing to send back. That's the part that gets people over the "beef fat, seriously?" hump.</p>

  <a class="cta-btn" href="{{ section.settings.pdp_url | default: 'https://trybasline.com/products/whipped-tallow-honey-balm' }}">Check Availability &amp; See The Jar &raquo;</a>
  <div class="cta-sub">Free shipping &middot; 60-day money-back guarantee &middot; 4 ingredients</div>

</div>

<div class="disclosure">
  THIS IS AN ADVERTISEMENT AND NOT AN ACTUAL NEWS ARTICLE, BLOG, OR CONSUMER PROTECTION UPDATE.<br>
  This page is a sponsored story presented by the maker of the Whipped Tallow &amp; Honey Balm. The narrative reflects the brand's storytelling; individual results vary. This product is not intended to diagnose, treat, cure, or prevent any disease or skin condition.
</div>
</div>

<script>
(function(){
  var params = window.location.search;
  var links = document.querySelectorAll('#tlw-list .cta-btn, #tlw-list .cta-link');
  links.forEach(function(a, i){
    if (params) {
      try {
        var url = new URL(a.href, window.location.origin);
        var incoming = new URLSearchParams(params);
        incoming.forEach(function(v,k){ url.searchParams.set(k, v); });
        a.href = url.toString();
      } catch(e) {}
    }
    a.addEventListener('click', function(){
      var kind = a.classList.contains('cta-link') ? 'link' : 'button';
      var label = 'listicle_cta_' + (i + 1) + '_' + kind;
      if (typeof fbq !== 'undefined') { fbq('trackCustom', 'ListicleCTAClick', { position: label }); }
      if (typeof gtag !== 'undefined') { gtag('event', 'listicle_cta_click', { cta_position: label }); }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Tallow Listicle (Confrontation angle (B25 Angle 1))",
  "settings": [
    { "type": "text", "id": "masthead", "label": "Masthead name", "default": "The Everyday Ritual" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "5 Signs You're Paying For Water, Not Moisturizer" },
    { "type": "text", "id": "dek", "label": "Dek (subheadline)" },
    { "type": "text", "id": "byline", "label": "Byline name", "default": "Julie B." },
    { "type": "text", "id": "byline_date", "label": "Byline date", "default": "July 2026" },
    { "type": "url", "id": "pdp_url", "label": "PDP link" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (jar + one blurred bottle on counter)" },
    { "type": "text", "id": "review_quote", "label": "REAL customer review quote (never fabricate)", "default": "I threw out eight products and kept this one. My husband noticed before I did." },
    { "type": "text", "id": "review_author", "label": "Review author", "default": "Diana L., verified buyer" },
    { "type": "image_picker", "id": "sign1_image", "label": "Sign 1 image (jar + pump bottle flat lay comparison)" },
    { "type": "image_picker", "id": "sign2_image", "label": "Sign 2 image (SHARED across all 3 pages: dense label + simple kraft card)" },
    { "type": "image_picker", "id": "sign3_image", "label": "Sign 3 image (SHARED across all 3 pages: water droplet vs balm dollop)" },
    { "type": "image_picker", "id": "sign4_image", "label": "Sign 4 image (cluttered drawer, overhead)" },
    { "type": "image_picker", "id": "sign5_image", "label": "Sign 5 image (calm single jar, label not required to be visible)" }
  ],
  "presets": [{ "name": "Tallow Listicle (Confrontation angle (B25 Angle 1))" }]
}
{% endschema %}
