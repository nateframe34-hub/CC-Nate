{%- comment -%}
  Gift card for the PDP bundle selector. Added 2026-08-03.
  Params: name, value, icon ('truck'|'shield'|'gift'|'none'), image (optional).
  If an image is supplied it wins; otherwise the named icon renders.
  Safe to call with a blank name — renders nothing.
{%- endcomment -%}
{%- if name != blank -%}
<span class="tlw-gift">
  <span class="tlw-gift-vis">
    {%- if image != blank -%}
      <img src="{{ image | image_url: width: 120 }}" alt="{{ name | escape }}" loading="lazy" width="60" height="60">
    {%- elsif icon == 'truck' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1z"/><path d="M14 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>
    {%- elsif icon == 'shield' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 3.5v6c0 5-3.4 9.4-8 10.5C7.4 20.9 4 16.5 4 11.5v-6L12 2z"/><path d="M9 12l2 2 4-4"/></svg>
    {%- elsif icon == 'gift' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 21V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
    {%- endif -%}
  </span>
  <span class="tlw-gift-tag">FREE {{ value }}</span>
  <span class="tlw-gift-name">{{ name }}</span>
</span>
{%- endif -%}
