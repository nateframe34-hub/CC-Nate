<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap');

  .bsln{
    --cream:#FBF6EE; --cream2:#F4EADb; --ink:#2E2519; --muted:#5A4E3C;
    --soft:#7A6C56; --honey:#B8772B; --honey-d:#9C6322; --line:#E7D9C3;
    font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    color:var(--ink); background:var(--cream); line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  .bsln *{box-sizing:border-box;}
  .bsln img{max-width:100%;display:block;}
  .bsln h1,.bsln h2,.bsln h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;line-height:1.08;margin:0;}
  .bsln p{margin:0 0 1em;}
  .bsln section{padding:72px 24px;}

  .bsln-h2{font-size:clamp(28px,4vw,44px);margin-bottom:28px;letter-spacing:-.01em;}
  .bsln-eyebrow{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--honey);margin-bottom:18px;}

  /* Buttons */
  .bsln-btn{
    display:inline-block;background:var(--ink);color:var(--cream);text-decoration:none;
    font-weight:700;font-size:16px;letter-spacing:.02em;padding:16px 32px;border-radius:10px;
    transition:background .15s ease;
  }
  .bsln-btn:hover{background:var(--honey);}
  .bsln-btn--ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink);}
  .bsln-btn--ghost:hover{background:var(--ink);color:var(--cream);}
  .bsln-btn--lg{font-size:18px;padding:19px 44px;}

  /* Announce */
  .bsln-announce{background:var(--ink);color:var(--cream);text-align:center;font-size:13px;letter-spacing:.04em;padding:11px 16px;}

  /* Hero */
  .bsln-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:0;padding:0;min-height:560px;}
  .bsln-hero__text{padding:64px 48px;max-width:620px;margin-left:auto;}
  .bsln-hero__title{font-size:clamp(40px,6vw,68px);letter-spacing:-.02em;margin-bottom:22px;}
  .bsln-hero__sub{font-size:18px;color:var(--muted);max-width:460px;margin-bottom:30px;}
  .bsln-hero__note{font-size:13px;color:var(--soft);margin-top:16px;margin-bottom:0;}
  .bsln-hero__img{background-size:cover;background-position:center;min-height:560px;background-color:var(--cream2);}

  /* Trust */
  .bsln-trust{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:14px;background:var(--cream2);padding:18px 24px;font-size:14px;font-weight:600;color:var(--muted);}
  .bsln-trust__item strong{color:var(--honey);letter-spacing:1px;}
  .bsln-trust__sep{color:var(--line);}

  /* Problem */
  .bsln-problem{max-width:760px;margin:0 auto;text-align:center;}
  .bsln-checklist{list-style:none;padding:0;margin:0 0 28px;text-align:left;display:inline-block;}
  .bsln-checklist li{position:relative;padding:10px 0 10px 38px;font-size:18px;border-bottom:1px solid var(--line);}
  .bsln-checklist li:last-child{border-bottom:none;}
  .bsln-checklist li::before{content:"✓";position:absolute;left:0;top:10px;color:var(--honey);font-weight:700;font-size:18px;}
  .bsln-problem__close{font-family:'Cormorant Garamond',serif;font-size:26px;color:var(--ink);max-width:560px;margin:0 auto;}

  /* Mechanism */
  .bsln-mech{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;max-width:1180px;margin:0 auto;background:#fff;border-radius:18px;}
  .bsln-mech__text p{font-size:18px;color:var(--muted);}
  .bsln-mech__punch{font-family:'Cormorant Garamond',serif;font-size:24px !important;color:var(--ink) !important;margin-top:22px;}
  .bsln-mech__img{background-size:cover;background-position:center;border-radius:14px;min-height:440px;background-color:var(--cream2);}

  /* Ingredients */
  .bsln-ingredients{text-align:center;background:var(--cream2);}
