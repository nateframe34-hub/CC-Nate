  .bsln-ing__line{font-size:16px;color:var(--soft);margin-bottom:26px;}

  /* Compare */
  .bsln-compare{text-align:center;max-width:1000px;margin:0 auto;}
  .bsln-compare__grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .bsln-compare__col{border-radius:14px;padding:32px 28px;text-align:left;}
  .bsln-compare__col--them{background:#F0E9DC;}
  .bsln-compare__col--us{background:var(--ink);color:var(--cream);}
  .bsln-compare__label{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px;}
  .bsln-compare__col--them .bsln-compare__label{color:var(--soft);}
  .bsln-compare__col--us .bsln-compare__label{color:var(--honey);}
  .bsln-compare__col ul{list-style:none;padding:0;margin:0;}
  .bsln-compare__col li{padding:9px 0;font-size:16px;border-bottom:1px solid rgba(0,0,0,.08);}
  .bsln-compare__col--us li{border-bottom:1px solid rgba(255,255,255,.12);}
  .bsln-compare__col li:last-child{border-bottom:none;}

  /* How */
  .bsln-how{text-align:center;background:#fff;}
  .bsln-how__steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;max-width:920px;margin:0 auto 24px;}
  .bsln-how__step span{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:var(--cream2);color:var(--honey);font-family:'JetBrains Mono',monospace;font-weight:500;font-size:18px;margin-bottom:14px;}
  .bsln-how__step h3{font-size:24px;margin-bottom:6px;}
  .bsln-how__step p{font-size:15px;color:var(--muted);margin:0;}
  .bsln-how__note{font-size:15px;color:var(--soft);}

  /* Reviews */
  .bsln-reviews{text-align:center;background:var(--cream2);}
  .bsln-reviews__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1080px;margin:0 auto;}
  .bsln-review{background:var(--cream);border:1px solid var(--line);border-radius:14px;padding:28px 24px;text-align:left;}
  .bsln-review__stars{color:var(--honey);letter-spacing:2px;margin-bottom:12px;}
  .bsln-review__quote{font-family:'Cormorant Garamond',serif;font-size:22px;color:var(--ink);margin-bottom:10px;line-height:1.2;}
  .bsln-review__body{font-size:15px;color:var(--muted);margin-bottom:14px;}
  .bsln-review__name{font-size:13px;color:var(--soft);margin:0;font-weight:600;}

  /* Guarantee */
  .bsln-guarantee{text-align:center;max-width:680px;margin:0 auto;}
  .bsln-guarantee p{font-size:18px;color:var(--muted);}
  .bsln-guarantee__small{font-size:15px !important;color:var(--soft) !important;margin-bottom:28px;}

  /* Brand note */
  .bsln-note{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;max-width:1100px;margin:0 auto;background:#fff;border-radius:18px;}
  .bsln-note__img{background-size:cover;background-position:center;border-radius:14px;min-height:380px;background-color:var(--cream2);}
  .bsln-note__text p{font-size:18px;color:var(--muted);}

  /* Final */
  .bsln-final{text-align:center;background:var(--ink);color:var(--cream);}
  .bsln-final__title{font-size:clamp(30px,5vw,52px);max-width:760px;margin:0 auto 30px;letter-spacing:-.01em;}
  .bsln-final .bsln-btn{background:var(--honey);}
  .bsln-final .bsln-btn:hover{background:var(--cream);color:var(--ink);}
  .bsln-final__note{font-size:13px;color:rgba(251,246,238,.65);margin-top:18px;margin-bottom:0;}

  /* Responsive */
  @media (max-width:880px){
    .bsln section{padding:52px 20px;}
    .bsln-hero{grid-template-columns:1fr;min-height:0;}
    .bsln-hero__text{padding:48px 24px;margin:0;max-width:none;text-align:center;}
    .bsln-hero__sub{margin-left:auto;margin-right:auto;}
    .bsln-hero__img{min-height:380px;order:-1;}
    .bsln-mech,.bsln-note{grid-template-columns:1fr;gap:32px;padding:44px 24px;}
    .bsln-mech__img,.bsln-note__img{order:-1;min-height:300px;}
    .bsln-ing-grid{grid-template-columns:1fr 1fr;}
    .bsln-compare__grid{grid-template-columns:1fr;}
    .bsln-how__steps{grid-template-columns:1fr;gap:24px;}
    .bsln-reviews__grid{grid-template-columns:1fr;}
  }
  @media (max-width:460px){
    .bsln-ing-grid{grid-template-columns:1fr;}
    .bsln-btn{display:block;text-align:center;}
  }
</style>
